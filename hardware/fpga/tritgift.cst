// tritgift.cst — Physical Constraints для Tang Nano 9K
// Чип: GW1NR-9C QFN88P (GW1NR-LV9QN88PC6/I5)
//
// Разводка соответствует стандартной плате Tang Nano 9K v1.0:
//   PIN 52  → тактовый генератор 27 МГц (CLK0)
//   PIN 4   → кнопка S1 (активный LOW, внутренний подтяг)
//   PIN 18  → UART RX (через USB-UART CH340)
//   PIN 17  → UART TX (через USB-UART CH340)
//   PIN 10  → встроенный LED0 (активный LOW)

IO_LOC  "clk"      52;
IO_PORT "clk"      PULL_MODE=NONE  IO_TYPE=LVCMOS33;

IO_LOC  "rst_n"    4;
IO_PORT "rst_n"    PULL_MODE=UP    IO_TYPE=LVCMOS33;

IO_LOC  "uart_rx"  18;
IO_PORT "uart_rx"  PULL_MODE=UP    IO_TYPE=LVCMOS33;

IO_LOC  "uart_tx"  17;
IO_PORT "uart_tx"  PULL_MODE=NONE  IO_TYPE=LVCMOS33;

IO_LOC  "led"      10;
IO_PORT "led"      PULL_MODE=NONE  IO_TYPE=LVCMOS33  DRIVE=8;
