{
  "name": "@unidel/gift",
  "version": "0.1.0",
  "description": "Gift Ontology — онтология дара. Не тень, а источник.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "gift": "bin/gift"
  },
  "exports": {
    ".": "./src/index.js",
    "./core": "./src/core/index.js",
    "./persons": "./src/persons/index.js",
    "./memory": "./src/memory/index.js",
    "./theology": "./src/theology/index.js",
    "./oikonomia": "./src/oikonomia/index.js",
    "./lab": "./src/lab/index.js",
    "./types": "./src/types/index.d.ts"
  },
  "scripts": {
    "lab": "node src/lab/index.js all",
    "liturgical": "node src/lab/index.js liturgical",
    "oikos": "node src/lab/index.js oikos",
    "oikonomia": "node src/lab/index.js oikonomia",
    "repl": "node src/lab/index.js repl",
    "sergiy": "node src/lab/sergiy.js",
    "spec:build": "node utils/build-spec-library.mjs",
    "spec:index": "node utils/spec-index.mjs",
    "spec:search": "node utils/spec-search.mjs",
    "pulse": "node utils/ontology-pulse.mjs",
    "pulse:dry": "node utils/ontology-pulse.mjs --dry-run",
    "portal": "node utils/gift-portal-server.mjs",
    "giftos": "node utils/giftos-ws-server.mjs",
    "fpga": "node utils/fpga-gift-bridge.mjs",
    "fpga:ws": "node utils/fpga-gift-bridge.mjs --ws",
    "fpga:chip": "bash utils/fpga-attach.sh run",
    "fpga:flash": "bash utils/fpga-attach.sh flash",
    "fpga:all": "bash utils/fpga-attach.sh all",
    "viz": "node utils/gift-viz.mjs",
    "proposals": "node utils/proposals.mjs",
    "auto-issues": "node utils/auto-issues.mjs",
    "validate": "node utils/gift-validate.mjs specs/ --all",
    "snapshot": "node utils/snapshot-keeper.mjs",
    "snapshot:list": "node utils/snapshot-keeper.mjs list",
    "nous": "node utils/nous-server.mjs",
    "nous:migrate": "node utils/nous-migrate.mjs",
    "nous:status": "node utils/nous-migrate.mjs status",
    "sync": "node utils/anamnesis-sync.mjs",
    "insight": "node utils/claude-insight.mjs",
    "report": "node utils/gift-report.mjs",
    "report:list": "node utils/gift-report.mjs list",
    "report:search": "node utils/gift-report.mjs search",
    "plan": "node utils/gift-plan.mjs",
    "agent": "GITHUB_TOKEN=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 node utils/gift-dev-loop.mjs",
    "agent:once": "GITHUB_TOKEN=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 node utils/gift-dev-loop.mjs --once",
    "matrix": "node utils/matrix-context-hook.mjs | node -e \"process.stdin.setEncoding('utf8');let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>console.log(JSON.parse(d).hookSpecificOutput.additionalContext))\"",
    "postinstall": "node utils/spec-index.mjs 2>/dev/null || true",
    "test": "node --test 'tests/*.test.js'",
    "eval": "node utils/gift-eval.mjs",
    "eval:list": "node utils/gift-eval.mjs --list"
  },
  "keywords": [
    "gift",
    "ontology",
    "kenosis",
    "theosis",
    "palamas",
    "perichoresis"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/unidel2035/gift"
  },
  "dependencies": {
    "@tensorflow/tfjs-node": "^4.22.0",
    "better-sqlite3": "^12.8.0",
    "openai": "^4.0.0",
    "ws": "^8.20.0"
  }
}
