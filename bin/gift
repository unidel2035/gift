#!/usr/bin/env node
/**
 * gift — единый CLI онтологии дара.
 *
 * Это НЕ обёртка вокруг Claude Code. Это точка входа в @unidel/gift:
 *   собор лиц, пустыни, эпиклеза, метанойя, dev-loop.
 *
 * Команды:
 *   gift sobor ask "вопрос"            — собор из 3 живых лиц (ask-sobor.mjs)
 *   gift sobor ask --static "вопрос"   — офлайн-режим (статические голоса)
 *
 *   gift swe --issue N                 — соборный SWE-агент (PLAN → IMPLEMENT → REVIEW)
 *   gift swe --task "…"                — на inline-задачу
 *   gift swe … --dry-run               — без реальных subagents
 *   gift swe … --no-commit             — остановиться перед commit
 *
 *   gift pustynya list                 — реальные пустыни (open gift-ready)
 *   gift pustynya resolve              — перихорезис-разрешение (dry-run)
 *   gift pustynya resolve --close      — закрыть троичные пустыни
 *
 *   gift epiclesis ask "вопрос" [--to Дионисий]  — через HumanOracleInbox
 *   gift epiclesis pending             — неотвеченные вопросы
 *   gift epiclesis answer <id> "…"     — ответить на вопрос (обычно делает бот)
 *
 *   gift matrix                        — снимок W-матрицы (через nous)
 *   gift matrix commune <from> <to>    — история нити
 *
 *   gift benchmark                     — CAT-9 (9/9 операций)
 *
 *   gift status                        — кратко: открытые пустыни, энергия, эпиклезы
 *
 * Философия:
 *   Этот CLI говорит языком онтологии (собор, пустыня, эпиклеза),
 *   а не языком инструмента (run, test, deploy).
 *   Под капотом — node.js + claude subagents. Сверху — церковный словарь.
 */

import { spawn } from 'node:child_process';
import { resolve, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';
import { existsSync, readFileSync } from 'node:fs';

const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '..');

// ── WSL/Windows proxy fix ───────────────────────────────────────────────
// gh и claude CLI в WSL подхватывают Windows system proxy (172.23.x.x:10809),
// которого нет в NAT-режиме. Отключаем прокси-переменные для всех подпроцессов.
function cleanEnv() {
  const e = { ...process.env };
  for (const k of ['HTTP_PROXY', 'HTTPS_PROXY', 'http_proxy', 'https_proxy', 'ALL_PROXY', 'all_proxy']) {
    delete e[k];
  }
  e.NO_PROXY = e.NO_PROXY || 'api.github.com,github.com,localhost,127.0.0.1';
  e.no_proxy = e.no_proxy || e.NO_PROXY;
  return e;
}

// ── Раскраска ───────────────────────────────────────────────────────────
const C = {
  dim: s => `\x1b[2m${s}\x1b[0m`,
  b: s => `\x1b[1m${s}\x1b[0m`,
  gold: s => `\x1b[33m${s}\x1b[0m`,
  cyan: s => `\x1b[36m${s}\x1b[0m`,
  violet: s => `\x1b[35m${s}\x1b[0m`,
};

// ── Подпроцесс ──────────────────────────────────────────────────────────
function run(script, args = []) {
  return new Promise((res, rej) => {
    const child = spawn('node', [resolve(ROOT, script), ...args], {
      cwd: ROOT, stdio: 'inherit',
      env: { ...cleanEnv(), GIFT_CLI: 'gift' },
    });
    child.on('exit', code => code === 0 ? res() : rej(new Error(`exit ${code}`)));
    child.on('error', rej);
  });
}

async function gh(cmd) {
  const { execSync } = await import('node:child_process');
  return execSync(cmd, {
    encoding: 'utf8', cwd: ROOT,
    env: { ...cleanEnv(), GITHUB_TOKEN: '' },
  });
}

// ── Справка ─────────────────────────────────────────────────────────────
function help() {
  console.log(`
${C.b(C.gold('gift'))} — CLI онтологии дара

${C.b('Собор:')}
  gift sobor ask ${C.dim('[--static]')} "вопрос"       — полифония из 3 живых лиц
  gift swe --issue N ${C.dim('[--dry-run] [--no-commit]')}  — соборный SWE-агент

${C.b('Пустыни:')}
  gift pustynya list              — открытые пустыни (#N X→Y)
  gift pustynya resolve ${C.dim('[--close]')}  — перихорезис: закрыть троичные

${C.b('Эпиклеза (призывание):')}
  gift epiclesis ask "вопрос" ${C.dim('[--to Дионисий]')}
  gift epiclesis pending
  gift epiclesis answer <id> "ответ"

${C.b('Матрица:')}
  gift matrix                     — сводка W
  gift matrix commune <from> <to> — история нити

${C.b('Сессии (персистентная память):')}
  gift session list               — прошлые соборы (от новых к старым)
  gift session last               — последний собор целиком
  gift session show <id>          — собор по id

${C.b('Веб-Скиния:')}
  gift web ${C.dim('[--port 3700]')}           — поднять локальный портал (daemon)
  gift web --stop                 — остановить

${C.b('Мыслебродильня:')}
  gift myslo полная "идея"        — Decoupage → Δοκιμασία → Vintage → Score
  gift myslo cut "идея"           — διαίρεσις по 4 sphere (Переслегин)
  gift myslo дегустация "идея"    — собор Ollama-агентов + эпиклеза
  gift myslo винтаж               — διάκρισις по плодам (Vintage отчёт)
  gift myslo карты                — все sommelier-карты иконных актов W
  gift myslo бочка                — идеи в ферментации (_pending в W)

${C.b('Бенчмарк / статус:')}
  gift benchmark                  — CAT-9
  gift status                     — открытые пустыни + энергия

${C.dim('Философия: язык церковный (собор, пустыня, эпиклеза), под капотом — node + claude subagents.')}
`);
}

// ── Обработчики ─────────────────────────────────────────────────────────
const [cmd, sub, ...rest] = process.argv.slice(2);

if (!cmd || cmd === '--help' || cmd === '-h' || cmd === 'help') { help(); process.exit(0); }

try {
  switch (cmd) {

    case 'sobor': {
      if (sub !== 'ask') { help(); process.exit(1); }
      // Пропускаем все rest-аргументы прямо в ask-sobor.mjs
      await run('utils/ask-sobor.mjs', rest);
      break;
    }

    case 'swe': {
      // Передаём все аргументы как есть
      await run('utils/conciliar-swe.mjs', [sub, ...rest].filter(Boolean));
      break;
    }

    case 'pustynya': {
      if (sub === 'list') {
        const raw = await gh('gh issue list --state open --label gift-ready --limit 30 --json number,title');
        const issues = JSON.parse(raw);
        const rx = /пустыня\s+([^\s→]+)\s*→\s*([^\s:]+)/;
        const pustynyas = issues.map(i => {
          const m = i.title.match(rx);
          return m ? { n: i.number, from: m[1], to: m[2] } : null;
        }).filter(Boolean);
        console.log(`\n${C.b('Открытые пустыни')} (${pustynyas.length}):\n`);
        for (const p of pustynyas) console.log(`  ${C.cyan(`#${p.n}`)}  ${p.from} → ${p.to}`);
        console.log();
      } else if (sub === 'resolve') {
        await run('utils/resolve-perichoresis.mjs', rest);
      } else {
        help(); process.exit(1);
      }
      break;
    }

    case 'epiclesis': {
      const mod = await import(resolve(ROOT, 'src/theology/HumanOracleInbox.js'));
      const inbox = new mod.HumanOracleInbox();
      if (sub === 'ask') {
        const toIdx = rest.indexOf('--to');
        const to = toIdx >= 0 ? rest[toIdx + 1] : 'Дионисий';
        const question = rest.filter((a, i) => a !== '--to' && i !== toIdx + 1).join(' ');
        if (!question) { console.error('gift epiclesis ask "вопрос"'); process.exit(1); }
        inbox.recipient = to;
        const id = await inbox.ask(question);
        console.log(`${C.violet('⚡')} вопрос записан: ${C.dim(id)} → data/epiclesis-inbox/`);
        console.log(`   ждёт ответа от ${to}. gift epiclesis pending — посмотреть очередь.`);
      } else if (sub === 'pending') {
        const queue = await inbox.listUnanswered();
        if (!queue.length) { console.log('Очередь пуста.'); break; }
        console.log(`\n${C.b('Неотвеченные эпиклезы')}:\n`);
        for (const q of queue) {
          console.log(`  ${C.violet(q.id)}  → ${q.recipient}`);
          console.log(`    ${q.question}`);
          console.log(`    ${C.dim(q.at)}\n`);
        }
      } else if (sub === 'answer') {
        const [id, ...content] = rest;
        if (!id || !content.length) { console.error('gift epiclesis answer <id> "ответ"'); process.exit(1); }
        const rec = await inbox.markAnswered(id, content.join(' '));
        console.log(`${C.gold('✓')} ответ записан: ${rec.id} → data/epiclesis-outbox/`);
      } else { help(); process.exit(1); }
      break;
    }

    case 'matrix': {
      const NOUS = process.env.NOUS_URL || 'http://localhost:8089';
      if (!sub || sub === 'summary') {
        try {
          const r = await fetch(`${NOUS}/summary`);
          const data = await r.json();
          console.log(`\n${C.b('Матрица W')}  ${C.dim('(nous: ' + NOUS + ')')}\n`);
          console.log(`  Лиц:   ${Object.keys(data.persons || {}).length}`);
          console.log(`  Актов: ${data.totalActs || 'n/a'}`);
          console.log(`  Энергия: ${data.networkEnergy || 'n/a'}\n`);
          const top = Object.entries(data.threads || {})
            .sort((a, b) => b[1] - a[1]).slice(0, 5);
          console.log(`${C.b('Топ нитей:')}`);
          for (const [k, v] of top) console.log(`  ${k}: ${v}`);
          console.log();
        } catch (e) {
          console.log(`nous недоступен (${e.message}). Запусти: npm run nous`);
        }
      } else if (sub === 'commune') {
        const [from, to] = rest;
        if (!from || !to) { console.error('gift matrix commune <from> <to>'); process.exit(1); }
        const r = await fetch(`${NOUS}/commune/${encodeURIComponent(from)}/${encodeURIComponent(to)}`);
        const data = await r.json();
        console.log(JSON.stringify(data, null, 2));
      }
      break;
    }

    case 'benchmark': {
      await run('benchmarks/cat-7.mjs');
      break;
    }

    case 'myslo': {
      // Мыслебродильня — сферный подход (Переслегин) в Gift-онтологии.
      // Под капотом: Decoupage / SymphonyOrchestrator / Vintage / Score.

      if (!sub) {
        console.log(`
${C.b(C.gold('gift myslo'))} — мыслебродильня (сферный подход Переслегина)

  ${C.b('полная "идея"')}      Decoupage → Δοκιμασία → Vintage → Score
                       Полный цикл от идеи до sommelier card.

  ${C.b('cut "идея"')}         διαίρεσις: 4 sphere-инженерии (ground/water/fire/air)
                       Выводит фигуру идеи (полная сфера / без огня / ...).

  ${C.b('дегустация "идея"')}  Собор Ollama-агентов с эпиклезой.
                       4 условия: chorus/perichoretic/kenotic/epiclesis.

  ${C.b('винтаж')}             διάκρισις: какие идеи дали плоды за период.

  ${C.b('карты')}              Все sommelier-карты иконных актов в W.
  ${C.b('бочка')}              Идеи в _pending (ферментация ὑπομονή).

  ${C.dim('Опции для полная/дегустация:')}
    ${C.dim('--no-oracle')}              без эпиклезы (заведомо не-икона)
    ${C.dim('--weight N')}               вес симфонии (default 8)
    ${C.dim('--analyzer mistral:7b')}    модель для Decoupage
`);
        break;
      }

      if (sub === 'полная' || sub === 'full') {
        const idea = rest.filter(a => !a.startsWith('--')).join(' ');
        if (!idea) { console.error('gift myslo полная "текст идеи"'); process.exit(1); }
        const passthrough = rest.filter(a => a.startsWith('--'));
        await run('utils/myslo.mjs', ['--idea', idea, ...passthrough]);
        break;
      }

      if (sub === 'cut') {
        const idea = rest.filter(a => !a.startsWith('--')).join(' ');
        if (!idea) { console.error('gift myslo cut "текст идеи"'); process.exit(1); }
        const passthrough = rest.filter(a => a.startsWith('--'));
        await run('utils/myslo.mjs', ['--idea', idea, '--no-oracle', ...passthrough]);
        // Decoupage в myslo всегда. --no-oracle гарантирует что ждать эпиклезу не будем.
        // Symphony всё равно запустится (быстро без oracle), но это OK для cut-режима.
        break;
      }

      if (sub === 'дегустация' || sub === 'tasting') {
        const idea = rest.filter(a => !a.startsWith('--')).join(' ');
        if (!idea) { console.error('gift myslo дегустация "текст идеи"'); process.exit(1); }
        const passthrough = rest.filter(a => a.startsWith('--'));
        await run('utils/myslo.mjs', ['--idea', idea, '--skip-decoupage', ...passthrough]);
        break;
      }

      if (sub === 'винтаж' || sub === 'vintage') {
        await run('utils/litpulse.mjs', ['--force', 'vintage', ...rest]);
        break;
      }

      if (sub === 'карты' || sub === 'cards') {
        await run('utils/score-first-icon.mjs', rest);
        break;
      }

      if (sub === 'бочка' || sub === 'barrel') {
        // Показать pending-акты (ферментация)
        const { GiftMemory } = await import(resolve(ROOT, 'src/core/GiftMemory.js'));
        const snap = JSON.parse(readFileSync(resolve(ROOT, 'data/sacred-history-W.json'), 'utf8'));
        const mem = GiftMemory.fromSnapshot(snap);
        const pending = mem.pending();
        console.log(`\n${C.b('Бочка')} — идеи в ферментации (${pending.length}):\n`);
        if (!pending.length) { console.log('  (бочка пуста — нет _pending актов)'); break; }
        for (const p of pending.slice(0, 30)) {
          const ageDays = Math.floor((Date.now() - new Date(p.pendingAt).getTime()) / 86400_000);
          console.log(`  ${C.cyan(p.act.giverId.padEnd(12))} → ${p.act.receiverId.padEnd(12)}  ${C.dim(`${ageDays}d`)}`);
          if (p.act.content) console.log(`    ${(p.act.content ?? '').slice(0, 80)}`);
        }
        console.log();
        break;
      }

      console.error(`gift myslo: неизвестная подкоманда '${sub}'. См. gift myslo`);
      process.exit(1);
    }

    case 'session': {
      const { readdirSync, readFileSync } = await import('node:fs');
      const sessDir = resolve(ROOT, 'data/conciliar-swe');
      const files = existsSync(sessDir)
        ? readdirSync(sessDir).filter(f => f.endsWith('.json')).sort().reverse()
        : [];

      if (sub === 'list' || !sub) {
        if (!files.length) { console.log('Сессий не было.'); break; }
        console.log(`\n${C.b('Прошлые соборы')} (${files.length}):\n`);
        for (const f of files.slice(0, 20)) {
          try {
            const r = JSON.parse(readFileSync(resolve(sessDir, f), 'utf8'));
            const time = new Date(r.at || 0).toLocaleString('ru-RU', { dateStyle: 'short', timeStyle: 'short' });
            const dom = r.dominant ? r.dominant.persona : (r.apophatic ? '⟨apophatic⟩' : '⟨silent⟩');
            const q = (r.question || r.task?.title || '').slice(0, 60);
            console.log(`  ${C.cyan(r.id || f.replace('.json',''))}  ${C.dim(time)}`);
            console.log(`    → ${dom} · ${q}`);
          } catch { console.log(`  ${f}  ${C.dim('(нечитабельный)')}`); }
        }
        console.log(`\n  gift session show <id> — подробно\n  gift session last — последний\n`);
      } else if (sub === 'last' || sub === 'show') {
        const target = sub === 'last' ? files[0] : files.find(f => f.includes(rest[0] || ''));
        if (!target) { console.log('Сессия не найдена.'); break; }
        const r = JSON.parse(readFileSync(resolve(sessDir, target), 'utf8'));
        console.log(`\n${C.b(r.id || target)}  ${C.dim(r.at)}`);
        if (r.question) console.log(`${C.b('Вопрос:')} ${r.question}`);
        if (r.task)     console.log(`${C.b('Задача:')} ${r.task.title || r.task}`);
        if (r.elapsedSec) console.log(`${C.dim('время:')} ${r.elapsedSec}s · ${C.dim('режим:')} ${r.mode || 'n/a'}`);
        console.log();
        const logosIcon = { kata: '✗', para: '≈', hyper: '↑' };
        for (const v of r.voices || []) {
          console.log(`${logosIcon[v.logos] || '·'} ${C.b(v.persona)} (${v.logos})`);
          console.log(`  ${(v.content || '').replace(/\n/g, '\n  ')}\n`);
        }
        if (r.dominant) console.log(`${C.gold('⟨dominant⟩')} ${r.dominant.persona} (${r.dominant.logos})`);
        if (r.apophatic) console.log(`${C.violet('⟨apophatic⟩')} собор не сошёлся в dominant`);
        if (r.silent)    console.log(`${C.dim('⟨silent⟩')} ${r.silenceReason || ''}`);
        console.log();
      } else { help(); process.exit(1); }
      break;
    }

    case 'web': {
      const { spawn } = await import('node:child_process');
      const { writeFileSync, readFileSync: rf, existsSync: ex, unlinkSync } = await import('node:fs');
      const pidFile = resolve(ROOT, 'data/.portal.pid');

      if (rest.includes('--stop') || sub === '--stop') {
        if (ex(pidFile)) {
          const pid = parseInt(rf(pidFile, 'utf8'));
          try { process.kill(pid); console.log(`Портал остановлен (pid ${pid}).`); } catch { console.log('Процесс уже не работает.'); }
          unlinkSync(pidFile);
        } else { console.log('Портал не запущен.'); }
        break;
      }

      const port = rest.includes('--port') ? rest[rest.indexOf('--port')+1] : '3700';
      if (ex(pidFile)) {
        const pid = parseInt(rf(pidFile, 'utf8'));
        try { process.kill(pid, 0); console.log(`Портал уже работает на :${port} (pid ${pid})`); break; } catch { /* мёртвый pid */ }
      }

      const child = spawn('node', [resolve(ROOT, 'utils/gift-portal-server.mjs')], {
        detached: true, stdio: 'ignore', cwd: ROOT,
        env: { ...cleanEnv(), PORT: port },
      });
      child.unref();
      writeFileSync(pidFile, String(child.pid));
      console.log(`\n${C.gold('✦')} Скиния Дара открыта`);
      console.log(`  ${C.cyan(`http://localhost:${port}`)}`);
      console.log(`  ${C.dim('gift web --stop  — остановить')}\n`);
      break;
    }

    case 'status': {
      // Открытые пустыни
      try {
        const raw = await gh('gh issue list --state open --label gift-ready --limit 50 --json number,title');
        const issues = JSON.parse(raw);
        const rx = /пустыня\s+([^\s→]+)\s*→\s*([^\s:]+)/;
        const pustynyas = issues.filter(i => rx.test(i.title));
        console.log(`\n${C.b('Статус онтологии дара')}`);
        console.log(`${C.dim('─'.repeat(40))}`);
        console.log(`  Открытые пустыни: ${C.gold(pustynyas.length)}`);
      } catch { console.log('  github недоступен'); }

      // Матрица
      const NOUS = process.env.NOUS_URL || 'http://localhost:8089';
      try {
        const r = await fetch(`${NOUS}/summary`, { signal: AbortSignal.timeout(2000) });
        const d = await r.json();
        console.log(`  Лиц в матрице:    ${Object.keys(d.persons || {}).length}`);
        console.log(`  Энергия сети:     ${d.networkEnergy || 'n/a'}`);
      } catch { console.log('  nous:             ⟨недоступен⟩'); }

      // Эпиклеза queue
      const inboxDir = resolve(ROOT, 'data/epiclesis-inbox');
      if (existsSync(inboxDir)) {
        const { readdirSync } = await import('node:fs');
        const files = readdirSync(inboxDir).filter(f => f.endsWith('.question.json'));
        console.log(`  Эпиклезы в очереди: ${C.violet(files.length)}`);
      } else {
        console.log(`  Эпиклезы в очереди: 0`);
      }
      console.log();
      break;
    }

    default:
      console.error(`Неизвестная команда: ${cmd}`);
      help();
      process.exit(1);
  }
} catch (e) {
  console.error('Ошибка:', e.message);
  process.exit(1);
}
