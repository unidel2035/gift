  status: () => `${C.b('Бенчмарк / статус:')}
  gift benchmark                  — CAT-9
  gift status                     — состояние онтологии (6 слоёв)
  gift glossary ${C.dim('[find <слово>]')}      — словарь греческих терминов (русск.)`,
};

const COMMANDS = Object.keys(HELP_SECTIONS).concat(['benchmark', 'completion', 'version', 'start', 'switch', 'login']);

function help(section = null) {
  if (section && HELP_SECTIONS[section]) {
    console.log('\n' + HELP_SECTIONS[section]() + '\n');
    return;
  }
  if (section) {
    console.error(`Неизвестная команда: ${section}`);
    console.log(`Доступно: ${COMMANDS.join(', ')}`);
    return;
  }
  const all = Object.values(HELP_SECTIONS).map(fn => fn()).join('\n\n');
  console.log(`
${C.b(C.gold('gift'))} — CLI онтологии дара ${C.dim('v' + readVersion())}

${all}

${C.dim('Подробнее: gift help <команда>      Автодополнение: eval "$(gift completion bash)"')}
${C.dim('Философия: язык церковный (собор, пустыня, эпиклеза), под капотом — node + claude subagents.')}
`);
}

function readVersion() {
  try {
    const pkg = JSON.parse(readFileSync(resolve(ROOT, 'package.json'), 'utf8'));
    return pkg.version || '0';
  } catch { return '0'; }
}

function bashCompletion() {
  const cmds = COMMANDS.join(' ');
  const subSobor    = 'ask';
  const subPustynya = 'list resolve';
  const subEpiclesis= 'ask pending answer';
  const subMatrix   = 'commune';
  const subSession  = 'list last show';
  const subMyslo    = 'полная cut дегустация винтаж карты бочка';
  const subTreasure = 'recall unfold ingest stats';
  const subAgrypnia = 'tick list cancel once daily interval';
  const subChat     = '--resume --list last';
  const subGlossary = 'find';
  return `# gift bash completion (eval "$(gift completion bash)")
_gift_completions() {
  local cur prev cmd
  COMPREPLY=()
  cur="\${COMP_WORDS[COMP_CWORD]}"
  cmd="\${COMP_WORDS[1]}"
  if [ "\$COMP_CWORD" -eq 1 ]; then
    COMPREPLY=( $(compgen -W "${cmds} help" -- "\$cur") )
    return
  fi
  case "\$cmd" in
    sobor)     COMPREPLY=( $(compgen -W "${subSobor}" -- "\$cur") );;
    pustynya)  COMPREPLY=( $(compgen -W "${subPustynya}" -- "\$cur") );;
    epiclesis) COMPREPLY=( $(compgen -W "${subEpiclesis}" -- "\$cur") );;
    matrix)    COMPREPLY=( $(compgen -W "${subMatrix}" -- "\$cur") );;
    session)   COMPREPLY=( $(compgen -W "${subSession}" -- "\$cur") );;
    myslo)     COMPREPLY=( $(compgen -W "${subMyslo}" -- "\$cur") );;
    treasure)  COMPREPLY=( $(compgen -W "${subTreasure}" -- "\$cur") );;
    agrypnia)  COMPREPLY=( $(compgen -W "${subAgrypnia}" -- "\$cur") );;
    chat)      COMPREPLY=( $(compgen -W "${subChat}" -- "\$cur") );;
    glossary)  COMPREPLY=( $(compgen -W "${subGlossary}" -- "\$cur") );;
    help)      COMPREPLY=( $(compgen -W "${cmds}" -- "\$cur") );;
  esac
}
complete -F _gift_completions gift
`;
}

// ── Обработчики ─────────────────────────────────────────────────────────
let [cmd, sub, ...rest] = process.argv.slice(2);

if (cmd === '--version' || cmd === '-v') { console.log(readVersion()); process.exit(0); }
if (cmd === '--help' || cmd === '-h') { help(); process.exit(0); }
if (cmd === 'help') { help(sub); process.exit(0); }
// gift --resume <id> / gift resume <id> → продолжить сессию агента (code-режим)
if (cmd === '--resume' || cmd === 'resume') {
  if (sub) process.env.GIFT_RESUME = sub;
  cmd = 'start'; sub = undefined; rest = [];
}
if (cmd === 'completion') {
  if (sub === 'bash') { console.log(bashCompletion()); process.exit(0); }
  console.error('usage: gift completion bash');
  process.exit(1);
}

// Без аргументов:
//   - в TTY → меню выбора режима
//   - не в TTY (pipe, скрипт) → help
if (!cmd) {
  if (!process.stdin.isTTY) {
    help();
    process.exit(0);
  }

  // GIFT_RESUME=<id> gift → сразу продолжить сессию в code-режиме (без меню)
  if (process.env.GIFT_RESUME) {
    cmd = 'start';
  } else {

  // Интерактивный выбор режима
  const { createInterface } = await import('node:readline');
  console.log(`
  ${C.b(C.gold('gift'))} v${readVersion()}

  ${C.b('1')}  ${C.cyan('code')}    Кодинг через дешёвые LLM (DeepSeek/RouterAI)
  ${C.b('2')}  ${C.violet('sobor')}   Собор лиц — богословский REPL

  ${C.dim('Enter = code  |  gift chat — сразу в собор  |  gift --help — все команды')}
`);

  const rl = createInterface({ input: process.stdin, output: process.stdout });
  const answer = await new Promise(resolve => {
    rl.question('  > ', ans => { rl.close(); resolve(ans.trim()); });
  });

  if (answer === '2' || answer === 'sobor' || answer === 'chat') {
    cmd = 'chat';
  } else {
    cmd = 'start';
  }
  }
}

try {
  switch (cmd) {

    case 'sobor': {
      if (sub !== 'ask') { help(); process.exit(1); }
      // Пропускаем все rest-аргументы прямо в ask-sobor.mjs
      await run('utils/ask-sobor.mjs', rest);
      break;
    }

    case 'swe': {
      // Передаём все аргументы как есть
      await run('utils/conciliar-swe.mjs', [sub, ...rest].filter(Boolean));
      break;
    }

    case 'pustynya': {
      if (sub === 'list') {
        const raw = await gh('gh issue list --state open --label gift-ready --limit 30 --json number,title');
        const issues = JSON.parse(raw);
        const rx = /пустыня\s+([^\s→]+)\s*→\s*([^\s:]+)/;
        const pustynyas = issues.map(i => {
          const m = i.title.match(rx);
          return m ? { n: i.number, from: m[1], to: m[2] } : null;
        }).filter(Boolean);
        console.log(`\n${C.b('Открытые пустыни')} (${pustynyas.length}):\n`);
        for (const p of pustynyas) console.log(`  ${C.cyan(`#${p.n}`)}  ${p.from} → ${p.to}`);
        console.log();
      } else if (sub === 'resolve') {
        await run('utils/resolve-perichoresis.mjs', rest);
      } else {
        help(); process.exit(1);
      }
      break;
    }

    case 'epiclesis': {
      const mod = await import(resolve(ROOT, 'src/theology/HumanOracleInbox.js'));
      const inbox = new mod.HumanOracleInbox();
      if (sub === 'ask') {
        const toIdx = rest.indexOf('--to');
        const to = toIdx >= 0 ? rest[toIdx + 1] : 'Дионисий';
        const question = rest.filter((a, i) => a !== '--to' && i !== toIdx + 1).join(' ');
        if (!question) { console.error('gift epiclesis ask "вопрос"'); process.exit(1); }
        inbox.recipient = to;
        const id = await inbox.ask(question);
        console.log(`${C.violet('⚡')} вопрос записан: ${C.dim(id)} → data/epiclesis-inbox/`);
        console.log(`   ждёт ответа от ${to}. gift epiclesis pending — посмотреть очередь.`);
      } else if (sub === 'pending') {
        const queue = await inbox.listUnanswered();
        if (!queue.length) { console.log('Очередь пуста.'); break; }
        console.log(`\n${C.b('Неотвеченные эпиклезы')}:\n`);
        for (const q of queue) {
          console.log(`  ${C.violet(q.id)}  → ${q.recipient}`);
          console.log(`    ${q.question}`);
          console.log(`    ${C.dim(q.at)}\n`);
        }
      } else if (sub === 'answer') {
        const [id, ...content] = rest;
        if (!id || !content.length) { console.error('gift epiclesis answer <id> "ответ"'); process.exit(1); }
        const rec = await inbox.markAnswered(id, content.join(' '));
        console.log(`${C.gold('✓')} ответ записан: ${rec.id} → data/epiclesis-outbox/`);
      } else { help(); process.exit(1); }
      break;
    }

    case 'matrix': {
      const NOUS = process.env.NOUS_URL || 'http://localhost:8089';
      if (!sub || sub === 'summary') {
        try {
          const r = await fetch(`${NOUS}/summary`);
          const data = await r.json();
          console.log(`\n${C.b('Матрица W')}  ${C.dim('(nous: ' + NOUS + ')')}\n`);
          console.log(`  Лиц:   ${Object.keys(data.persons || {}).length}`);
          console.log(`  Актов: ${data.totalActs || 'n/a'}`);
          console.log(`  Энергия: ${data.networkEnergy || 'n/a'}\n`);
          const top = Object.entries(data.threads || {})
            .sort((a, b) => b[1] - a[1]).slice(0, 5);
          console.log(`${C.b('Топ нитей:')}`);
          for (const [k, v] of top) console.log(`  ${k}: ${v}`);
          console.log();
        } catch (e) {
          console.log(`nous недоступен (${e.message}). Запусти: npm run nous`);
        }
      } else if (sub === 'commune') {
        const [from, to] = rest;
        if (!from || !to) { console.error('gift matrix commune <from> <to>'); process.exit(1); }
        const r = await fetch(`${NOUS}/commune/${encodeURIComponent(from)}/${encodeURIComponent(to)}`);
        const data = await r.json();
        console.log(JSON.stringify(data, null, 2));
      }
      break;
    }

    case 'benchmark': {
      await run('benchmarks/cat-7.mjs');
      break;
    }

    case 'agent': {
      // Агентный режим. runRaw сохраняет HTTP_PROXY/HTTPS_PROXY env vars —
      // они нужны curl/fetch'ам в WSL2 для выхода через Windows proxy.
      const allArgs = [sub, ...rest].filter(Boolean);
      await runRaw('bin/gift-agent', allArgs);
      break;
    }

    case 'myslo': {
      // Мыслебродильня — сферный подход (Переслегин) в Gift-онтологии.
      // Под капотом: Decoupage / SymphonyOrchestrator / Vintage / Score.

      if (!sub) {
        console.log(`
${C.b(C.gold('gift myslo'))} — мыслебродильня (сферный подход Переслегина)

  ${C.b('полная "идея"')}      Decoupage → Δοκιμασία → Vintage → Score
                       Полный цикл от идеи до sommelier card.

  ${C.b('cut "идея"')}         διαίρεσις: 4 sphere-инженерии (ground/water/fire/air)
                       Выводит фигуру идеи (полная сфера / без огня / ...).

  ${C.b('дегустация "идея"')}  Собор Ollama-агентов с эпиклезой.
                       4 условия: chorus/perichoretic/kenotic/epiclesis.

  ${C.b('винтаж')}             διάκρισις: какие идеи дали плоды за период.

  ${C.b('карты')}              Все sommelier-карты иконных актов в W.
  ${C.b('бочка')}              Идеи в _pending (ферментация ὑπομονή).

  ${C.dim('Опции для полная/дегустация:')}
    ${C.dim('--no-oracle')}              без эпиклезы (заведомо не-икона)
    ${C.dim('--weight N')}               вес симфонии (default 8)
    ${C.dim('--analyzer mistral:7b')}    модель для Decoupage
`);
        break;
      }

      if (sub === 'полная' || sub === 'full') {
        const idea = rest.filter(a => !a.startsWith('--')).join(' ');
        if (!idea) { console.error('gift myslo полная "текст идеи"'); process.exit(1); }
        const passthrough = rest.filter(a => a.startsWith('--'));
        await run('utils/myslo.mjs', ['--idea', idea, ...passthrough]);
        break;
      }

      if (sub === 'cut') {
        const idea = rest.filter(a => !a.startsWith('--')).join(' ');
        if (!idea) { console.error('gift myslo cut "текст идеи"'); process.exit(1); }
        const passthrough = rest.filter(a => a.startsWith('--'));
        await run('utils/myslo.mjs', ['--idea', idea, '--no-oracle', ...passthrough]);
        // Decoupage в myslo всегда. --no-oracle гарантирует что ждать эпиклезу не будем.
        // Symphony всё равно запустится (быстро без oracle), но это OK для cut-режима.
        break;
      }

      if (sub === 'дегустация' || sub === 'tasting') {
        const idea = rest.filter(a => !a.startsWith('--')).join(' ');
        if (!idea) { console.error('gift myslo дегустация "текст идеи"'); process.exit(1); }
        const passthrough = rest.filter(a => a.startsWith('--'));
        await run('utils/myslo.mjs', ['--idea', idea, '--skip-decoupage', ...passthrough]);
        break;
      }

      if (sub === 'винтаж' || sub === 'vintage') {
        await run('utils/litpulse.mjs', ['--force', 'vintage', ...rest]);
        break;
      }

      if (sub === 'карты' || sub === 'cards') {
        await run('utils/score-first-icon.mjs', rest);
        break;
      }

      if (sub === 'бочка' || sub === 'barrel') {
        // Показать pending-акты (ферментация)
        const { GiftMemory } = await import(resolve(ROOT, 'src/core/GiftMemory.js'));
        const snap = JSON.parse(readFileSync(resolve(ROOT, 'data/sacred-history-W.json'), 'utf8'));
        const mem = GiftMemory.fromSnapshot(snap);
        const pending = mem.pending();
        console.log(`\n${C.b('Бочка')} — идеи в ферментации (${pending.length}):\n`);
        if (!pending.length) { console.log('  (бочка пуста — нет _pending актов)'); break; }
        for (const p of pending.slice(0, 30)) {
          const ageDays = Math.floor((Date.now() - new Date(p.pendingAt).getTime()) / 86400_000);
          console.log(`  ${C.cyan(p.act.giverId.padEnd(12))} → ${p.act.receiverId.padEnd(12)}  ${C.dim(`${ageDays}d`)}`);
          if (p.act.content) console.log(`    ${(p.act.content ?? '').slice(0, 80)}`);
        }
        console.log();
        break;
      }

      console.error(`gift myslo: неизвестная подкоманда '${sub}'. См. gift myslo`);
      process.exit(1);
    }

    case 'session': {
      const { readdirSync, readFileSync } = await import('node:fs');
      const sessDir = resolve(ROOT, 'data/conciliar-swe');
      const files = existsSync(sessDir)
        ? readdirSync(sessDir).filter(f => f.endsWith('.json')).sort().reverse()
        : [];

      if (sub === 'list' || !sub) {
        if (!files.length) { console.log('Сессий не было.'); break; }
        console.log(`\n${C.b('Прошлые соборы')} (${files.length}):\n`);
        for (const f of files.slice(0, 20)) {
          try {
            const r = JSON.parse(readFileSync(resolve(sessDir, f), 'utf8'));
            const time = new Date(r.at || 0).toLocaleString('ru-RU', { dateStyle: 'short', timeStyle: 'short' });
            const dom = r.dominant ? r.dominant.persona : (r.apophatic ? '⟨apophatic⟩' : '⟨silent⟩');
            const q = (r.question || r.task?.title || '').slice(0, 60);
            console.log(`  ${C.cyan(r.id || f.replace('.json',''))}  ${C.dim(time)}`);
            console.log(`    → ${dom} · ${q}`);
          } catch { console.log(`  ${f}  ${C.dim('(нечитабельный)')}`); }
        }
        console.log(`\n  gift session show <id> — подробно\n  gift session last — последний\n`);
      } else if (sub === 'last' || sub === 'show') {
        const target = sub === 'last' ? files[0] : files.find(f => f.includes(rest[0] || ''));
        if (!target) { console.log('Сессия не найдена.'); break; }
        const r = JSON.parse(readFileSync(resolve(sessDir, target), 'utf8'));
        console.log(`\n${C.b(r.id || target)}  ${C.dim(r.at)}`);
        if (r.question) console.log(`${C.b('Вопрос:')} ${r.question}`);
        if (r.task)     console.log(`${C.b('Задача:')} ${r.task.title || r.task}`);
        if (r.elapsedSec) console.log(`${C.dim('время:')} ${r.elapsedSec}s · ${C.dim('режим:')} ${r.mode || 'n/a'}`);
        console.log();
        const logosIcon = { kata: '✗', para: '≈', hyper: '↑' };
        for (const v of r.voices || []) {
          console.log(`${logosIcon[v.logos] || '·'} ${C.b(v.persona)} (${v.logos})`);
          console.log(`  ${(v.content || '').replace(/\n/g, '\n  ')}\n`);
        }
        if (r.dominant) console.log(`${C.gold('⟨dominant⟩')} ${r.dominant.persona} (${r.dominant.logos})`);
        if (r.apophatic) console.log(`${C.violet('⟨apophatic⟩')} собор не сошёлся в dominant`);
        if (r.silent)    console.log(`${C.dim('⟨silent⟩')} ${r.silenceReason || ''}`);
        console.log();
      } else { help(); process.exit(1); }
      break;
    }

    case 'web': {
      const { spawn } = await import('node:child_process');
      const { writeFileSync, readFileSync: rf, existsSync: ex, unlinkSync } = await import('node:fs');
      const pidFile = resolve(ROOT, 'data/.portal.pid');

      if (rest.includes('--stop') || sub === '--stop') {
        if (ex(pidFile)) {
          const pid = parseInt(rf(pidFile, 'utf8'));
          try { process.kill(pid); console.log(`Портал остановлен (pid ${pid}).`); } catch { console.log('Процесс уже не работает.'); }
          unlinkSync(pidFile);
        } else { console.log('Портал не запущен.'); }
        break;
      }

      const port = rest.includes('--port') ? rest[rest.indexOf('--port')+1] : '3700';
      if (ex(pidFile)) {
        const pid = parseInt(rf(pidFile, 'utf8'));
        try { process.kill(pid, 0); console.log(`Портал уже работает на :${port} (pid ${pid})`); break; } catch { /* мёртвый pid */ }
      }

      const child = spawn('node', [resolve(ROOT, 'utils/gift-portal-server.mjs')], {
        detached: true, stdio: 'ignore', cwd: ROOT,
        // PROXY_ORIG восстанавливает HTTP_PROXY/HTTPS_PROXY — нужны для
        // claude --print, который polyphony-orchestrator вызывает изнутри.
        // GIFT_KEEP_PROXY=1 — чтобы cleanEnv внутри полифонии тоже не стирал
        // proxy на каждом вызове claude. NO_PROXY=localhost уже выставлен.
        env: { ...cleanEnv(), ...PROXY_ORIG, GIFT_KEEP_PROXY: '1', PORT: port },
      });
      child.unref();
      writeFileSync(pidFile, String(child.pid));
      console.log(`\n${C.gold('✦')} Скиния Дара открыта`);
      console.log(`  ${C.cyan(`http://localhost:${port}`)}`);
      console.log(`  ${C.dim('gift web --stop  — остановить')}`);
      console.log(`  ${C.dim('gift silero start — для качественного голоса на /voice')}\n`);
      break;
    }

    case 'autonomy': {
      // Daemon, который каждую минуту дёргает agrypnia tick.
      // Без него запланированные бдения (pulse, dev-loop) не сработают.
      const { writeFileSync, readFileSync: rf, existsSync: ex, unlinkSync, openSync } = await import('node:fs');
      const pidFile = resolve(ROOT, 'data/.autonomy.pid');

      if (sub === 'stop' || rest.includes('--stop')) {
        if (ex(pidFile)) {
          try { process.kill(parseInt(rf(pidFile, 'utf8'))); console.log('Автономия остановлена.'); }
          catch { console.log('Процесс уже не работает.'); }
          unlinkSync(pidFile);
        } else { console.log('Автономия не запущена.'); }
        break;
      }
      if (sub === 'status') {
        if (ex(pidFile)) {
          const pid = parseInt(rf(pidFile, 'utf8'));
          try { process.kill(pid, 0); console.log(`Автономия работает (pid ${pid})`); }
          catch { console.log('pid-файл есть, но процесс мёртв.'); }
        } else { console.log('Автономия не запущена. gift autonomy start'); }
        break;
      }
      // start
      if (ex(pidFile)) {
        try { process.kill(parseInt(rf(pidFile, 'utf8')), 0);
          console.log(`Уже работает (pid ${rf(pidFile, 'utf8')})`); break;
        } catch {}
      }
      const logPath = resolve(ROOT, 'data/autonomy.log');
      const out = openSync(logPath, 'a');
      const child = spawn('node', [resolve(ROOT, 'utils/autonomy-daemon.mjs')], {
        detached: true, stdio: ['ignore', out, out], cwd: ROOT,
        env: { ...cleanEnv(), ...PROXY_ORIG, GIFT_KEEP_PROXY: '1' },
      });
      child.unref();
      writeFileSync(pidFile, String(child.pid));
      console.log(`\n${C.gold('✦')} Автономия запущена (pid ${child.pid})`);
      console.log(`  ${C.dim('каждую минуту dёргает agrypnia tick')}`);
      console.log(`  ${C.dim('лог: data/autonomy.log  ·  gift autonomy stop')}\n`);
      break;
    }

    case 'silero': {
      // Локальный Silero TTS сервер для /voice (порт 8091).
      // Модель скачивается один раз ~120МБ в data/silero/.
      const { writeFileSync, readFileSync: rf, existsSync: ex, unlinkSync } = await import('node:fs');
      const pidFile = resolve(ROOT, 'data/.silero.pid');

      if (sub === 'stop' || rest.includes('--stop')) {
        if (ex(pidFile)) {
          try { process.kill(parseInt(rf(pidFile, 'utf8'))); console.log('Silero остановлен.'); }
          catch { console.log('Процесс уже не работает.'); }
          unlinkSync(pidFile);
        } else { console.log('Silero не запущен.'); }
        break;
      }
      if (sub === 'status') {
        if (ex(pidFile)) {
          const pid = parseInt(rf(pidFile, 'utf8'));
          try { process.kill(pid, 0); console.log(`Silero работает (pid ${pid}, порт 8091)`); }
          catch { console.log('pid-файл есть, но процесс мёртв. Удали data/.silero.pid'); }
        } else { console.log('Silero не запущен. gift silero start'); }
        break;
      }
      // start (по умолчанию)
      if (ex(pidFile)) {
        const pid = parseInt(rf(pidFile, 'utf8'));
        try { process.kill(pid, 0); console.log(`Silero уже работает (pid ${pid})`); break; } catch {}
      }
      const logPath = resolve(ROOT, 'data/silero.log');
      const { openSync } = await import('node:fs');
      const out = openSync(logPath, 'a');
      const child = spawn('python3', [resolve(ROOT, 'utils/silero-tts-server.py'), '--preload'], {
        detached: true, stdio: ['ignore', out, out], cwd: ROOT,
        env: { ...cleanEnv() },
      });
      child.unref();
      writeFileSync(pidFile, String(child.pid));
      console.log(`\n${C.gold('✦')} Silero TTS запущен (pid ${child.pid})`);
      console.log(`  ${C.dim('первая загрузка модели ~30 сек, потом мгновенно')}`);
      console.log(`  ${C.dim('лог: data/silero.log  ·  gift silero stop  — остановить')}\n`);
      break;
    }

    case 'treasure': {
      // θησαυρός — фасад над utils/lcm-cli.mjs.
      // Подкоманды: recall | unfold | ingest | stats
      if (!sub) { help(); process.exit(1); }
      await run('utils/lcm-cli.mjs', [sub, ...rest]);
      break;
    }

    case 'agrypnia': {
      // ἀγρυπνία — фасад над utils/agrypnia-tick.mjs.
      // Подкоманды: tick | list | cancel | once | daily | interval
      if (!sub) { help(); process.exit(1); }
      await run('utils/agrypnia-tick.mjs', [sub, ...rest]);
      break;
    }

    // ── Proxy layer (deepclaude) ──────────────────────────────────────
    case 'start': {
      // gift start [--backend ra|ds|or|fw] [--port 3200] [extra claude args]
      const { launchWithClaude } = await import(resolve(ROOT, 'src/proxy/launcher.js'));
      const backendIdx = [sub, ...rest].indexOf('--backend');
      const portIdx = [sub, ...rest].indexOf('--port');
      const allArgs = [sub, ...rest].filter(Boolean);
      const backend = backendIdx >= 0 ? allArgs[backendIdx + 1] : undefined;
      const port = portIdx >= 0 ? parseInt(allArgs[portIdx + 1]) : 3200;
      const claudeArgs = allArgs.filter((a, i) =>
        a !== '--backend' && a !== '--port' &&
        i !== backendIdx + 1 && i !== portIdx + 1
      );
      const shortMap = { ra: 'routerai', ds: 'deepseek', or: 'openrouter', fw: 'fireworks' };
      await launchWithClaude({
        backend: shortMap[backend] || backend,
        port,
        claudeArgs,
      });
      break;
    }

    case 'switch': {
      // gift switch [ra|ds|or|fw|anthropic]
      const PROXY = 'http://127.0.0.1:3200';
      const shortMap = { ra: 'routerai', ds: 'deepseek', or: 'openrouter', fw: 'fireworks' };
      if (!sub) {
        try {
          const r = await fetch(`${PROXY}/_proxy/status`);
          const data = await r.json();
          console.log(`\nПровайдер: ${C.b(data.label || data.mode)}`);
          console.log(`Модель: ${data.model || '?'}`);
          console.log(`Запросов: ${data.requests || 0}\n`);
        } catch { console.error('Прокси не запущен. Запусти: gift start'); }
      } else {
        const backend = shortMap[sub] || sub;
        try {
          const r = await fetch(`${PROXY}/_proxy/mode`, {
            method: 'POST',
            headers: { 'content-type': 'application/x-www-form-urlencoded' },
            body: `backend=${backend}`,
          });
          const data = await r.json();
          if (data.error) { console.error(`Ошибка: ${data.error}`); }
          else { console.log(`${data.previous} → ${C.b(data.mode)} (${data.label || ''})`); }
        } catch { console.error('Прокси не запущен. Запусти: gift start'); }
      }
      break;
    }

    case 'login': {
      // gift login ra sk-PQcW...
      const PROXY = 'http://127.0.0.1:3200';
      const shortMap = { ra: 'routerai', ds: 'deepseek', or: 'openrouter', fw: 'fireworks' };
      if (!sub || rest.length === 0) {
        console.log(`
${C.b('gift login')} <бэкенд> <api-key>

  ra <key>    — RouterAI (рубли, дешёвый)
  ds <key>    — DeepSeek
  or <key>    — OpenRouter
  fw <key>    — Fireworks AI
`);
        break;
      }
      const backend = shortMap[sub] || sub;
      const key = rest[0];
      try {
        await fetch(`${PROXY}/_proxy/key`, {
          method: 'POST',
          headers: { 'content-type': 'application/x-www-form-urlencoded' },
          body: `backend=${backend}&key=${key}`,
        });
        // Auto-switch
        const r = await fetch(`${PROXY}/_proxy/mode`, {
          method: 'POST',
          headers: { 'content-type': 'application/x-www-form-urlencoded' },
          body: `backend=${backend}`,
        });
        const data = await r.json();
        console.log(`Ключ установлен, переключено на ${C.b(data.mode)} (${data.label || ''})`);
      } catch { console.error('Прокси не запущен. Запусти: gift start'); }
      break;
    }

    case 'code': {
      // Shell script — единственный способ правильно передать TTY
      const { execSync: execS } = await import('node:child_process');
      const scriptPath = resolve(ROOT, 'bin', 'gift-code');
      const extraArgs = [sub, ...rest].filter(Boolean).map(a => `"${a}"`).join(' ');
      // exec заменяет Node-процесс на bash — TTY передаётся полностью
      execS(`exec bash "${scriptPath}" ${extraArgs}`, { stdio: 'inherit' });
      break;
    }

    case 'chat': {
      // Multi-turn REPL поверх claude-agent-sdk.
      // ВАЖНО: запускаем в parent process — child через spawn не передаёт
      // полноценный TTY, и process.stdin.setRawMode(true) проваливается
      // тихо. Без raw mode keypress events не приходят, и меню '/'
      // не всплывает. TF noise глушим stderr-redirect-трюком на время
      // import (ниже).
      //
      // Восстанавливаем proxy для SDK egress (polza-runner curl):
      for (const [k, v] of Object.entries(PROXY_ORIG)) process.env[k] = v;
      // TF env (на всякий случай — не помогает в parent, но не мешает):
      process.env.TF_CPP_MIN_LOG_LEVEL  = '3';
      process.env.TF_ENABLE_ONEDNN_OPTS = '0';

      // Глушим stderr во время import (там tfjs-node native пишет init-логи)
      const origStderrWrite = process.stderr.write.bind(process.stderr);
      process.stderr.write = () => true;
      let runGiftRepl, giftReplApi;
      try {
        ({ runGiftRepl, giftReplApi } = await import(resolve(ROOT, 'src/agent-cli/repl.js')));
      } finally {
        process.stderr.write = origStderrWrite;
      }

      const allArgs = [sub, ...rest].filter(Boolean);
      if (allArgs[0] === '--list') {
        const ls = giftReplApi.listSessions(20);
        if (!ls.length) { console.log('Сессий нет.'); break; }
        console.log(`\n${C.b('Последние REPL-сессии:')}`);
        for (const s of ls) {
          const title = s.title ? `  ${C.b(s.title)}` : '';
          console.log(`  ${s.id}  ${C.dim(`${s.turns} turns`)}  ${C.dim(s.updatedAt)}${title}`);
        }
        console.log();
        break;
      }
      const resumeIdx = allArgs.indexOf('--resume');
      const resumeId = resumeIdx >= 0 ? allArgs[resumeIdx + 1] : null;
      const planMode = allArgs.includes('--plan');
      try {
        await runGiftRepl({ resumeId, planMode });
      } catch (e) {
        console.error(`Ошибка: ${e.message}`);
        process.exit(1);
      }
      break;
    }

    case 'glossary': {
      // Словарь греческих терминов (греч. → рус.) — снимает языковой барьер.
      const allArgs = [sub, ...rest].filter(Boolean);
      await run('utils/gift-glossary.mjs', allArgs);
      break;
    }

    case 'koinon': {
      // Шина межсессионной коммуникации Claude в семье gift
      const allArgs = [sub, ...rest].filter(Boolean);
      await run('utils/koinon-cli.mjs', allArgs);
      break;
    }

    case 'goal': {
      // Long-horizon цели: gift-аналог Codex /goal с μετάνοια-шагом.
      // runRaw — потому что внутри ClaudeExecutor вызывается `claude --print`,
      // которому нужен Windows proxy для egress (как и agent-режиму).
      const allArgs = [sub, ...rest].filter(Boolean);
      await runRaw('utils/goal-cli.mjs', allArgs);
      break;
    }

    case 'team': {
      // Командное кодирование как организм: присутствие + намерения + органы +
      // ревю-ворота (слепой ревьюер + испытание) + спекулятивный турнир.
      await runRaw('utils/gift-team.mjs', [sub, ...rest].filter(Boolean));
      break;
    }

    case 'space': {
      // Пространство кентавров: единое живое поле всего тела на одном экране
      // (присутствие+органы+намерения+конфликты+память+федерация+иммунитет).
      // --watch — живое поле (дышит). Это устье, gift team — руки.
      await runRaw('utils/gift-space.mjs', [sub, ...rest].filter(Boolean));
      break;
    }

    case 'lesson': {
      // Память-рефлекс кентавра (7-й слой): захват выученных РЕШЕНИЙ как правил,
      // которые PreToolUse-хук lesson-guard впрыскивает/блокирует в точке действия.
      await runRaw('utils/lessons.mjs', [sub, ...rest].filter(Boolean));
      break;
    }

    case 'formal': {
      // Нейросимвольный мост к formal-ai (Костя): детерминированные подзадачи
      // (счёт/процент/валюта/арифметика) — символическому движку, не LLM.
      await runRaw('utils/formal-ai.mjs', [sub, ...rest].filter(Boolean));
      break;
    }

    case 'harmony': {
      // Закон структурной гармонии систем (Сороко): диагноз сети W по золотой
      // пропорции дал/принял. Гармония пира = золотой узел 0.618; асимметрия
      // источник→телос — по замыслу, не болезнь.
      await runRaw('utils/harmony.mjs', [sub, ...rest].filter(Boolean));
      break;
    }

    case 'genotensor': {
      // W как кронекеров тензор жанров (Петухов): помехоустойчивость = анти-фиктивность
      // структурой. Настоящий акт сохраняет перенос (Σтрит=0); фикция отбраковывается.
      await runRaw('utils/genotensor.mjs', [sub, ...rest].filter(Boolean));
      break;
    }

    case 'axioms': {
      // Defeasible reasoning (FLoC26: KR/DL, NMR) над лентой актов: default-правило
      // тип→канонический вес (отменяемо через note), hard-правило завет=10 (не отменяемо),
      // precedence «время тяжелее денег» кросс-инстансно по всей ленте.
      await runRaw('utils/axioms.mjs', [sub, ...rest].filter(Boolean));
      break;
    }

    case 'ontology-drift': {
      // FLoC26 KR/DL: TBox (data/gift-act.schema.json enum) vs ABox (giverId+type по
      // всей кодовой базе). Ловит типы, которые код уже пишет в W, а схема не признаёт.
      await runRaw('utils/ontology-drift.mjs', [sub, ...rest].filter(Boolean));
      break;
    }

    case 'ideas': {
      await runRaw('utils/idea-graph.mjs', [sub, ...rest].filter(Boolean));
      break;
    }

    case 'recap': {
      await runRaw('utils/recap.mjs', [sub, ...rest].filter(Boolean));
      break;
    }

    case 'episodes': {
      await runRaw('utils/episodes.mjs', [sub, ...rest].filter(Boolean));
      break;
    }

    case 'organs': {
      await runRaw('utils/install-organs.mjs', [...rest].filter(Boolean));
      break;
    }

    case 'kairos': {
      await runRaw('utils/kairos.mjs', [sub, ...rest].filter(Boolean));
      break;
    }

    case 'genre': {
      // W, разложенный по жанрам (Петухов): плоский скаляр = Σ по жанрам (маргинал).
      // Жанры компонуются по Кронекеру (завет·дар). Рефинирует W, не ломая старую проекцию.
      await runRaw('utils/genre-tensor-w.mjs', [sub, ...rest].filter(Boolean));
      break;
    }

    case 'status': {
      console.log(`\n${C.b('Статус онтологии дара')} ${C.dim('v' + readVersion())}`);
      console.log(`${C.dim('─'.repeat(46))}`);
      // Открытые пустыни
      try {
        const raw = await gh('gh issue list --state open --label gift-ready --limit 50 --json number,title');
        const issues = JSON.parse(raw);
        const rx = /пустыня\s+([^\s→]+)\s*→\s*([^\s:]+)/;
        const pustynyas = issues.filter(i => rx.test(i.title));
        console.log(`  Открытые пустыни: ${C.gold(pustynyas.length)}`);
      } catch { console.log(`  Открытые пустыни: ${C.dim('github недоступен')}`); }

      // Матрица
      const NOUS = process.env.NOUS_URL || 'http://localhost:8089';
      try {
        const r = await fetch(`${NOUS}/summary`, { signal: AbortSignal.timeout(2000) });
        const d = await r.json();
        console.log(`  Лиц в матрице:    ${Object.keys(d.persons || {}).length}`);
        console.log(`  Энергия сети:     ${d.networkEnergy || 'n/a'}`);
      } catch {
        console.log(`  Лиц в матрице:    ${C.dim('nous недоступен')}`);
        console.log(`  Энергия сети:     ${C.dim('nous недоступен')}`);
      }

      // Эпиклеза queue
      const inboxDir = resolve(ROOT, 'data/epiclesis-inbox');
      if (existsSync(inboxDir)) {
        const { readdirSync } = await import('node:fs');
        const files = readdirSync(inboxDir).filter(f => f.endsWith('.question.json'));
        console.log(`  Эпиклезы в очереди: ${C.violet(files.length)}`);
      } else {
        console.log(`  Эпиклезы в очереди: 0`);
      }

      // Сокровищница (θησαυρός)
      try {
        const lcmPath = resolve(ROOT, 'data/lcm.db');
        if (existsSync(lcmPath)) {
          const { LcmStore } = await import(resolve(ROOT, 'src/lcm/store.js'));
          const store = new LcmStore(lcmPath);
          const s = store.stats();
          const parts = Object.entries(s.bySource).map(([k, n]) => `${k}:${n}`).join(' ');
          console.log(`  Сокровищница:     ${C.gold(s.total)} ${C.dim('(' + parts + ')')}`);
          store.close();
        } else {
          console.log(`  Сокровищница:     ${C.dim('пуста (gift treasure ingest)')}`);
        }
      } catch { console.log(`  Сокровищница:     ${C.dim('n/a')}`); }

      // Бдения (ἀγρυπνία)
      try {
        const cronPath = resolve(ROOT, 'data/dynamic-cron.json');
        if (existsSync(cronPath)) {
          const { AgrypniaScheduler } = await import(resolve(ROOT, 'src/scheduling/AgrypniaScheduler.js'));
          const sched = new AgrypniaScheduler(cronPath);
          const jobs = sched.list();
          console.log(`  Бдений активно:   ${C.cyan(jobs.length)}`);
          if (jobs.length) {
            const now = Date.now();
            const due = j => {
              if (j.type === 'once') return Date.parse(j.schedule);
              if (j.type === 'interval') {
                const last = j.lastFiredAt ? Date.parse(j.lastFiredAt) : Date.parse(j.created);
                return last + Number(j.schedule) * 1000;
              }
              if (j.type === 'daily') {
                const [h, m] = String(j.schedule).split(':').map(Number);
                const today = new Date();
                today.setUTCHours(h, m, 0, 0);
                if (today.getTime() < now ||
                    (j.lastFiredAt && Date.parse(j.lastFiredAt) >= today.getTime())) {
                  today.setUTCDate(today.getUTCDate() + 1);
                }
                return today.getTime();
              }
              return null;
            };
            const next = jobs.map(j => ({ j, t: due(j) }))
                             .filter(x => x.t).sort((a, b) => a.t - b.t)[0];
            if (next) {
              const when = new Date(next.t).toISOString().replace('T', ' ').replace(/\..+/, '');
              console.log(`    ближайшее → ${C.dim(when)} (${next.j.owner}, ${next.j.type})`);
            }
          }
        } else {
          console.log(`  Бдений активно:   0`);
        }
      } catch { console.log(`  Бдений активно:   ${C.dim('n/a')}`); }

      console.log();
      break;
    }

    case 'spec-gate': {
      // Запуск исполняемой спецификации: gift spec-gate <file.spec.mjs> [--n 1000] [--json] [--seed 1]
      const specFile = sub;
      if (!specFile) {
        console.error('Использование: gift spec-gate <spec.mjs> [--n 1000] [--json] [--seed 1]');
        console.error('Примеры:');
        console.error('  gift spec-gate specs/executable/drone-autonomy.spec.mjs');
        console.error('  gift spec-gate specs/executable/drone-autonomy.spec.mjs --n 5000 --json');
        process.exit(2);
      }
      const specArgs = [...rest];
      // Парсим аргументы
      const nIdx = specArgs.indexOf('--n'); const N = nIdx >= 0 ? +specArgs[nIdx + 1] : 1000;
      const seedIdx = specArgs.indexOf('--seed'); const seed0 = seedIdx >= 0 ? +specArgs[seedIdx + 1] : 1;
      const asJson = specArgs.includes('--json');

      const { resolve: res2, isAbsolute: isAbs } = await import('node:path');
      const absSpec = isAbs(specFile) ? specFile : res2(ROOT, specFile);

      const { runSpec, formatReport } = await import(res2(ROOT, 'utils/spec-runner.mjs'));
      const r = await runSpec(absSpec, { N, seed0 });

      if (asJson) {
        console.log(JSON.stringify(r, null, 2));
      } else {
        console.log('\n' + formatReport(r) + '\n');
      }
      process.exit(r.passed ? 0 : 1);
    }

    default:
      console.error(`Неизвестная команда: ${cmd}`);
      help();
      process.exit(1);
  }
} catch (e) {
  console.error('Ошибка:', e.message);
  process.exit(1);
}
