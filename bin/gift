#!/usr/bin/env node
// Заглушаем TensorFlow info-логи (oneDNN/cpu_feature_guard) — они печатаются
// при первом импорте core/GiftMemory.js и засоряют CLI. На функциональность
// не влияют. Если нужны для отладки — снять переменную окружения.
process.env.TF_CPP_MIN_LOG_LEVEL = process.env.TF_CPP_MIN_LOG_LEVEL || '3';

/**
 * gift — единый CLI онтологии дара.
 *
 * Это НЕ обёртка вокруг Claude Code. Это точка входа в @unidel/gift:
 *   собор лиц, пустыни, эпиклеза, метанойя, dev-loop.
 *
 * Команды:
 *   gift sobor ask "вопрос"            — собор из 3 живых лиц (ask-sobor.mjs)
 *   gift sobor ask --static "вопрос"   — офлайн-режим (статические голоса)
 *
 *   gift swe --issue N                 — соборный SWE-агент (PLAN → IMPLEMENT → REVIEW)
 *   gift swe --task "…"                — на inline-задачу
 *   gift swe … --dry-run               — без реальных subagents
 *   gift swe … --no-commit             — остановиться перед commit
 *
 *   gift pustynya list                 — реальные пустыни (open gift-ready)
 *   gift pustynya resolve              — перихорезис-разрешение (dry-run)
 *   gift pustynya resolve --close      — закрыть троичные пустыни
 *
 *   gift epiclesis ask "вопрос" [--to Дионисий]  — через HumanOracleInbox
 *   gift epiclesis pending             — неотвеченные вопросы
 *   gift epiclesis answer <id> "…"     — ответить на вопрос (обычно делает бот)
 *
 *   gift matrix                        — снимок W-матрицы (через nous)
 *   gift matrix commune <from> <to>    — история нити
 *
 *   gift benchmark                     — CAT-9 (9/9 операций)
 *
 *   gift status                        — кратко: открытые пустыни, энергия, эпиклезы
 *
 * Философия:
 *   Этот CLI говорит языком онтологии (собор, пустыня, эпиклеза),
 *   а не языком инструмента (run, test, deploy).
 *   Под капотом — node.js + claude subagents. Сверху — церковный словарь.
 */

import { spawn } from 'node:child_process';
import { resolve, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';
import { existsSync, readFileSync } from 'node:fs';

const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '..');

// ── Autodetect GIFT_CLAUDE_ID по pwd ────────────────────────────────────
// Если уже задан в env — оставляем. Иначе определяем по тому, в каком
// проекте семьи gift находимся. Это нужно чтобы MCP-tools шины
// koinon_inbox/broadcast по умолчанию работали с правильным subscriberId.
if (!process.env.GIFT_CLAUDE_ID) {
  const PROJECT_ID_MAP = [
    ['/home/unidel/plm',          'plm-claude'],
    ['/home/unidel/fund',         'fund-claude'],
    ['/home/unidel/dronedoc2026', 'drone-claude'],
    ['/home/unidel/istok',        'istok-claude'],
    ['/home/unidel/gift',         'gift-claude'],
  ];
  const pwd = process.cwd();
  for (const [prefix, id] of PROJECT_ID_MAP) {
    if (pwd === prefix || pwd.startsWith(prefix + '/')) {
      process.env.GIFT_CLAUDE_ID = id;
      break;
    }
  }
}

// ── WSL/Windows proxy fix ───────────────────────────────────────────────
// В WSL2 process.env подхватывает Windows system proxy (172.23.x.x:10809),
// которого нет в NAT-режиме. Это ломает три вещи:
//   1. in-process fetch к localhost (NOUS) — TLS timeout
//   2. gh CLI к api.github.com — TLS timeout
//   3. claude CLI / curl в polza-runner — TLS timeout
//
// Решение:
//   - сохраняем proxy в PROXY_ORIG и удаляем из process.env (fixes 1)
//   - cleanEnv() для подпроцессов, которые НЕ должны использовать proxy (fixes 2)
//   - runRaw() восстанавливает PROXY_ORIG для agent-режима (egress через polza)
const PROXY_KEYS = ['HTTP_PROXY', 'HTTPS_PROXY', 'http_proxy', 'https_proxy', 'ALL_PROXY', 'all_proxy'];
const PROXY_ORIG = Object.fromEntries(
  PROXY_KEYS.map(k => [k, process.env[k]]).filter(([, v]) => v !== undefined)
);
for (const k of PROXY_KEYS) delete process.env[k];
process.env.NO_PROXY = process.env.NO_PROXY || 'api.github.com,github.com,localhost,127.0.0.1';
process.env.no_proxy = process.env.no_proxy || process.env.NO_PROXY;

function cleanEnv() {
  // Уже без proxy (мы их сняли при загрузке) — оставлено для совместимости.
  return { ...process.env };
}

// ── Раскраска ───────────────────────────────────────────────────────────
const C = {
  dim: s => `\x1b[2m${s}\x1b[0m`,
  b: s => `\x1b[1m${s}\x1b[0m`,
  gold: s => `\x1b[33m${s}\x1b[0m`,
  cyan: s => `\x1b[36m${s}\x1b[0m`,
  violet: s => `\x1b[35m${s}\x1b[0m`,
};

// ── Подпроцесс ──────────────────────────────────────────────────────────
function run(script, args = []) {
  return new Promise((res, rej) => {
    const child = spawn('node', [resolve(ROOT, script), ...args], {
      cwd: ROOT, stdio: 'inherit',
      env: { ...cleanEnv(), GIFT_CLI: 'gift' },
    });
    child.on('exit', code => code === 0 ? res() : rej(new Error(`exit ${code}`)));
    child.on('error', rej);
  });
}

// runRaw — для agent-команд: ВОССТАНАВЛИВАЕТ HTTP_PROXY/HTTPS_PROXY (из PROXY_ORIG),
// потому что Дионисию в WSL2 они нужны для egress через Windows proxy
// (curl в polza-runner иначе таймаутит на 120с).
function runRaw(script, args = []) {
  return new Promise((res, rej) => {
    const child = spawn('node', [resolve(ROOT, script), ...args], {
      cwd: ROOT, stdio: 'inherit',
      env: { ...process.env, ...PROXY_ORIG, GIFT_CLI: 'gift' },
    });
    child.on('exit', code => code === 0 ? res() : rej(new Error(`exit ${code}`)));
    child.on('error', rej);
  });
}

async function gh(cmd) {
  const { execSync } = await import('node:child_process');
  return execSync(cmd, {
    encoding: 'utf8', cwd: ROOT,
    env: { ...cleanEnv(), GITHUB_TOKEN: '' },
    stdio: ['ignore', 'pipe', 'ignore'],  // глушим stderr у gh — TLS-шум не нужен
  });
}

// ── Справка по секциям ──────────────────────────────────────────────────
