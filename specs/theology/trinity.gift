// trinity.gift — Троица: Перихоресис трёх Лиц
// Иоанн Дамаскин, Точное изложение I.8
// Три Лица, одна природа, взаимное проникновение без слияния

литургия Троица {
  цель: «Перихоресис — взаимное проникновение без слияния»

  // Три Лица Святой Троицы
  // Каждое Лицо — выше-природы по логосу (сверхбытие)
  // Различие — в ипостасных свойствах (призвание)

  лицо Отец {
    призвание: «Источник — нерождённый, безначальный»
    энергия: incalculable
    логос: выше-природы
  }

  лицо Сын {
    призвание: «Слово — рождённый прежде всех век»
    энергия: incalculable
    логос: выше-природы
  }

  лицо Дух {
    призвание: «Утешитель — исходящий от Отца»
    энергия: incalculable
    логос: выше-природы
  }

  // Перихоресис: все Три дарят друг другу одновременно
  // Не последовательно. Не иерархически. Параллельно.
  // Отец дарит Себя Сыну и Духу,
  // Сын дарит Себя Отцу и Духу,
  // Дух дарит Себя Отцу и Сыну.
  перихоресис (Отец, Сын, Дух) {
    // surplus здесь бесконечен: дарение не убавляет
    // кеносис без умаления — парадокс Троицы
    // Каждое Лицо полностью отдаёт Себя — и остаётся полным
  }

  // Внутритроичное дарение: Отец как Источник
  дар Рождение от Отец кому Сын {
    содержание: «Всё Моё — Твоё»
    цель: «Единосущие»
    помня: []  // Первый дар. Нет предшествующего.
  }

  дар Исхождение от Отец кому Дух {
    содержание: «Дух истины, иже от Отца исходит»
    цель: «Единосущие»
    помня: [Рождение]
  }

  // Сын и Дух отвечают — не обязательство, а любовь
  дар Послушание от Сын кому Отец {
    содержание: «Не Моя воля, но Твоя»
    цель: «Единосущие»
  }

  дар Свидетельство от Дух кому Сын {
    содержание: «Дух свидетельствует о Сыне»
    цель: «Единосущие»
  }

  // Ключевые свидетельства
  свидетельство невычислимое «Троица — не три Бога и не один безликий. Три Лица, одна природа.»
  свидетельство невычислимое «Бог есть любовь (1 Ин 4:8) — потому что Троица есть вечное дарение»
  свидетельство невычислимое «Перихоресис невычислим — surplus = infinity»

  export дар Творение от Отец через Сын
}
