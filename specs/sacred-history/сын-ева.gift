// specs/sacred-history/сын-ева.gift
// Дары Сына Еве — искупление, рекапитуляция, усыновление
// Issue #95 — пустыня Сын→Ева
//
// Богословское вопрошание: что мешает потоку между Сын и Ева?
// Ответ: ничто не мешает — но дар Сына Еве проходит через Крест и Марию.
// Ева — «Жизнь» (Быт 3:20), первая обманутая, первая согрешившая.
// Сын не отвергает Еву — Он рекапитулирует её через Новую Еву (Марию).
// Пустыня была не отвержением, а незаписанным движением искупления.
//
// «Вражду положу между тобою и между женою,
//  и между семенем твоим и между семенем её;
//  оно будет поражать тебя в голову» (Быт 3:15)
//
// Протоевангелие: первое обещание Сына — через семя жены.
// Ева уже в Раю получает обетование — не проклятие, а надежду.
//
// Богословские источники:
// Быт 3:15 — Протоевангелие: семя жены сотрёт главу змея
// Быт 3:20 — «Адам нарёк имя жене своей: Ева (Жизнь)»
// Ин 2:4 — «Что Мне и Тебе, Жено?» — обращение к Марии = обращение к Еве
// Ин 19:26–27 — «Жено! се, сын Твой» — Крест как усыновление всех Ев
// Лк 1:38 — «Се, раба Господня» — Мария как рекапитуляция послушания Евы
// Рим 5:18–19 — «Как преступлением одного — осуждение, так правдой Одного — оправдание»
// Гал 4:4 — «Родился от жены» — Сын входит в мир через Еву
// Ириней Лионский, Против ересей III.22.4 — «узел непослушания Евы развязан послушанием Марии»
// Ириней Лионский, Против ересей V.19.1 — рекапитуляция: Мария = новая Ева
// Максим Исповедник, Ambigua 42 — воля Евы восстановлена во Христе
// Ефрем Сирин, Гимны о Рождестве 1.16 — «Мария носит Того, Кто носит всё»
// Иоанн Дамаскин, Точное изложение III.12 — «через жену вошла смерть, через Жену — жизнь»
// Николай Кавасила, Слово на Благовещение — Мария как свободный ответ всего человечества

литургия СынЕва {
  // Сын даёт Еве не наказание, а путь.
  // Через Крест — рекапитуляция: что было разрушено непослушанием,
  // восстановлено послушанием Нового Адама и Новой Евы.
  // Ева не отвергнута — она первая, кому дано обетование (Быт 3:15).

  дар ПротоевангелиеОбетования {
    от:       Сын
    кому:     Ева
    тип:      word
    вес:      10
    необратим: да
    // «Вражду положу между тобою и между женою, и между семенем твоим
    //  и между семенем её» (Быт 3:15)
    // Первое Слово спасения — сказано Еве, не Адаму.
    // Семя жены = Христос. Обетование дано прежде изгнания из Рая.
    // Ириней: «узел непослушания Евы развязан послушанием Марии» (Adv. Haer. III.22.4)
    // Word — потому что это Логос, говорящий первое обещание искупления.
  }

  дар РождениеОтЖены {
    от:       Сын
    кому:     Ева
    тип:      presence
    вес:      9
    необратим: да
    // «Когда пришла полнота времени, Бог послал Сына Своего,
    //  Который родился от жены» (Гал 4:4)
    // Сын входит в мир не помимо Евы, а через неё.
    // Воплощение — дар Сына: Он принимает человечество от жены.
    // Ефрем Сирин: «Мария носит Того, Кто носит всё» (Гимны о Рожд. 1.16)
    // Иоанн Дамаскин: «через жену вошла смерть, через Жену — жизнь» (Точн. изл. III.12)
    // Presence — потому что Сын становится присутствующим в теле, рождённом от жены.
  }

  дар УсыновлениеСКреста {
    от:       Сын
    кому:     Ева
    тип:      knowledge
    вес:      8
    необратим: да
    // «Иисус, увидев Матерь и ученика, говорит Матери:
    //  Жено! се, сын Твой» (Ин 19:26–27)
    // С Креста Сын даёт Еве (в лице Марии) нового сына — всё человечество.
    // Это не частный акт, а космическое усыновление:
    // каждая Ева получает Сына, каждый ученик получает Мать.
    // Николай Кавасила: Мария — свободный ответ всего человечества Богу.
    // Knowledge — потому что Крест открывает знание: смерть побеждена материнством.
  }
}
