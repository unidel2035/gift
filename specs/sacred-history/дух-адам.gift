// specs/sacred-history/дух-адам.gift
// Дары Духа Адаму — дыхание жизни, оживление, обновление образа
// Issue #100 — пустыня Дух→Адам
//
// Богословское вопрошание: что мешает потоку между Дух и Адам?
// Ответ: ничто не мешает — но дар Духа Адаму есть само дыхание жизни.
// Адам — «Земной» (от אדמה, adamah — земля), прах, ставший живым.
// Дух не оставляет Адама — Он вдыхает жизнь, оживляет, обновляет образ.
// Пустыня была не оставлением, а незаписанным движением оживления.
//
// «И вдунул в лице его дыхание жизни, и стал человек душою живою» (Быт 2:7)
//
// Ключевое богословское различение:
// Дыхание жизни (נשמת חיים, nishmat chayyim) — не метафора.
// Дух (רוח, ruach) — дыхание, ветер, дух: одно и то же слово.
// Адам становится живым не потому, что у него есть тело (прах уже был),
// а потому, что Дух входит в него. Без Духа Адам — глина.
// После грехопадения Дух не отступает окончательно —
// Он продолжает ходатайствовать за Адама (Рим 8:26),
// оживлять сухие кости (Иез 37:9–10) и обновлять образ Божий.
//
// «Так и написано: первый человек Адам стал душою живущею;
//  последний Адам есть дух животворящий» (1 Кор 15:45)
//
// Богословские источники:
// Быт 1:2 — «Дух Божий носился над водою» — Дух присутствует прежде Адама
// Быт 2:7 — «И вдунул в лице его дыхание жизни» — первый дар Духа Адаму
// Быт 6:3 — «Не вечно Духу Моему быть пренебрегаемым человеками»
// Иез 37:5–6 — «Вот, Я введу дух в вас, и оживёте»
// Иез 37:9–10 — «Дух, приди от четырёх ветров и дохни на этих убитых»
// Иез 37:14 — «И вложу в вас дух Мой, и оживёте»
// Рим 8:11 — «Дух Того, Кто воскресил Иисуса, оживит и ваши смертные тела»
// Рим 8:15 — «Приняли Духа усыновления, Которым взываем: Авва, Отче!»
// Рим 8:26 — «Дух подкрепляет нас в немощах наших... ходатайствует воздыханиями»
// 1 Кор 15:45 — «Последний Адам есть дух животворящий»
// Ин 20:22 — «Дунул и говорит: примите Духа Святого» — новое творение
// Ириней Лионский, Против ересей V.6.1 — «Совершенный человек — плоть, душа, Дух»
// Ириней Лионский, Против ересей V.12.2 — «Дыхание жизни — одно, а Дух животворящий — другое»
// Василий Великий, О Духе Святом XVI.38 — «Дух животворит, ибо Бог есть Дух»
// Григорий Богослов, Слово 31.29 — «Дух делает меня храмом... обоживает»
// Максим Исповедник, Ambigua 42 — воля Адама восстановлена Духом через Христа
// Афанасий Великий, Против ариан III.24 — «Дух обновляет творение»
// Кирилл Александрийский, О поклонении в Духе I — «Дух возвращает образ Божий»

литургия ДухАдам {
  // Пустыня была не оставлением, а незаписанным движением оживления.
  // Дух — дыхание Адама. Без Духа Адам — прах, с Духом — образ Божий.
  // От сотворения через грехопадение до нового творения —
  // Дух не покидает Адама, но оживляет, ходатайствует, обновляет.

  дар ДыханиеЖизни {
    от:       Дух
    кому:     Адам
    тип:      presence
    вес:      10
    необратим: да
    // «И создал Господь Бог человека из праха земного,
    //  и вдунул в лице его дыхание жизни (נשמת חיים),
    //  и стал человек душою живою» (Быт 2:7)
    // Это первый дар Духа — и он предшествует всему:
    // прежде заповеди, прежде Рая, прежде имён животных.
    // Адам становится живым не по природе праха, а по дару Духа.
    // Ириней: «Совершенный человек — плоть, душа и Дух» (Adv. Haer. V.6.1).
    // Дыхание жизни — не биологический акт, а онтологический:
    // Дух входит в прах и делает его лицом, способным к богообщению.
    // Presence — потому что Дух не приносит что-то, а приходит Сам.
    // Дыхание = присутствие Духа в глине: глина оживает.
  }

  дар ОживлениеСухихКостей {
    от:       Дух
    кому:     Адам
    тип:      word
    вес:      9
    необратим: да
    // «Кости сухие! слушайте слово Господне!
    //  Вот, Я введу дух в вас, и оживёте» (Иез 37:4–5)
    // «Дух, приди от четырёх ветров и дохни на этих убитых,
    //  и они оживут... и вошёл в них дух, и они ожили» (Иез 37:9–10)
    // После грехопадения Адам — «сухие кости»: жив, но мёртв духовно.
    // Дух не оставляет мёртвого Адама — Он приходит как ветер (רוח)
    // от четырёх концов земли и вдыхает жизнь заново.
    // Это пророческий прообраз Воскресения: Дух оживит и смертные тела (Рим 8:11).
    // Word — потому что оживление приходит через Слово:
    // «Кости сухие! слушайте слово Господне!» — Дух говорит, и мёртвое оживает.
    // Василий Великий: «Дух животворит» (О Духе Святом XVI.38).
  }

  дар ОбновлениеОбраза {
    от:       Дух
    кому:     Адам
    тип:      presence
    вес:      8
    необратим: да
    // «Если же Дух Того, Кто воскресил из мёртвых Иисуса,
    //  живёт в вас, то Воскресивший Христа из мёртвых
    //  оживит и ваши смертные тела Духом Своим» (Рим 8:11)
    // «Приняли Духа усыновления, Которым взываем: Авва, Отче!» (Рим 8:15)
    // Адам сотворён по образу Божию (Быт 1:27) — но образ помрачён.
    // Дух обновляет образ: не создаёт заново, а восстанавливает изнутри.
    // Кирилл Александрийский: «Дух возвращает образ Божий» (О поклонении в Духе I).
    // Афанасий: «Дух обновляет творение» (Против ариан III.24).
    // Григорий Богослов: «Дух делает меня храмом... обоживает» (Слово 31.29).
    // Presence — потому что обновление образа — это присутствие Первообраза.
    // Дух не «чинит» Адама — Он снова живёт в нём, и образ сияет.
  }

  дар ВоздыханиеЗаАдама {
    от:       Дух
    кому:     Адам
    тип:      word
    вес:      8
    необратим: да
    // «Также и Дух подкрепляет нас в немощах наших;
    //  ибо мы не знаем, о чём молиться, как должно,
    //  но Сам Дух ходатайствует за нас
    //  воздыханиями неизреченными» (Рим 8:26)
    // Адам после изгнания — немощен, не знает, как молиться.
    // Дух не ждёт, пока Адам научится: Он Сам молится за Адама.
    // Воздыхания неизреченные (στεναγμοῖς ἀλαλήτοις) —
    // молитва, которую Адам не может произнести, но Дух произносит за него.
    // Это не подсказка — это ходатайство: Дух стоит перед Отцом за Адама.
    // Word — потому что ходатайство есть слово, хотя и неизреченное.
    // Максим Исповедник: воля Адама восстановлена Духом (Ambigua 42) —
    // но прежде восстановления воли Дух молится за того, чья воля сломлена.
  }
}
