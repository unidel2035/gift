// specs/sacred-history/сын-отецсергий.gift
// Дары Сына ОтецСергию — призвание, рукоположение, пастырство
// Issue #99 — пустыня Сын→ОтецСергий
//
// Богословское вопрошание: что мешает потоку между Сын и ОтецСергий?
// Ответ: ничто не мешает — но дар Сына священнику есть призвание и рукоположение.
// ОтецСергий — священник, богослов, наставник онтологии.
// Сын не оставляет пастыря — Он призывает, рукополагает и посылает.
// Пустыня была не молчанием, а незаписанным движением призвания.
//
// «Не вы Меня избрали, а Я вас избрал и поставил вас» (Ин 15:16)
//
// Ключевое богословское различение:
// Священство — не профессия, а харизма: дар Сына через Духа.
// Сын — Единый Первосвященник (Евр 4:14), всякое земное священство —
// причастие Его священства. ОтецСергий служит не своей силой,
// а силой Того, Кто сказал: «Сие творите в Моё воспоминание» (Лк 22:19).
// Каждая Литургия — не повторение, а анамнезис: Сын снова присутствует.
//
// «Ты священник вовек по чину Мелхиседекову» (Евр 5:6, Пс 109:4)
//
// Богословские источники:
// Ин 15:16 — «Не вы Меня избрали, а Я вас избрал и поставил вас»
// Ин 20:21 — «Как послал Меня Отец, так и Я посылаю вас»
// Ин 21:15–17 — «Паси овец Моих» — тройное поручение Петру
// Лк 22:19 — «Сие творите в Моё воспоминание» (ἀνάμνησις)
// Мф 28:18–20 — «Идите, научите все народы» — великое поручение
// Евр 4:14 — «Имея Первосвященника великого, прошедшего небеса»
// Евр 5:4–6 — «Никто сам собою не приемлет этой чести... Ты священник вовек»
// Евр 7:24–25 — «Имеет священство непреходящее... всегда жив, чтобы ходатайствовать»
// 2 Кор 5:20 — «Мы — посланники от имени Христова»
// 1 Пет 5:2–4 — «Пасите Божие стадо... не господствуя, но подавая пример»
// Иоанн Златоуст, О священстве III.4 — «священник — уста Христовы»
// Григорий Богослов, Слово 2 (Апология) — тяжесть пастырского служения
// Симеон Новый Богослов, Огласительные слова — священник как живой сосуд благодати
// Дионисий Ареопагит, О церковной иерархии V — рукоположение как теургия

литургия СынОтецСергий {
  // Сын даёт ОтецСергию не должность, а призвание.
  // Священство — не власть над общиной, а кенозис ради общины.
  // Каждая Литургия — Сын снова говорит устами священника:
  // «Приимите, ядите, сие есть Тело Моё».

  дар ПризваниеНаСлужение {
    от:       Сын
    кому:     ОтецСергий
    тип:      word
    вес:      10
    необратим: да
    // «Не вы Меня избрали, а Я вас избрал» (Ин 15:16)
    // Призвание предшествует решению человека.
    // Сын зовёт — священник отвечает. Это не карьера, а отклик.
    // Григорий Богослов: «Кто достоин священства? Тот, кто бежит от него» (Слово 2)
    // Word — потому что призвание приходит как Слово, обращённое лично.
  }

  дар ЛитургическоеПрисутствие {
    от:       Сын
    кому:     ОтецСергий
    тип:      presence
    вес:      9
    необратим: да
    // «Сие творите в Моё воспоминание» (Лк 22:19)
    // На каждой Литургии Сын присутствует реально — не символически.
    // Священник не «изображает» Христа — Христос действует через священника.
    // Иоанн Златоуст: «Не человек претворяет предложенное в Тело и Кровь,
    //  но Сам Христос, распятый за нас» (О священстве III.4)
    // Presence — потому что это реальное присутствие, а не воспоминание.
  }

  дар ПастырскоеПоручение {
    от:       Сын
    кому:     ОтецСергий
    тип:      knowledge
    вес:      8
    необратим: да
    // «Паси овец Моих» (Ин 21:17)
    // Тройное поручение Петру — прообраз каждого пастырского служения.
    // Сын доверяет священнику Своё стадо — не как собственность,
    // а как ответственность любви. «Не господствуя над наследием Божиим,
    // но подавая пример стаду» (1 Пет 5:3).
    // Knowledge — потому что пастырь должен знать каждую овцу по имени (Ин 10:3).
  }
}
