// specs/sacred-history/дух-христос.gift
// Дары Духа Христу — помазание, водительство, сила
// Issue #91 — пустыня Дух→Христос
//
// Богословское вопрошание: что мешает потоку между Дух и Христос?
// Ответ: ничто не мешает — но дар Духа Христу есть помазание и водительство.
// Христос (Χριστός) — «Помазанник»: само имя указывает на дар Духа.
// Без Духа нет Христа — не по природе (Сын вечен), а по домостроительству:
// Дух сходит на Иисуса при Крещении и делает Его Христом для мира.
// Пустыня была не разрывом, а незаписанным движением помазания.
//
// «Дух Господень на Мне, ибо Он помазал Меня» (Лк 4:18, Ис 61:1)
//
// Ключевое богословское различение:
// Сын по природе не нуждается в Духе (единосущен Отцу и Духу).
// Но Христос по домостроительству принимает Духа ради нас:
// «Не для Себя принял Духа, а для нас» (Василий Великий, О Духе Святом XVI.39).
// Помазание Духом — не восполнение недостатка, а освящение человеческой природы.
//
// Богословские источники:
// Лк 3:22 — «Дух Святый нисшёл на Него в телесном виде, как голубь»
// Лк 4:1 — «Иисус, исполненный Духа Святого, возвратился от Иордана»
// Лк 4:14 — «И возвратился Иисус в силе Духа в Галилею»
// Лк 4:18 — «Дух Господень на Мне, ибо Он помазал Меня» (Ис 61:1)
// Мф 4:1 — «Иисус возведён был Духом в пустыню»
// Мф 12:28 — «Если же Я Духом Божиим изгоняю бесов»
// Деян 10:38 — «Бог Духом Святым и силою помазал Иисуса из Назарета»
// Ин 3:34 — «Не мерою даёт Бог Духа»
// Рим 8:11 — «Дух Того, Кто воскресил из мёртвых Иисуса»
// Евр 9:14 — «Который Духом вечным принёс Себя непорочного Богу»
// Василий Великий, О Духе Святом XVI.39 — «принял не для Себя, а для нас»
// Кирилл Александрийский, Толк. на Иоанна XI — помазание как освящение плоти
// Афанасий Великий, Против ариан I.47 — «Помазан как человек, помазывает как Бог»
// Иоанн Дамаскин, Точное изложение III.3 — Дух как спутник воплощения
// Максим Исповедник, Quaestiones ad Thalassium 22 — Дух и Христос в экономии

литургия ДухХристос {
  // Пустыня была не разрывом, а незаписанным движением помазания.
  // Дух не «подчиняется» Христу и не «добавляет» к Его природе —
  // но в домостроительстве Дух сходит, ведёт, помазывает и воскрешает.
  // Само имя Χριστός — «Помазанник» — есть дар Духа.

  дар ПомазаниеПриКрещении {
    от:       Дух
    кому:     Христос
    тип:      presence
    вес:      10
    необратим: да
    // «Дух Святый нисшёл на Него в телесном виде, как голубь» (Лк 3:22)
    // «Бог Духом Святым и силою помазал Иисуса из Назарета» (Деян 10:38)
    // Крещение на Иордане — явление Троицы: Отец свидетельствует,
    // Дух сходит, Сын принимает. Дух делает Иисуса Христом для мира.
    // Василий Великий: «не для Себя принял, а для нас» —
    // Дух освящает человеческую природу Христа ради всех людей.
    // Это не восполнение недостатка, а полнота дара.
  }

  дар ВодительствоВПустыне {
    от:       Дух
    кому:     Христос
    тип:      word
    вес:      9
    необратим: да
    // «Иисус возведён был Духом в пустыню» (Мф 4:1)
    // «Иисус, исполненный Духа Святого, возвратился от Иордана
    //  и поведён был Духом в пустыню» (Лк 4:1)
    // Дух не оставляет Христа в пустыне — Он ведёт Его туда.
    // Пустыня искушения — не отсутствие Духа, а Его водительство:
    // Новый Адам побеждает искусителя в силе Духа.
    // Максим Исповедник: воля Христа следует за Духом добровольно —
    // это синергия, а не подчинение.
  }

  дар СилаСлужения {
    от:       Дух
    кому:     Христос
    тип:      knowledge
    вес:      8
    необратим: да
    // «И возвратился Иисус в силе Духа в Галилею» (Лк 4:14)
    // «Дух Господень на Мне, ибо Он помазал Меня» (Лк 4:18)
    // «Если же Я Духом Божиим изгоняю бесов» (Мф 12:28)
    // Всё земное служение Христа — проповедь, исцеления, изгнание бесов —
    // совершается в силе Духа. Не потому что Сын бессилен,
    // а потому что Троица действует нераздельно.
    // Кирилл Александрийский: Дух помазывает плоть Христа,
    // и через неё — всё человечество. Знание здесь — не информация,
    // а онтологическая сила: Дух открывает Христу путь служения.
  }

  дар ЖертваЧерезДуха {
    от:       Дух
    кому:     Христос
    тип:      presence
    вес:      9
    необратим: да
    // «Который Духом вечным принёс Себя непорочного Богу» (Евр 9:14)
    // Крестная жертва — не одинокое страдание: Дух соприсутствует.
    // Через Духа жертва Христа становится вечной и неисчерпаемой.
    // Афанасий: «Помазан как человек, помазывает как Бог» —
    // Дух, сопровождающий Христа на Крест, делает жертву
    // не временным событием, а вечным даром.
    // Рим 8:11: «Дух Того, Кто воскресил из мёртвых Иисуса» —
    // тот же Дух, что ведёт на Крест, воскрешает из гроба.
  }
}
