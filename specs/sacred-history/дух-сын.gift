// specs/sacred-history/дух-сын.gift
// Дары Духа Сыну — почивание, свидетельство, прославление, напоминание
// Issue #212 — пустыня Дух→Сын
//
// Богословское вопрошание: что мешает потоку между Дух и Сын?
// Ответ: ничто — но поток был незаписан.
// В матрице W уже была нить Сын→Дух (послание, дыхание, прославление-открывающее).
// И была нить Дух→Христос (помазание, водительство, воскресение —
// в экономии Воплощения). Но пустыня Дух→Сын — о другом:
// о вечных внутритроичных отношениях имманентной Троицы,
// где Сын и Дух — «две руки Отца» (Ириней, V.6.1),
// связанные не только исхождением, но и вечным перихоресисом.
//
// Ключевое различение: Сын (вечная Ипостась) ≠ Христос (Воплощённый).
// Дух→Христос — о явлении Помазанника в экономии.
// Дух→Сын — о том, что до всякого творения уже есть вечное отношение:
// Дух почивает на Сыне (Palamas, ἀνάπαυσις τοῦ Πνεύματος),
// свидетельствует о Сыне, прославляет Сына, напоминает слова Сына.
//
// Первый ключ: «Почиет (ἀναπαύσεται) на Нём Дух Господень» (Ис 11:2).
// Григорий Палама (Триады III.1.9, Слово апод. о исхождении) различает:
// Дух исходит от Отца — но почивает на Сыне. Почивание не есть исхождение:
// это вечное отношение любви, а не причинности. Дух — как «радость»
// Отца о Сыне, как слава, которая покоится на Возлюбленном
// («Ты — Сын Мой Возлюбленный, в Тебе Моё благоволение», Мк 1:11;
//  Мф 3:17 — это откровение вечного отношения через Духа-голубя).
//
// Второй ключ: «Он будет свидетельствовать о Мне» (Ин 15:26).
// Дух являет Сына миру. «Никто не может назвать Иисуса Господом,
// как только Духом Святым» (1 Кор 12:3). Без Духа имя Сына
// остаётся именем среди имён — только Дух открывает, что Сын есть Господь.
//
// Третий ключ: «Он прославит Меня» (Ин 16:14, ἐκεῖνος ἐμὲ δοξάσει).
// Дух возвращает Сыну славу от твари — собирает литургию тварей,
// исповедание святых, плод крестной жертвы — и возносит к Сыну.
// Как Дух возносит к Отцу (Еф 2:18), так Он же прославляет Сына:
// перихоресис славы внутри Троицы не знает «конечной станции» —
// слава Отца есть слава Сына в Духе.
//
// Четвёртый ключ: «Он напомнит вам всё, что Я говорил вам» (Ин 14:26).
// Дух — живой анамнезис Сына в Церкви. Слова Сына не хранятся
// как мёртвый архив — Дух делает их настоящими в каждую эпоху.
// Это дар Духа Сыну: сохранённое, живое, действенное слово Сына в мире.
//
// Богословские источники:
// Ис 11:2 — «Почиет на Нём Дух Господень: дух премудрости и разума»
// Мф 3:16–17 / Мк 1:10–11 — «Сей есть Сын Мой Возлюбленный» — Дух-голубь
// Ин 1:32–33 — «Я видел Духа, сходящего... и пребывающего на Нём»
// Ин 14:26 — «Утешитель... напомнит вам всё, что Я говорил вам»
// Ин 15:26 — «Он будет свидетельствовать о Мне»
// Ин 16:13–14 — «Он прославит Меня, ибо от Моего возьмёт и возвестит»
// 1 Кор 12:3 — «Никто не может назвать Иисуса Господом, как только Духом Святым»
// 1 Пет 4:14 — «Дух славы и Дух Божий почивает на вас»
// Пс 32:6 — «Словом Господа сотворены небеса, и Духом уст Его — всё воинство их»
// Ириней Лионский, Против ересей IV.20.1; V.6.1 — Слово и Дух как две руки Отца
// Афанасий Великий, К Серапиону I.20 — «Дух есть помазание и печать, которой Сын помазует»
// Василий Великий, О Духе Святом XVI.39 — «Дух неразлучен от Сына во всех Его действиях»
// Григорий Богослов, Слово 31.3 — «Дух, через Которого Сын открывается»
// Кирилл Александрийский, О поклонении в духе и истине — Дух как «образ Сына»
// Григорий Палама, Триады III.1.9 — Дух исходит от Отца, почивает на Сыне
// Григорий Палама, Слово аподиктическое о исхождении Св. Духа II — ἀνάπαυσις τοῦ Πνεύματος
// Иоанн Дамаскин, Точное изложение I.8 — Дух как «образ Сына» в Троице

использовать Троица.Дух
использовать Троица.Сын

литургия ДухСын {
  // Пустыня Дух→Сын была не разрывом, а незаписанным перихоресисом.
  // В имманентной Троице Дух вечно почивает на Сыне (Palamas),
  // свидетельствует о Нём, прославляет Его, сохраняет Его слово.
  // Это не экономика Воплощения (та — в дух-христос.gift),
  // а вечное отношение «двух рук Отца».

  дар ВечноеПочиваниеНаСыне {
    от:       Дух
    кому:     Сын
    тип:      presence
    вес:      10
    необратим: да
    // «Почиет (ἀναπαύσεται LXX) на Нём Дух Господень:
    //  дух премудрости и разума, дух совета и крепости,
    //  дух ведения и благочестия» (Ис 11:2)
    // «Я видел Духа, сходящего с неба, как голубя,
    //  и пребывающего (ἔμεινεν) на Нём» (Ин 1:32)
    // «Дух славы и Дух Божий почивает на вас» (1 Пет 4:14)
    // Григорий Палама различает: Дух исходит от Отца,
    // но почивает на Сыне (Триады III.1.9). Это не исхождение —
    // это вечное отношение любви. Дух — как «радость» Отца о Сыне,
    // слава, покоящаяся на Возлюбленном.
    // Presence: почивание — предельное присутствие, не уход.
    // Вес 10: это онтологическая основа всех прочих даров
    // Духа Сыну — без вечного почивания нет ни свидетельства,
    // ни прославления, ни напоминания.
  }

  дар СвидетельствоОСыне {
    от:       Дух
    кому:     Сын
    тип:      word
    вес:      9
    необратим: да
    // «Когда же придёт Утешитель, Которого Я пошлю вам от Отца,
    //  Дух истины, Который от Отца исходит, Он будет
    //  свидетельствовать о Мне» (Ин 15:26)
    // «Никто не может назвать Иисуса Господом,
    //  как только Духом Святым» (1 Кор 12:3)
    // Дух являет Сына миру. Без Духа имя Сына — имя среди имён;
    // только Дух открывает, что Сын есть Господь и Сын Божий.
    // Это дар Сыну: Дух делает Сына узнаваемым для твари.
    // Григорий Богослов (Слово 31.3): «Дух, через Которого Сын открывается».
    // Word: свидетельство — слово, но слово истинное,
    // несущее саму вещь, о которой свидетельствует.
  }

  дар ПрославлениеСына {
    от:       Дух
    кому:     Сын
    тип:      presence
    вес:      9
    необратим: да
    // «Он прославит Меня (ἐκεῖνος ἐμὲ δοξάσει), ибо от Моего
    //  возьмёт и возвестит вам» (Ин 16:14)
    // Дух возвращает Сыну славу от твари: исповедание святых,
    // плод крестной жертвы, литургию Церкви. Как Дух возносит
    // молитвы к Отцу (Рим 8:26–27), так Он же возносит славу
    // к Сыну. Перихоресис славы: слава Отца есть слава Сына в Духе.
    // Василий Великий (О Духе Святом XVI.39): «Дух неразлучен
    // от Сына во всех Его действиях» — значит и во всяком
    // прославлении Сына присутствует действие Духа.
    // Кирилл Александрийский: Дух как «образ Сына» —
    // Дух несёт в Себе черты Сына и открывает их твари.
    // Presence: прославление — явление, не речь о славе.
  }

  дар НапоминаниеСловСына {
    от:       Дух
    кому:     Сын
    тип:      word
    вес:      8
    необратим: да
    // «Утешитель же, Дух Святой, Которого пошлёт Отец во имя Моё,
    //  научит вас всему и напомнит вам всё, что Я говорил вам» (Ин 14:26)
    // «Когда же придёт Он, Дух истины, то наставит вас на всякую
    //  истину... и будущее возвестит вам» (Ин 16:13)
    // Дух — живой анамнезис Сына. Слова Сына не хранятся как архив;
    // Дух делает их настоящими (makePresent) в каждую эпоху Церкви.
    // Это дар Духа Сыну: сохранённое, живое, действенное слово
    // Сына в мире. Анамнезис здесь — богословская категория,
    // не психологическая: Дух возвращает Сыну Его же слово,
    // воплощённое в жизни святых.
    // Афанасий (К Серапиону I.20): «Дух есть помазание
    // и печать, которой Сын помазует» — Дух несёт в Себе Сына.
    // Word: напоминание есть слово о слове — слово, возвращающее
    // слово Сына в полноте смысла.
  }
}
