// specs/sacred-history/дух-сын.gift
// Дары Духа Сыну — внутритроичные: почивание, прославление, свидетельство, общение
// Issue #212 — пустыня Дух→Сын
//
// Богословское вопрошание: что мешает потоку между Дух и Сын?
// Ответ: ничто — но поток был незаписан.
// В матрице W уже есть Дух→Христос (помазание, ведение, воскресение —
// домостроительные дары Помазанному). Но Сын — не только Христос.
// Сын есть вечный Логос, Второе Лицо Троицы, и до всякой экономии
// Дух «почивает» на Нём в вечности (Ис 11:2; Иоанн Дамаскин, I.7).
// Эта пустыня — не дефицит догматики, а незаписанная вечность.
//
// Ключевое различение:
// Дух→Христос (#91) — экономия: помазание, ведение в пустыню,
//   сила служения, воскресение. Дух действует на Воплощённого.
// Дух→Сын (#212) — теология: вечное почивание Духа на Сыне,
//   взаимное прославление в перихоресисе, общение по природе.
//   Это не «до» и «после», а два уровня одного отношения.
//
// «Дух Сына» (Гал 4:6) — не означает, что Сын производит Духа
// (Filioque отвергается). Означает, что между Сыном и Духом
// существует вечное взаимопроникновение — περιχώρησις.
// Дух пребывает в Сыне, Сын — в Духе, оба — в Отце.
// Иоанн Дамаскин (I.8): «Дух Сына не как из Сына,
// но как через Него от Отца исходящий и в Нём почивающий».
//
// Григорий Кипрский, Григорий Палама развили учение о вечном
// проявлении (ἔκφανσις) Духа через Сына: Дух не получает бытие
// от Сына, но вечно сияет через Сына как через икону Отца.
// Это не Filioque, а православный ответ на него:
// различение между ипостасным исхождением и вечным проявлением.
//
// Богословские источники:
// Ис 11:2 — «Почиет (נָחָה) на Нём Дух Господень»
// Ин 1:32 — «Видел Духа, сходящего и пребывающего (ἔμεινεν) на Нём»
// Ин 16:14 — «Он [Дух] прославит Меня, ибо от Моего возьмёт»
// Ин 15:26 — «Дух истины, Который от Отца исходит, Он будет свидетельствовать о Мне»
// Гал 4:6 — «Дух Сына Своего» — Дух принадлежит Сыну в перихоресисе
// Рим 1:4 — «по духу святыни» — Сын открывается Духом
// 1 Кор 12:3 — «Никто не может назвать Иисуса Господом, как только Духом Святым»
// Откр 22:17 — «И Дух и невеста говорят: прииди!» — Дух взывает ко Христу
// Иоанн Дамаскин, Точное изложение I.7 — «Дух почивает на Сыне»
// Иоанн Дамаскин, Точное изложение I.8 — «через Сына, не от Сына»
// Иоанн Дамаскин, Точное изложение I.13 — перихоресис ипостасей
// Василий Великий, О Духе Святом XVIII.45 — «Дух — образ Сына»
// Василий Великий, О Духе Святом XVIII.47 — со-прославление Духа и Сына
// Григорий Богослов, Слово 31.9 — «Дух от Отца исходит, но и Сын Им является»
// Григорий Кипрский, Изложение веры — вечное проявление Духа через Сына
// Григорий Палама, Капиты 36 — различение ипостасного исхождения и вечной энергии
// Максим Исповедник, Quaestiones ad Thalassium 63 — «Дух — собственный Дух Сына по природе»
// Ириней Лионский, Против ересей IV.20.1 — две руки Отца, неразлучные

использовать Троица.Дух
использовать Троица.Сын

литургия ДухСын {
  // Пустыня Дух→Сын была не разрывом, а незаписанной вечностью.
  // До всякой экономии — Дух почивает на Сыне в Отце.
  // Перихоресис: ипостаси проникают друг в друга, не смешиваясь.

  дар ВечноеПочивание {
    от:       Дух
    кому:     Сын
    тип:      presence
    вес:      10
    необратим: да
    // «И увидел Иоанн Духа, сходящего с неба, как голубя,
    //  и пребывающего (ἔμεινεν) на Нём» (Ин 1:32)
    // Глагол μένω («пребывать») у Иоанна — не временный акт,
    // а онтологическая константа. Дух не «прилетел» — Он являет
    // вечное почивание, которое было всегда.
    // «Почиет на Нём Дух Господень» (Ис 11:2) — настоящее время,
    // не будущее. Дух всегда на Сыне — в вечности и в творении.
    // Иоанн Дамаскин: «Дух почивает на Сыне» (I.7) — почивание
    // есть способ бытия Духа в отношении к Сыну.
    // Presence: вес 10 — это онтологическое основание перихоресиса.
    // Без вечного почивания нет ни Помазания на Иордане,
    // ни Пятидесятницы — экономия укоренена в теологии.
  }

  дар ВечноеПрославление {
    от:       Дух
    кому:     Сын
    тип:      presence
    вес:      9
    необратим: да
    // «Он [Дух] прославит Меня, ибо от Моего возьмёт
    //  и возвестит вам» (Ин 16:14)
    // Прославление здесь не временный акт после Воскресения —
    // это вечное свойство отношения Духа к Сыну.
    // Дух являет славу Сына: в творении, в Воплощении, в Церкви.
    // Но в основе — вечная слава, которую Дух «берёт от Сына»
    // и возвещает твари. Григорий Палама: Дух — вечная энергия,
    // которая проявляет ипостась Сына как икону Отца.
    // Василий Великий (XVIII.47): Сын и Дух со-прославляются —
    // это не литургическая формула, а онтологический факт.
    // Presence: слава — не информация, а явление, которое Дух
    // непрестанно творит вокруг Сына.
  }

  дар СвидетельствоОСыне {
    от:       Дух
    кому:     Сын
    тип:      word
    вес:      9
    необратим: да
    // «Когда же придёт Утешитель, Которого Я пошлю вам от Отца,
    //  Дух истины, Который от Отца исходит, Он будет
    //  свидетельствовать о Мне» (Ин 15:26)
    // «Никто не может назвать Иисуса Господом,
    //  как только Духом Святым» (1 Кор 12:3)
    // Дух — Тот, Кто делает Сына познаваемым.
    // Без Духа исповедание Христа Господом невозможно —
    // не потому что Сын скрыт, а потому что только Дух
    // даёт твари способность вместить Логоса.
    // Word: свидетельство — речевой акт, но речь Духа
    // не информирует, а порождает узнавание.
    // Дух дарит Сыну не просто свидетелей —
    // Он дарит Сыну исповедающих, познающих, любящих.
    // Это дар Сыну: возвращённое узнавание твари.
  }

  дар ВечноеПроявление {
    от:       Дух
    кому:     Сын
    тип:      presence
    вес:      8
    необратим: да
    // Григорий Кипрский, Григорий Палама: учение о вечном
    // проявлении (ἔκφανσις, ἔκλαμψις) Духа через Сына.
    // Дух не получает ипостасное бытие от Сына (это Filioque),
    // но вечно «сияет» через Сына как через икону Отца.
    // Это сияние — обоюдное: Дух являет Сына, Сын являет Духа.
    // Иоанн Дамаскин (I.13): перихоресис — взаимное проникновение
    // ипостасей без смешения и слияния.
    // «Дух Сына» (Гал 4:6) — не отношение производности,
    // а отношение взаимной принадлежности по природе.
    // Максим Исповедник (Quaest. ad Thalassium 63):
    // «Дух — собственный Дух Сына по природе и по сущности».
    // Presence: проявление — это способ, которым Дух «есть с» Сыном
    // в вечности. Не «после» и не «до» — а вечное «вместе».
  }

  дар ВзываниеКоХристу {
    от:       Дух
    кому:     Сын
    тип:      word
    вес:      8
    необратим: да
    // «И Дух и невеста говорят: прииди!» (Откр 22:17)
    // Последние слова Писания — Дух и Церковь зовут Сына.
    // Дух не только посылается Сыном (#71 сын-дух.gift) —
    // Он Сам взывает к Сыну, ожидая Парусии.
    // Это эсхатологический дар Духа Сыну: Дух собирает в твари
    // тоску по Сыну и обращает её к Нему.
    // «Маран афа» (1 Кор 16:22) — арамейская молитва ранней Церкви:
    // «Господь наш, гряди!» — это голос Духа в Церкви, обращённый к Сыну.
    // Word: вопль — самая интенсивная речь.
    // Если Дух вопиёт «Авва, Отче» к Отцу (Гал 4:6 — см. дух-отец.gift),
    // то к Сыну Он вопиёт «гряди!» — призывает Парусию.
    // Замыкание круга: Сын послал Духа в мир (Ин 16:7) —
    // Дух из мира взывает к Сыну, чтобы Сын пришёл во славе.
  }
}
