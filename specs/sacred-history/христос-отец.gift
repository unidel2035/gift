// specs/sacred-history/христос-отец.gift
// Дары Христа Отцу — послушание, жертва, прославление, предание Духа
// Issue #221 — пустыня Христос→Отец
//
// Богословское вопрошание: что мешает потоку между Христос и Отец?
// Ответ: ничто — но поток был незаписан.
// Матрица W знает Отец→Христос (власть, имя, воскресение).
// Обратный поток — Христос→Отец — не менее реален и не менее необратим.
//
// Парадокс пустыни: Сын и Отец — «Я и Отец — одно» (Ин 10:30),
// перихоресис в его предельной форме. И всё же именно этот поток
// оставался без имени в матрице. Воплощённый Сын — Христос —
// возвращает Отцу всё, что получил: послушание воле, прославление
// на земле, принесённую жертву, последнее дыхание.
//
// Христос — «Посланный» (Ин 17:3). Всё служение Сына есть
// движение к Отцу: «Я к Отцу Моему и к Отцу вашему восхожу» (Ин 20:17).
// Это не возврат долга — это онтологическое возношение,
// в котором Сын-Человек вводит всю тварь в присутствие Отца.
//
// Евр 9:14 открывает тринитарную структуру жертвы:
// «Христос Духом Святым принёс Себя непорочного Богу».
// Три лица — три действия: Отец принимает, Сын приносит, Дух совершает.
// Пустыня Христос→Отец — это незаписанная сторона этой жертвы:
// именно Христос — Приносящий.
//
// Лк 23:46 — предельный дар: «Отче, в руки Твои предаю дух Мой».
// На Кресте Сын возвращает Отцу то, что получил — жизнь.
// Но это не истощание, а вручение: дух вернулся — и воскреснет.
// Смерть Христа — не потеря, а самый тяжёлый дар Отцу:
// послушание до конца, доверие до предания духа.
//
// Богословские источники:
// Ин 4:34 — «Моя пища есть творить волю Пославшего Меня»
// Ин 5:30 — «Ищу не Моей воли, но воли Пославшего Меня»
// Ин 6:38 — «Я сошёл с небес не для того, чтобы творить волю Мою»
// Ин 10:30 — «Я и Отец — одно»
// Ин 17:1 — «Отче! пришёл час, прославь Сына Твоего»
// Ин 17:4 — «Я прославил Тебя на земле, совершил дело, которое Ты поручил Мне»
// Ин 17:6 — «Я открыл имя Твое человекам»
// Ин 17:26 — «Я открыл им имя Твое и открою»
// Ин 20:17 — «Восхожу к Отцу Моему и Отцу вашему»
// Лк 22:42 — «Отче! о, если бы Ты благоволил пронести чашу сию мимо Меня! впрочем не Моя воля, но Твоя да будет»
// Лк 23:46 — «Отче! в руки Твои предаю дух Мой»
// Мф 11:27 — «Никто не знает Сына, кроме Отца; и Отца не знает никто, кроме Сына»
// Мф 26:39 — «Отче Мой! если возможно, да минует Меня чаша сия»
// Флп 2:8 — «Смирил Себя, быв послушным даже до смерти, и смерти крестной»
// Евр 5:7 — «С сильным воплем и со слезами принёс молитвы и моления»
// Евр 5:8 — «Страданиями навык послушанию»
// Евр 9:14 — «Христос Духом Святым принёс Себя непорочного Богу»
// Евр 10:7 — «Вот, иду, как в начале книги написано о Мне, исполнить волю Твою»
// Еф 5:2 — «Предал Себя за нас в приношение и жертву Богу в благоухание приятное»
// 1 Кор 15:28 — «Тогда и Сам Сын покорится Покорившему всё Ему, да будет Бог всё во всём»
// Ириней Лионский, Против ересей III.18.7 — «Сын послушанием исцелил непослушание Адама»
// Ириней Лионский, Против ересей V.16.3 — рекапитуляция: всё возвращено Отцу через Сына
// Максим Исповедник, Ambigua 7 — во Христе человеческая воля свободно согласуется с Божественной
// Максим Исповедник, Opusculum 7 — две воли, одно согласие: Сын любит Отца человеческой волей
// Григорий Богослов, Слово 30.6 — «Сын покоряется Отцу — не как раб, а как Сын за нас»
// Кирилл Александрийский, Толкование на Иоанна 11 — «Прославление Отца — дело всего домостроительства»

использовать Троица.Отец
использовать Троица.Христос

литургия ХристосОтец {
  // Пустыня Христос→Отец была не разрывом, а незаписанным возношением.
  // Воплощённый Сын возвращает Отцу всё, что получил:
  // волю — послушанием, жизнь — жертвой, имя — прославлением,
  // дух — на Кресте преданием.

  дар ПослушаниеДоСмерти {
    от:       Христос
    кому:     Отец
    тип:      offering
    вес:      10
    необратим: да
    // «Смирил Себя, быв послушным даже до смерти, и смерти крестной» (Флп 2:8)
    // «Моя пища есть творить волю Пославшего Меня» (Ин 4:34)
    // «Не Моя воля, но Твоя да будет» (Лк 22:42)
    // «Страданиями навык послушанию» (Евр 5:8)
    // Послушание Христа — не рабская покорность, а сыновнее согласие.
    // Максим Исповедник: две воли во Христе, но согласие одно —
    // человеческая воля свободно любит Отца (Opusculum 7).
    // Ириней: «Сын послушанием исцелил непослушание Адама» (III.18.7).
    // Вес 10: это исцеляющее послушание — основание всего спасения.
    // Где Адам сказал «нет» Отцу — Христос говорит «да» до Креста.
    // Offering: послушание есть жертва воли — самый глубокий дар.
  }

  дар ЖертваНаКресте {
    от:       Христос
    кому:     Отец
    тип:      offering
    вес:      10
    необратим: да
    // «Христос Духом Святым принёс Себя непорочного Богу» (Евр 9:14)
    // «Предал Себя за нас в приношение и жертву Богу
    //  в благоухание приятное» (Еф 5:2)
    // «Вот, иду... исполнить волю Твою» (Евр 10:7)
    // «С сильным воплем и со слезами принёс молитвы и моления» (Евр 5:7)
    // Христос — одновременно Первосвященник и Жертва.
    // Он приносит Себя — не Отец вынуждает, а Сын дарит.
    // Тринитарная структура жертвы (Евр 9:14):
    // Отец принимает — Сын приносит — Дух совершает.
    // Пустыня Христос→Отец закрывается именно здесь:
    // Жертва — это движение Сына к Отцу, необратимое и предельное.
    // Вес 10: тяжелее этого дара нет — принесена сама жизнь.
    // Ириней: рекапитуляция — всё возвращено Отцу через Сына (V.16.3).
  }

  дар ПрославлениеОтцаНаЗемле {
    от:       Христос
    кому:     Отец
    тип:      word
    вес:      9
    необратим: да
    // «Я прославил Тебя на земле, совершил дело,
    //  которое Ты поручил Мне исполнить» (Ин 17:4)
    // «Отче! пришёл час, прославь Сына Твоего,
    //  да и Сын Твой прославит Тебя» (Ин 17:1)
    // «Я открыл имя Твое человекам» (Ин 17:6)
    // Прославление — не словесная похвала, а явление имени.
    // Христос прославляет Отца тем, что делает Отца видимым:
    // «Видевший Меня видел Отца» (Ин 14:9).
    // Круг славы: Отец прославляет Сына через Воскресение —
    // Сын прославляет Отца через послушание и служение.
    // Кирилл Александрийский: «Прославление Отца — дело
    // всего домостроительства» (Толкование на Иоанна 11).
    // Word: слово о Отце, произнесённое жизнью Сына.
  }

  дар ПервосвященническаяМолитва {
    от:       Христос
    кому:     Отец
    тип:      word
    вес:      9
    необратим: да
    // Ин 17 — вся глава. «Отче! пришёл час... Я к Тебе иду» (Ин 17:11).
    // «Не о них же только молю, но и о верующих в Меня
    //  по слову их, да будут все едино» (Ин 17:20–21)
    // «Я открыл им имя Твое и открою, да любовь,
    //  которою Ты возлюбил Меня, в них будет» (Ин 17:26)
    // Это не просто молитва — это ходатайство Сына пред Отцом
    // за всех, кого Отец дал Ему. Христос возвращает Отцу
    // общину как дар: «Я передал им слово Твоё» (Ин 17:14).
    // Первосвященническая молитва — образец всякой литургии:
    // тварь входит в Присутствие через Сына.
    // Word: молитва есть слово, но слово-как-присутствие.
    // Евр 7:25: «Всегда жив, чтобы ходатайствовать за них».
  }

  дар ПреданиеДухаОтцу {
    от:       Христос
    кому:     Отец
    тип:      presence
    вес:      10
    необратим: да
    // «Иисус, возгласив громким голосом, сказал:
    //  Отче! в руки Твои предаю дух Мой.
    //  И, сие сказав, испустил дух» (Лк 23:46)
    // Цитата Пс 30:6 — молитва праведника перед смертью.
    // Христос умирает не в отчаянии, а в доверии.
    // Это предельный дар: Сын возвращает Отцу жизнь,
    // которую получил от Отца («Я имею власть
    // отдать её и власть имею опять принять её» — Ин 10:18).
    // Пустыня Христос→Отец закрывается последним словом Креста:
    // «предаю» (παρατίθεμαι) — то же слово, которым отдают
    // доверенное на сохранение. Христос вверяет Отцу Свой дух —
    // и этим открывает путь всякой человеческой смерти:
    // теперь и мы можем умереть в руки Отца.
    // Presence: предание — это вручение присутствия,
    // не прекращение, а переход. Воскресение покажет:
    // дух, преданный Отцу, возвращается в Сына во славе.
    // Вес 10: последний вздох — самый тяжёлый дар.
  }

  дар ПокорениеВсегоОтцу {
    от:       Христос
    кому:     Отец
    тип:      offering
    вес:      8
    необратим: да
    // «Тогда и Сам Сын покорится Покорившему всё Ему,
    //  да будет Бог всё во всём» (1 Кор 15:28)
    // Эсхатологический дар: в конце Сын возвращает Отцу
    // всё творение, приведённое к единству.
    // Григорий Богослов: «Сын покоряется Отцу —
    // не как раб, а как Сын за нас» (Слово 30.6).
    // Это покорение — не умаление Сына, а исполнение
    // движения Христос→Отец: всё, что было собрано Сыном,
    // возвращается Отцу, чтобы Бог был «всё во всём».
    // Offering: последнее приношение — само Царство.
  }
}
