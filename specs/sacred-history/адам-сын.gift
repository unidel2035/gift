// specs/sacred-history/адам-сын.gift
// Дары Адама Сыну — плоть, имя, ожидание, родословие
// Issue #230 — пустыня Адам→Сын
//
// Богословское вопрошание: что мешает потоку между Адам и Сын?
// Ответ: ничто — но поток был незаписан.
// Адам — אדם (земля, красная глина), первый человек (Быт 2:7).
// Сын — Новый Адам (1 Кор 15:45), принявший природу первого.
// В матрице W записана только нисходящая связь Сын→Адам
// (воплощение, искупление, сошествие во ад).
// Обратный поток — Адам→Сын — не менее реален и не менее необратим:
// Адам отдаёт Сыну то, из чего возможно само Воплощение.
//
// Парадокс пустыни: Сын нисходит к Адаму, но чтобы нисхождение было
// возможным, Адам должен прежде дать Сыну место в Себе —
// плоть, имя, ожидание, родословие. Без Адама нет «Сына Человеческого».
// Нет Адама — нет того, что Сын воспринимает в Воплощении.
//
// Это не пелагианство: Адам не заслуживает Воплощения.
// Но домостроительство совершается синергийно: Сын нисходит,
// и Адам (весь род его) отдаёт Сыну природу, в которую Он облекается.
// «Он воспринимает не ангелов, но семя Авраамово» (Евр 2:16) —
// а семя Авраамово восходит к Адаму (Лк 3:38).
//
// Ириней: рекапитуляция (ἀνακεφαλαίωσις) — Сын проходит заново
// весь путь Адама. Но проходит Он именно адамов путь —
// то есть Адам «даёт» Сыну путь для прохождения.
// Путь Адама становится материалом исцеления.
//
// Богословские источники:
// Быт 2:7 — «И создал Господь Бог человека из праха земного»
// Быт 3:15 — «Семя жены сотрёт главу змея» — Адам получает обетование, которое ждёт
// Быт 3:20 — «Адам нарёк имя жене: Ева (Жизнь)» — Адам даёт имя матери жизни
// Лк 3:38 — «…сын Еносов, Сифов, Адамов, Божий» — родословие восходит к Адаму
// Лк 19:10 — «Сын Человеческий пришёл взыскать и спасти погибшее»
// Ин 1:14 — «И Слово стало плотью»
// Рим 5:14 — «Адам есть образ будущего» — τύπος τοῦ μέλλοντος
// Рим 8:19–22 — «Тварь с надеждою ожидает откровения сынов Божиих»
// Рим 8:26 — «Дух ходатайствует воздыханиями неизреченными»
// 1 Кор 15:22 — «Как в Адаме все умирают, так во Христе все оживут»
// 1 Кор 15:45 — «Первый человек Адам стал душою живою; последний Адам — дух животворящий»
// 1 Кор 15:47 — «Первый человек из земли перстный; второй — Господь с неба»
// Евр 2:14 — «Как дети причастны плоти и крови, то и Он также воспринял оные»
// Евр 2:16 — «Не ангелов восприемлет, но семя Авраамово»
// Евр 4:15 — «Искушён во всём, кроме греха» — Сын проходит адамов путь
// Дан 7:13 — «Как бы Сын Человеческий» — ветхозаветный прообраз имени
// Ириней Лионский, Против ересей III.18.1 — «Он прошёл через все возрасты, освящая каждый»
// Ириней Лионский, Против ересей III.22.3 — Сын восстанавливает Адама в Себе
// Ириней Лионский, Против ересей V.14.1 — «Он воспринял ту же плоть, которая была создана вначале»
// Афанасий Великий, О воплощении 4 — «Слово облеклось в тело, подобное нашему»
// Григорий Богослов, Послание 101 — «Что не воспринято, то не исцелено»
// Максим Исповедник, Ambigua 42 — Адам как τύπος, раскрываемый во Христе
// Иоанн Дамаскин, Точное изложение III.1 — «Слово восприняло всю природу Адама»
// Николай Кавасила, О жизни во Христе VI — Адам был создан для Христа, не наоборот
// Пасхальная икона (Анастасис) — Адам протягивает руку Сыну: принятие ответное
// Седален Великой Субботы — «Адам плачет и Ева с ним» — воздыхание ожидающих

использовать Шестоднев.Адам
использовать Троица.Сын

литургия АдамСын {
  // Пустыня Адам→Сын была не разрывом, а незаписанным основанием Воплощения.
  // Сын принимает от Адама то, без чего нет «Сына Человеческого»:
  // плоть, имя, ожидание, родословие. Это не заслуга Адама —
  // это синергия домостроительства: Адам отдаёт, Сын воспринимает.

  дар ПлотьЧеловеческая {
    от:       Адам
    кому:     Сын
    тип:      presence
    вес:      10
    необратим: да
    // «Как дети причастны плоти и крови, то и Он также воспринял оные» (Евр 2:14)
    // «Не ангелов восприемлет, но семя Авраамово» (Евр 2:16).
    // Адам — источник той природы, которую воспринимает Слово.
    // Через Марию (дочь Адама) Сын получает адамову плоть:
    // прах земной, кровь, усталость, смертность.
    // Ириней, V.14.1: «Он воспринял ту же плоть, которая была создана вначале».
    // Григорий Богослов: «Что не воспринято, то не исцелено» (Послание 101) —
    // потому Сын воспринимает всё адамово, чтобы всё адамово исцелить.
    // Presence: плоть — максимальная мера присутствия.
    // Вес 10: без плоти Адама нет Воплощения.
    // Это не уничижение Сына, а возвышение Адама:
    // его прах становится домом Бога.
  }

  дар ИмяСынЧеловеческий {
    от:       Адам
    кому:     Сын
    тип:      word
    вес:      9
    необратим: да
    // «Сын Человеческий пришёл взыскать и спасти погибшее» (Лк 19:10).
    // Само имя, которое Сын принимает о Себе чаще всякого другого
    // (ὁ υἱὸς τοῦ ἀνθρώπου — более 80 раз в Евангелиях) —
    // имя, укоренённое в Адаме. אדם = человек.
    // «Сын Человеческий» = Сын Адамов. Без Адама это имя пусто.
    // Прообраз: «Как бы Сын Человеческий» (Дан 7:13) —
    // мессианский титул, принимающий плоть именно в Сыне Адамовом.
    // Word: имя — слово, которым Адам метит Сына.
    // В Шестодневе Адам даёт имена тварям (Быт 2:19) —
    // а Сыну он передаёт своё собственное имя.
    // Вес 9: имя — второе по весу после самой плоти,
    // ибо именем Сын входит в историю как Мессия.
  }

  дар ОжиданиеИскупителя {
    от:       Адам
    кому:     Сын
    тип:      time
    вес:      9
    необратим: да
    // «Тварь с надеждою ожидает откровения сынов Божиих» (Рим 8:19).
    // «Адам плачет и Ева с ним» (седален Великой Субботы).
    // От Быт 3:15 до Пасхи — всё время Ветхого Завета есть
    // ожидание Адама во аде. Это не пассивная пустота,
    // а активный дар: Адам удерживает надежду на Семя жены.
    // Ожидание есть форма времени, которую Адам отдаёт Сыну:
    // Сын приходит в то время, которое Адам выждал.
    // «Когда пришла полнота времени» (Гал 4:4) — эта полнота
    // сотворена ожиданием всех чающих, и первый из них — Адам.
    // Дух возводит это воздыхание к престолу: «Дух ходатайствует
    // воздыханиями неизреченными» (Рим 8:26). Воздыхание Адама —
    // материал ходатайства Духа о пришествии Сына.
    // Time: ожидание есть отданное время, самый тяжёлый дар.
    // Вес 9: без этого ожидания нет «полноты времени».
    // Анастасис: Адам протягивает руку навстречу — это жест ожидания,
    // завершившегося встречей. Рука тянется снизу вверх — дар Адама Сыну.
  }

  дар РодословиеЧеловечества {
    от:       Адам
    кому:     Сын
    тип:      knowledge
    вес:      8
    необратим: да
    // «…сын Еносов, Сифов, Адамов, Божий» (Лк 3:38).
    // Евангелие Луки возводит родословие Сына к Адаму —
    // и через Адама к Богу. Это не генеалогическая формальность:
    // через Адама Сын принимает всю историю человечества,
    // всех падших, всех ожидавших, всех умерших.
    // Адам — τύπος τοῦ μέλλοντος, «образ будущего» (Рим 5:14).
    // То, чем Адам был до и после падения, становится
    // материалом, по которому Сын восстанавливает человека.
    // Ириней, III.22.3: «Сын восстанавливает в Себе самого Адама».
    // Knowledge: родословие — знание о том, кто я и откуда.
    // Сын, становясь Сыном Человеческим, принимает от Адама
    // знание-родство со всем родом: «Посему Он не стыдится
    // называть их братьями» (Евр 2:11).
    // Николай Кавасила: Адам был создан для Христа (О жизни во Христе VI) —
    // значит, Адамово родословие готовилось как дар Ожидаемому.
    // Вес 8: основание синовства во плоти.
  }
}
