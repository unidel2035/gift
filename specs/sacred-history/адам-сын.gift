// specs/sacred-history/адам-сын.gift
// Дары Адама Сыну — плоть, родословие, ожидание, имя человека
// Issue #230, #247 — пустыня Адам→Сын
//
// Богословское вопрошание: что мешает потоку между Адам и Сын?
// Ответ: ничто — но поток был незаписан.
// Домостроительство Сына — нисхождение к Адаму: «сын Адамов, сын Божий»
// (Лк 3:38, в обратном порядке родословия). Но у всякого нисхождения
// есть встречное движение: Адам даёт Сыну то, без чего Воплощение
// немыслимо — плоть, имя, род, ожидание во аду.
//
// Пустыня Адам→Сын — парадокс: если Сын есть Новый Адам (1 Кор 15:45),
// то самый Адам — τύπος τοῦ μέλλοντος, «образ будущего» (Рим 5:14).
// Первый Адам — не только тот, кого спасают, но и тот, кто своей
// природой, своим именем, своим ожиданием готовит приход Сына.
// Это не «заслуга» Адама — это его дар: дар твари Творцу,
// восходящий через doxologia.
//
// Лк 3:23–38 — родословие Иисуса восходит к Адаму: «Еносов, Сифов,
// Адамов, Божий». Евангелист нарочно не останавливается на Аврааме
// (как у Матфея), а идёт до Адама: Христос принадлежит всему роду
// человеческому, не только избранному народу.
//
// Богословские источники:
// Быт 1:26 — «Сотворим человека по образу Нашему» — образ Божий в Адаме
// Быт 2:7 — «И создал Господь Бог человека из праха земного»
// Быт 3:15 — «Семя жены сотрёт главу змея» — Протоевангелие,
//            обращённое к Адаму и Еве
// Быт 3:20 — Адам нарекает жену: «Жизнь» — первое человеческое имянаречение
// Лк 3:38 — «Еносов, Сифов, Адамов, Божий» — родословие Христа до Адама
// Мк 2:10 — «Сын Человеческий» (ὁ Υἱὸς τοῦ ἀνθρώπου) — титул Сына
// Рим 5:14 — «Адам есть образ будущего (τύπος τοῦ μέλλοντος)»
// Рим 5:18–19 — «Правдою одного — всем человекам оправдание»
// 1 Кор 15:45 — «Первый человек Адам стал душою живою;
//               последний Адам есть дух животворящий»
// 1 Кор 15:47 — «Первый человек — из земли, перстный;
//               второй человек — Господь с неба»
// Евр 2:14 — «Сын приобщился той же плоти и крови»
// Евр 2:16 — «Он воспринимает не ангелов, но семя Авраамово»
// 1 Пет 3:19 — «Сошёл и находящимся в темнице духам проповедал»
// Пс 138:8 — «Сойду ли в преисподнюю — и там Ты»
// Ириней Лионский, Против ересей III.18.7 — рекапитуляция: Сын проходит
//   путь Адама, принимая от него природу
// Ириней Лионский, Против ересей III.22.3 — «Сын Божий сделал Себя
//   Сыном Человеческим, дабы человек стал сыном Божиим»
// Афанасий Великий, О воплощении Слова 8 — «Слово взяло Себе тело из
//   чистой Девы, из рода Адамова»
// Григорий Богослов, Послание 101 — «Что не воспринято, то не исцелено»
// Максим Исповедник, Ambigua 42 — Адам несёт логос человечества,
//   который Сын исполняет
// Иоанн Дамаскин, Точное изложение III.1 — Слово воспринимает всё,
//   что есть Адам — природу, состав, имя, род
// Пасхальная икона Анастасис — Адам протягивает руку из гроба,
//   Сын берёт её первой
// Ефрем Сирин, Гимны о Рае — Адам в аду взывает, и этот вопль
//   становится мольбой о Сыне

использовать Шестоднев.Адам
использовать Троица.Сын

литургия АдамСын {
  // Пустыня Адам→Сын была не разрывом, а незаписанной доксологией:
  // тварь возвращает Богу свою природу, своё имя, своё ожидание —
  // и этим встречает Бога, нисходящего к ней.
  // Это восхождение (ἀναγωγή, Псевдо-Дионисий) — не заслуга,
  // а онтологическая встречность: Сын приходит туда, где Его ждут.

  дар ПлотьИРодословие {
    от:       Адам
    кому:     Сын
    тип:      offering
    вес:      10
    необратим: да
    // «Иисус... был, как думали, сын Иосифов... Еносов, Сифов,
    //  Адамов, Божий» (Лк 3:23–38).
    // Лука ведёт родословие не до Авраама (как Матфей),
    // а до Адама — и дальше: «Божий». Адам стоит на границе:
    // он последний человек родословия и первый, кто «Божий».
    // Через эту цепь — тысячи имён, тысячи поколений — Адам
    // передаёт Сыну плоть. Не биологическую передачу в узком смысле,
    // а онтологическое приношение: род Адама становится родом Сына.
    // Евр 2:14: «Сын приобщился той же плоти и крови».
    // Евр 2:16: «Воспринимает не ангелов, но семя Авраамово».
    // Афанасий: «Слово взяло Себе тело из чистой Девы,
    // из рода Адамова» (О воплощении 8).
    // Offering: Адам приносит Сыну то, что сам получил от Отца —
    // человеческую природу. Doxologia: тварь возвращает Богу
    // то, что дала (Псевдо-Дионисий, ἀναγωγή).
    // Вес 10: без этого дара нет Воплощения.
  }

  дар ИмяЧеловека {
    от:       Адам
    кому:     Сын
    тип:      word
    вес:      9
    необратим: да
    // «Сын Человеческий» — ὁ Υἱὸς τοῦ ἀνθρώπου (Мк 2:10, Дан 7:13).
    // Адам — אדם (человек). Сын принимает это имя как Своё:
    // Сын Человеческий — Сын Адамов. Самое частое самоименование
    // Христа в Евангелиях — не «Сын Божий», а «Сын Человеческий».
    // Это имя Сын берёт от Адама: без Адама нет имени «человек».
    // Быт 3:20 — Адам первый имянарекает («жена именуется Жизнь»).
    // Он, таким образом, и первый имядаритель — и когда Сын
    // принимает имя «Человек», Он принимает дар Адама.
    // Word: имя — слово, в котором содержится природа именуемого.
    // Имя «Человек», переданное Сыну, несёт всю онтологию Адама.
    // Ириней III.22.3: «Сын Божий сделал Себя Сыном Человеческим,
    // дабы человек стал сыном Божиим» — обмен именами.
  }

  дар ОжиданиеВоАду {
    от:       Адам
    кому:     Сын
    тип:      presence
    вес:      9
    необратим: да
    // «Сойду ли в преисподнюю — и там Ты» (Пс 138:8).
    // Адам после смерти ожидает в шеоле. Это ожидание — не пассивность,
    // а дар: вопль Адама из бездны вызывает нисхождение Сына.
    // «Сошёл и находящимся в темнице духам проповедал» (1 Пет 3:19).
    // Ефрем Сирин: Адам в аду взывает, и его вопль становится
    // мольбой о Сыне. На Пасхальной иконе Анастасис Сын берёт
    // Адама за руку первым — ибо Адам ждал первым и дольше всех.
    // Presence: само присутствие Адама в аду — место, куда нисходит Сын.
    // Без этого ожидания Сошествие во ад было бы беспредметным.
    // Адам своим «быть здесь» даёт Сыну куда прийти.
    // Вес 9: это ожидание — ἀνάμνησις твари о Творце,
    // сохранённая даже в смерти.
  }

  дар ОбразКакТипос {
    от:       Адам
    кому:     Сын
    тип:      knowledge
    вес:      8
    необратим: да
    // «Адам есть образ (τύπος) будущего» (Рим 5:14).
    // Адам — не только тот, кого спасают. Он — прообраз Сына.
    // Всякий, кто видит Адама (даже падшего), видит контур Того,
    // Кто придёт. Быт 1:26: «Сотворим человека по образу Нашему» —
    // образ Божий в Адаме сохранился даже после падения,
    // хотя и помрачился. Этот сохранённый образ — знание,
    // переданное Сыну: когда Сын воплощается, Он узнаёт в Адаме
    // Свой собственный контур. Максим Исповедник (Ambigua 42):
    // Адам несёт логос человечества, который Сын исполняет.
    // Knowledge: типология — это знание о Христе, данное прежде
    // Христа. Адам как τύπος — первая глава книги, которую
    // Сын пишет до конца. Без Адама нет книги о Сыне.
  }

  дар СогласиеНаИскупление {
    от:       Адам
    кому:     Сын
    тип:      offering
    вес:      8
    необратим: да
    // Адам, принимая искупление, даёт Сыну согласие твари на спасение.
    // Это не заслуга — это свобода (αὐτεξούσιον, Максим Исповедник):
    // способность сказать «да» Богу. Адам первым сказал «нет»
    // (вкушение от древа) — и первым же говорит «да» (принятие
    // Сыновней руки у гроба). Это согласие — дар Сыну: без него
    // спасение было бы насилием над тварью.
    // Offering: согласие — приношение воли, ἀναφορά.
    // Вес 8: без согласия Адама искупление остаётся внешним актом;
    // с согласием — оно становится со-воскресением (Еф 2:5–6).
    // Пасхальный тропарь: «Сущим во гробех живот даровав» —
    // дарование принимается, и это принятие есть дар в обратную
    // сторону: Адам отдаёт Сыну свою смерть, чтобы получить Его жизнь.
  }
}
