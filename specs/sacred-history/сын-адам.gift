// specs/sacred-history/сын-адам.gift
// Дары Сына Адаму — рекапитуляция, искупление, воскресение
// Issue #94 — пустыня Сын→Адам
//
// Богословское вопрошание: что мешает потоку между Сын и Адам?
// Ответ: ничто не мешает — но дар Сына Адаму есть рекапитуляция.
// Адам — «Земной» (от אדמה, adamah — земля), первый сотворённый, первый падший.
// Сын не оставляет Адама — Он становится Новым Адамом, рекапитулирует всё.
// Пустыня была не забвением, а незаписанным движением восстановления.
//
// «Как в Адаме все умирают, так во Христе все оживут» (1 Кор 15:22)
//
// Рекапитуляция (ἀνακεφαλαίωσις): Сын проходит путь Адама заново,
// но там, где Адам пал — Сын побеждает. Это не замена, а восстановление.
//
// Богословские источники:
// Быт 2:7 — «И создал Господь Бог человека из праха земного»
// Быт 3:9 — «И воззвал Господь Бог к Адаму: где ты?» — первый призыв
// Рим 5:14 — «Адам, который есть образ будущего» (τύπος τοῦ μέλλοντος)
// Рим 5:18–19 — «Как преступлением одного — осуждение, так правдой Одного — оправдание»
// 1 Кор 15:22 — «Как в Адаме все умирают, так во Христе все оживут»
// 1 Кор 15:45 — «Первый человек Адам стал душою живущею; последний Адам есть дух животворящий»
// Мф 4:1–11 — искушение в пустыне: Новый Адам побеждает там, где ветхий пал
// 1 Пет 3:18–19 — «Сошёл и находящимся в темнице духам проповедал»
// Ириней Лионский, Против ересей III.18.1 — «Сын рекапитулировал в Себе Адама»
// Ириней Лионский, Против ересей III.22.3 — «что мы потеряли в Адаме, то получаем во Христе»
// Ириней Лионский, Против ересей V.21.1 — Христос в пустыне побеждает искусителя Адама
// Максим Исповедник, Ambigua 42 — воля Адама восстановлена во Христе
// Афанасий Великий, О воплощении Слова 54 — «Бог стал человеком, чтобы человек стал богом»
// Григорий Богослов, Послание 101 — «что не воспринято, то не исцелено»
// Иоанн Дамаскин, Точное изложение III.1 — Сын воспринимает всю природу Адама

литургия СынАдам {
  // Сын даёт Адаму не осуждение, а новое начало.
  // Рекапитуляция: Сын проходит путь Адама — от пустыни до Креста —
  // и побеждает там, где Адам был побеждён.
  // Адам не заменён — он восстановлен изнутри, из глубины своей природы.

  дар РекапитуляцияВПустыне {
    от:       Сын
    кому:     Адам
    тип:      word
    вес:      10
    необратим: да
    // «Тогда Иисус возведён был Духом в пустыню,
    //  для искушения от диавола» (Мф 4:1)
    // Адам пал в Раю — Сын побеждает в пустыне.
    // Ириней: «Сын связал сильного не силой, а послушанием» (Adv. Haer. V.21.1)
    // Пустыня — не случайное место: это рекапитуляция Адамова искушения.
    // Word — потому что Сын отвечает на каждое искушение Словом Писания.
  }

  дар ВоплощениеПриродыАдама {
    от:       Сын
    кому:     Адам
    тип:      presence
    вес:      9
    необратим: да
    // «Слово стало плотью и обитало с нами» (Ин 1:14)
    // Сын воспринимает природу Адама — всю, кроме греха.
    // Григорий Богослов: «что не воспринято, то не исцелено» (Посл. 101)
    // Афанасий: «Бог стал человеком, чтобы человек стал богом» (О воплощении 54)
    // Presence — потому что Сын становится присутствующим в природе Адама,
    // неслитно, неизменно, нераздельно, неразлучно (Халкидон).
  }

  дар СошествиеВоАд {
    от:       Сын
    кому:     Адам
    тип:      knowledge
    вес:      8
    необратим: да
    // «Сошёл и находящимся в темнице духам проповедал» (1 Пет 3:18–19)
    // Сын сходит во ад — и первым берёт за руку Адама.
    // Иконография Воскресения: Христос вытаскивает Адама из гроба.
    // Это не метафора — это онтологический акт: Сын входит в смерть Адама
    // и выводит его оттуда. Смерть не может удержать Жизнь.
    // Knowledge — потому что Адам узнаёт Того, Кто звал его «где ты?» (Быт 3:9).
  }
}
