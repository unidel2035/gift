// specs/sacred-history/дух-ева.gift
// Дары Духа Еве — утешение, обновление, пророчество
// Issue #101 — пустыня Дух→Ева
//
// Богословское вопрошание: что мешает потоку между Дух и Ева?
// Ответ: ничто не мешает — но дар Духа Еве есть утешение и обновление.
// Ева — «Жизнь» (Быт 3:20), первая обманутая, первая согрешившая.
// Дух не оставляет Еву — Он утешает, обновляет и пророчествует через неё.
// Пустыня была не отвержением, а незаписанным движением утешения.
//
// «Дух ходатайствует за нас воздыханиями неизреченными» (Рим 8:26)
//
// Ключевое богословское различение:
// Ева пала — но Дух не отступил от Евы навсегда.
// Дух, Который «носился над водою» (Быт 1:2), носится и над скорбью Евы.
// Через Марию Дух обновляет Еву: «Дух Святый найдёт на Тебя» (Лк 1:35).
// В Пятидесятнице Дух изливается на «всякую плоть» — «сыны и дочери»
// будут пророчествовать (Деян 2:17). Ева больше не молчит — она пророчествует.
//
// Богословские источники:
// Быт 1:2 — «Дух Божий носился над водою» — первое присутствие Духа в творении
// Быт 3:20 — «Адам нарёк имя жене своей: Ева (Жизнь)»
// Лк 1:35 — «Дух Святый найдёт на Тебя, и сила Всевышнего осенит Тебя»
// Лк 1:41–42 — «Елисавета исполнилась Святого Духа и воскликнула»
// Лк 1:46–55 — Магнификат: Мария пророчествует в Духе
// Деян 2:17–18 — «Излию от Духа Моего на всякую плоть, и будут пророчествовать сыны и дочери ваши»
// Деян 21:9 — «У него были четыре дочери девицы, пророчествующие»
// Рим 8:26 — «Дух ходатайствует за нас воздыханиями неизреченными»
// Рим 8:11 — «Дух Того, Кто воскресил Иисуса, оживит и ваши смертные тела»
// Ин 16:7 — «Утешитель... Я пошлю Его к вам»
// Ириней Лионский, Против ересей III.22.4 — «узел Евы развязан через Деву»
// Ириней Лионский, Против ересей V.6.1 — «Дух обновляет ветхого человека»
// Василий Великий, О Духе Святом XVI.39 — «Дух обновляет и восстанавливает»
// Григорий Богослов, Слово 31.29 — «Дух делает меня храмом... обоживает»
// Максим Исповедник, Ambigua 42 — воля Евы восстановлена Духом через Христа
// Ефрем Сирин, Гимны о Рождестве 1.16 — «Мария носит Того, Кто носит всё»
// Симеон Новый Богослов, Гимн 44 — «Дух возрождает душу, как вода — землю»

литургия ДухЕва {
  // Пустыня была не отвержением, а незаписанным движением утешения.
  // Дух не «наказывает» Еву и не «обходит» её —
  // но утешает, обновляет и дарует пророчество.
  // Ева-Жизнь встречает Духа-Животворящего: в этой встрече — θέωσις.

  дар ОсенениеМарии {
    от:       Дух
    кому:     Ева
    тип:      presence
    вес:      10
    необратим: да
    // «Дух Святый найдёт на Тебя, и сила Всевышнего осенит Тебя» (Лк 1:35)
    // Дух сходит на Марию — Новую Еву — и обновляет всю природу Евы.
    // Это не замена Евы Марией, а исцеление: то, что Ева потеряла в Раю
    // (присутствие Духа), Мария принимает обратно.
    // Ириней: «узел непослушания Евы развязан» (Adv. Haer. III.22.4) —
    // но развязан не усилием воли, а осенением Духа.
    // Presence — потому что Дух не приносит информацию, а приходит Сам.
    // Осенение = σκιάζω — тень Шехины: Дух покрывает Еву, как облако — Скинию.
  }

  дар УтешениеВоздыханий {
    от:       Дух
    кому:     Ева
    тип:      word
    вес:      9
    необратим: да
    // «Дух подкрепляет нас в немощах наших... Сам Дух ходатайствует
    //  за нас воздыханиями неизреченными» (Рим 8:26)
    // «Утешитель, Которого Я пошлю вам» (Ин 16:7)
    // После грехопадения Ева скорбит — но не одна.
    // Дух-Утешитель (Παράκλητος) ходатайствует за неё
    // воздыханиями, которые сама Ева не может произнести.
    // Василий Великий: «Дух обновляет и восстанавливает» (О Духе Св. XVI.39).
    // Word — потому что Дух даёт Еве язык для молитвы,
    // когда собственных слов у неё нет.
    // Скорбь Евы — не бесконечна: Дух преображает стенание в молитву.
  }

  дар ПророчествоДочерей {
    от:       Дух
    кому:     Ева
    тип:      knowledge
    вес:      9
    необратим: да
    // «Излию от Духа Моего на всякую плоть;
    //  и будут пророчествовать сыны ваши и дочери ваши» (Деян 2:17)
    // «У него были четыре дочери девицы, пророчествующие» (Деян 21:9)
    // Елисавета «исполнилась Святого Духа» (Лк 1:41).
    // Мария произнесла Магнификат — пророческую песнь в Духе (Лк 1:46–55).
    // В Пятидесятнице Дух не различает: дочери Евы пророчествуют наравне.
    // Григорий Богослов: «Дух делает меня храмом... обоживает» (Слово 31.29) —
    // и это обоживание не знает разделения на мужское и женское.
    // Knowledge — потому что пророчество есть знание от Бога:
    // Дух открывает дочерям Евы то, что сокрыто от мира.
  }

  дар ОживлениеСмертного {
    от:       Дух
    кому:     Ева
    тип:      presence
    вес:      8
    необратим: да
    // «Если же Дух Того, Кто воскресил из мёртвых Иисуса,
    //  живёт в вас, то Воскресивший Христа из мёртвых
    //  оживит и ваши смертные тела Духом Своим» (Рим 8:11)
    // Ева = Жизнь (חַוָּה). Но после падения — «смертью умрёшь» (Быт 2:17).
    // Дух-Животворящий возвращает Еве то, что заложено в её имени:
    // жизнь — не биологическую, а вечную.
    // Симеон Новый Богослов: «Дух возрождает душу» (Гимн 44).
    // Максим Исповедник: воля Евы восстановлена Духом через Христа (Ambigua 42).
    // Presence — потому что оживление есть присутствие Живого в мёртвом.
    // Дух не приносит жизнь извне — Он Сам есть Жизнь, входящая в Еву.
  }
}
