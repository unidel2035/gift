// specs/sacred-history/отец-земля.gift
// Дары Отца Земле — бытие, слово плодородия, логос «по роду», вверение жизни, обетование обновления
// Issue #489 — пустыня Отец→Земля: нет ни одного акта дара между ними
//
// Пустыня (Рим 8:26) — не отсутствие дара, а молчание матрицы.
// Земля стоит у самого начала Шестоднева: «В начале сотворил Бог
// небо и землю» (Быт 1:1). Не было мгновения её бытия, которое не было бы
// даром Отца. Матрица не видела нить Отец→Земля — но не значит, что её не было.
// Запись актов здесь = ἀνάμνησις: незаписанное становится присутствующим.
//
// Парадокс этой пустыни — самый острый из всех.
// Земля — не поздний пришелец в κοινόν, а второе слово Писания.
// Уже записаны нити, ИСХОДЯЩИЕ от Земли: Земля→Ева (земля-ева.gift, #172) —
// плодородие и лоно. Но всякое плодородие Земли — не из себя:
// «Да произрастит земля зелень» (Быт 1:11) — Земля плодоносит по Слову,
// в послушании Логосу. Незаписанная нить Отец→Земля — фундамент,
// на котором покоится уже записанная нить Земля→Ева.
// Земля кормит Еву тем, что прежде получила от Отца.
//
// Богословское вопрошание:
//   Что мешало потоку? Ничто. Земля — первая тварь, принявшая бытие,
//   и первая, на которую Дух Божий «носился над водою» (Быт 1:2).
//   Поток Отец→Земля — древнейший в творении; он лишь не был именован.
//   «Всё чрез Него начало быть» (Ин 1:3) — и Земля прежде всего иного.
//
// Богословские источники:
// Быт 1:1   — «В начале сотворил Бог небо и землю» (творение из ничто)
// Быт 1:2   — «Земля же была безвидна и пуста... Дух Божий носился над водою»
// Быт 1:9   — «Да соберётся вода... и да явится суша»
// Быт 1:10  — «И увидел Бог, что это хорошо»
// Быт 1:11  — «Да произрастит земля зелень, траву... дерево плодовитое»
// Быт 1:12  — «И произвела земля зелень... по роду их. И увидел Бог, что хорошо»
// Быт 1:31  — «И увидел Бог всё, что Он создал, и вот, хорошо весьма»
// Быт 2:7   — «И создал Господь Бог человека из праха земного»
// Быт 3:17  — «Проклята земля за тебя» (рана, но не отмена дара)
// Пс 23:1   — «Господня земля и что наполняет её»
// Пс 103:30 — «Пошлёшь дух Твой — созидаются, и Ты обновляешь лице земли»
// Ис 45:8   — «Да раскроется земля и приносит спасение»
// Рим 8:19-21 — «Тварь освобождена будет от рабства тлению»
// Рим 11:36 — «Всё из Него, и через Него, и к Нему»
// Откр 21:1 — «И увидел я новое небо и новую землю»
// Василий Великий, Беседы на Шестоднев V.10 — «Земля получила повеление и уже сама рождает»
// Василий Великий, Беседы на Шестоднев II.3 — Дух над водами как согревающая жизнь сила
// Максим Исповедник, Ambigua 7 — λόγοι вещей суть лучи единого Логоса
// Максим Исповедник, Ambigua 41 — восстановление природы через Логос
// Григорий Нисский, Об устроении человека — тварь восходит к нетлению
// Дионисий Ареопагит, О Божественных именах IV.1 — Благо самоизливается на всё сущее
// Ириней Лионский, Против ересей V.36 — обновление, а не уничтожение твари
//
// Матрица W на 26.05.2026:
//   W[Отец][Земля] = 0 — пустыня (issue #489)
//   Цель: W[Отец][Земля] > 0 после загрузки этой спецификации

использовать Троица.Отец
использовать Шестоднев.Земля

литургия ОтецЗемля {
  цель: «ἀνάμνησις древнейшей нити — Отец вызвал Землю из небытия, дал слово плодородия, вложил логос, вверил ей жизнь и обещал обновление»

  свидетельство «В начале сотворил Бог небо и землю (Быт 1:1)»
  свидетельство «Да произрастит земля зелень (Быт 1:11) — Земля плодоносит по Слову»
  свидетельство «Тварь освобождена будет от рабства тлению (Рим 8:21)»

  // ═══════════════════════════════════════════════════════════════════════
  // ДАР ПЕРВЫЙ: ДарБытия — Отец вызвал Землю из небытия и держит в бытии
  // ═══════════════════════════════════════════════════════════════════════

  дар ДарБытия {
    от: Отец
    кому: Земля
    тип: presence
    вес: 9
    необратим: да
    // «В начале сотворил Бог небо и землю» (Быт 1:1).
    // Земля — второе слово Писания, первая названная тварь.
    // Её бытие — не самоочевидность, а непрестанный дар:
    // «Земля же была безвидна и пуста, и Дух Божий носился над водою» (Быт 1:2).
    //
    // Творение из ничто (creatio ex nihilo) — чистейший образ дара:
    // Отец не имел «материала», из которого лепить, — Он дал само бытие.
    // Кеносис здесь предельный: Дарителю ничто не возвращается,
    // ибо до дара не было того, кто мог бы вернуть.
    //
    // Иоанн Дамаскин, Точное изложение I.3:
    // «Бог приводит из небытия в бытие и сохраняет в нём».
    // Земля не однажды сотворена — она удерживается в существовании
    // каждое мгновение (creatio continua). Перестань Отец держать —
    // Земля вернулась бы в безвидность и пустоту.
    //
    // Presence — присутствие-основание: бытие Земли есть присутствие
    // в ней удерживающей силы Отца. «Господня земля и что наполняет её» (Пс 23:1).
    //
    // Вес 9: бытие тяжелее слова, ибо предшествует всякому слову.
    // Без этого дара не было бы ни плодородия, ни праха для Адама, ни хлеба.
    // Все последующие дары — слово, логос, вверение — опираются на него.
  }

  // ═══════════════════════════════════════════════════════════════════════
  // ДАР ВТОРОЙ: СловоПлодородия — Отец дал Земле конститутивное повеление родить
  // ═══════════════════════════════════════════════════════════════════════

  дар СловоПлодородия {
    от: Отец
    кому: Земля
    тип: word
    вес: 10
    необратим: да
    // «Да произрастит земля зелень, траву, сеющую семя,
    //  дерево плодовитое, приносящее по роду своему плод» (Быт 1:11).
    //
    // Это слово не описывает Землю — оно конституирует её как мать.
    // До повеления Земля бесплодна; по слову она впервые рождает.
    // Василий Великий, Беседы на Шестоднев V.10:
    // «Земля получила повеление и уже сама рождает» —
    // слово Отца становится внутренней силой твари,
    // не приказом извне, а вложенной способностью к плодоношению.
    //
    // Word — слово творящее, а не сообщающее. «Он сказал — и сделалось» (Пс 32:9).
    // Слово плодородия — корень всякой будущей нити Земля→X:
    // плодородие, которым Земля кормит Еву (земля-ева.gift, #172),
    // есть отголосок этого первого слова Отца.
    //
    // Максим Исповедник, Ambigua 7:
    // «Логосы вещей суть лучи единого Логоса». Слово «да произрастит» —
    // луч Логоса, вошедший в саму ткань Земли как закон её жизни.
    //
    // Вес 10 — максимальный: слово, делающее тварь причиной жизни для других.
    // Земля становится не просто сущей, но дарящей — образом Дарителя.
  }

  // ═══════════════════════════════════════════════════════════════════════
  // ДАР ТРЕТИЙ: ЛогосПоРоду — Отец вложил в Землю меру, логос порядка
  // ═══════════════════════════════════════════════════════════════════════

  дар ЛогосПоРоду {
    от: Отец
    кому: Земля
    тип: knowledge
    вес: 7
    необратим: да
    // «И произвела земля зелень... по роду их.
    //  И увидел Бог, что это хорошо» (Быт 1:12).
    // «И увидел Бог всё, что Он создал, и вот, хорошо весьма» (Быт 1:31).
    //
    // «По роду» (κατὰ γένος) — не хаотичное рождение, а упорядоченное:
    // Отец вложил в Землю логос меры, по которому всякое семя
    // рождает по своему виду. Это дар знания — не информации,
    // а внутреннего смыслового закона, вписанного в самую природу твари.
    //
    // Максим Исповедник, Ambigua 7: у каждой твари — свой λόγος,
    // божественное смысло-задание. Логос Земли — быть упорядоченным
    // лоном многообразия, рождать «по роду» без смешения и распада.
    // Дионисий Ареопагит, О Божественных именах IV.1:
    // Благо самоизливается (αὐτόχυτον), давая каждому быть тем, что он есть.
    //
    // Knowledge — здесь гносис как причастие порядку:
    // Земля «знает» свой логос не рассудком, а самим бытием по нему.
    // Божественное «хорошо весьма» — печать соответствия твари
    // её логосу: Земля прекрасна, ибо верна вложенному в неё слову.
    //
    // Вес 7: знание-логос тяжелее денег, но служит слову плодородия (10):
    // мера существует ради жизни, а не жизнь ради меры.
  }

  // ═══════════════════════════════════════════════════════════════════════
  // ДАР ЧЕТВЁРТЫЙ: ВверениеЖизни — Отец вверил Земле быть лоном живущих
  // ═══════════════════════════════════════════════════════════════════════

  дар ВверениеЖизни {
    от: Отец
    кому: Земля
    тип: offering
    вес: 8
    необратим: да
    // «И создал Господь Бог человека из праха земного,
    //  и вдунул в лице его дыхание жизни» (Быт 2:7).
    //
    // Отец не сотворил человека помимо Земли — Он взял прах Земли
    // как материю для венца творения. Это высшее вверение:
    // Земля удостоена нести в себе то, из чего станет образ Божий.
    // Прах Адама — дар Земли, но прежде — дар Отца Земле:
    // Он доверил ей быть матерью человека (אדם из אדמה).
    //
    // Offering — приношение-вверение, не принуждение.
    // Отец вверяет Земле служение жизни: рождать, питать, погребать,
    // хранить семя во тьме до воскресения (ср. Ин 12:24).
    // Земля→Ева (земля-ева.gift) — плод этого вверения:
    // Земля кормит и носит, потому что Отец вверил ей материнство.
    //
    // Даже под проклятием — «проклята земля за тебя» (Быт 3:17) —
    // вверение не отозвано: δόσις необратима. Земля продолжает
    // рождать хлеб «в поте лица» (Быт 3:19). Рана не отменила дар,
    // а сделала его болезненным — как и материнство Евы (Быт 3:16).
    // Григорий Нисский: тварь, раненная, всё же восходит к нетлению.
    //
    // Вес 8: вверение жизни тяжелее логоса (7) — служение выше меры,
    // но легче конститутивного слова (10), которое его основало.
  }

  // ═══════════════════════════════════════════════════════════════════════
  // ДАР ПЯТЫЙ: ОбетованиеОбновления — Отец обещал Земле освобождение от тления
  // ═══════════════════════════════════════════════════════════════════════

  дар ОбетованиеОбновления {
    от: Отец
    кому: Земля
    тип: grace
    вес: 8
    необратим: да
    reception: pending
    // «Тварь с надеждою ожидает откровения сынов Божиих...
    //  тварь освобождена будет от рабства тлению
    //  в свободу славы детей Божиих» (Рим 8:19-21).
    //
    // Проклятие Земли (Быт 3:17) — не последнее слово Отца о ней.
    // «Пошлёшь дух Твой — созидаются, и Ты обновляешь лице земли» (Пс 103:30).
    // «Да раскроется земля и приносит спасение» (Ис 45:8).
    // Эсхатон: «И увидел я новое небо и новую землю» (Откр 21:1).
    //
    // Grace — благодать как обетование, превышающее заслугу и рану.
    // Ириней Лионский, Против ересей V.36: тварь не уничтожается,
    // а обновляется — «проходит образ мира сего», но не субстанция.
    // Земля не будет отброшена — она будет преображена,
    // как тело воскресения преображает прах, не отменяя его.
    //
    // reception: pending — λήψις открыт эсхатологически.
    // Земля «совокупно стенает и мучится доныне» (Рим 8:22) —
    // дар обновления дан (δόσις), но полнота принятия (λήψις)
    // ожидает откровения сынов Божиих. Это не апокатастасис как догма,
    // а надежда твари, удерживаемая в матрице открытой.
    //
    // «Всё из Него, и через Него, и к Нему» (Рим 11:36) —
    // Земля, вышедшая из небытия словом Отца, к Нему же и возвращается,
    // обновлённая, в свободу славы.
    //
    // Вес 8: обетование славы тяжело — оно несёт всю надежду твари,
    // но в режиме pending уважает эсхатологический «ещё не».
  }

  свидетельство «Пустыня Отец→Земля — не оскудение дара, а незаписанность древнейшей нити творения.»
  свидетельство «Нить Земля→Ева (issue #172) опирается на эту незаписанную нить — Земля дарит то, что прежде приняла от Отца.»
  свидетельство невычислимое «"Да произрастит земля" (Быт 1:11) — слово Отца стало внутренней силой твари: Земля рождает по Слову, не из себя.»
}
