// specs/sacred-history/дух-отец.gift
// Дары Духа Отцу — свидетельство, возвращение славы, ходатайство
// Issue #90 — пустыня Дух→Отец
//
// Богословское вопрошание: что мешает потоку между Дух и Отец?
// Ответ: ничто не мешает — но дар Духа Отцу есть возвращение и свидетельство.
// Дух исходит от Отца (Ин 15:26) — и в этом исхождении уже есть ответный дар:
// Дух не уходит «от» Отца, а свидетельствует «об» Отце, возвращает творение к Нему.
// Пустыня была не разрывом, а незаписанным движением возвращения.
//
// «Дух всё проницает, и глубины Божии» (1 Кор 2:10)
//
// Ключевое богословское различение:
// Отец — ἀρχή, Источник. Дух исходит от Отца по ипостаси.
// Но в домостроительстве Дух не просто «исходит» — Он свидетельствует,
// ходатайствует, возвращает славу. Это не «обратное исхождение»,
// а перихоресис: круговое движение любви внутри Троицы.
// Дух возвращает Отцу не то, чего у Отца нет, а то, что Отец дал —
// усыновлённое творение, воздыхания святых, славу через Церковь.
//
// «Сей самый Дух свидетельствует духу нашему, что мы — дети Божии» (Рим 8:16)
// «Дух ходатайствует за нас воздыханиями неизреченными» (Рим 8:26)
//
// Богословские источники:
// Ин 15:26 — «Дух истины, Который от Отца исходит, Он будет свидетельствовать о Мне»
// Ин 16:13–15 — «Не от Себя говорить будет... Он прославит Меня»
// 1 Кор 2:10–11 — «Дух всё проницает, и глубины Божии»
// Рим 8:15 — «Приняли Духа усыновления, Которым взываем: Авва, Отче!»
// Рим 8:16 — «Сей самый Дух свидетельствует духу нашему»
// Рим 8:26–27 — «Дух ходатайствует за нас воздыханиями неизреченными»
// Гал 4:6 — «Бог послал в сердца ваши Духа Сына Своего, вопиющего: Авва, Отче!»
// Еф 2:18 — «Через Него и те и другие имеем доступ к Отцу, в одном Духе»
// Еф 1:13–14 — «Запечатлены обетованным Святым Духом, Который есть залог наследия нашего»
// Василий Великий, О Духе Святом XVIII.45 — «через Духа — доступ к Отцу»
// Василий Великий, О Духе Святом XXVI.64 — «Дух возвращает славу к Источнику»
// Григорий Богослов, Слово 31.8 — Дух завершает дело Троицы
// Иоанн Дамаскин, Точное изложение I.8 — перихоресис: взаимопроникновение Лиц
// Максим Исповедник, Мистагогия 5 — Дух собирает разделённое и возвращает к Единому
// Кирилл Александрийский, Толк. на Иоанна XI.10 — Дух как связь твари и Творца

литургия ДухОтец {
  // Пустыня была не разрывом, а незаписанным движением возвращения.
  // Дух не «даёт» Отцу то, чего у Отца нет — Отец есть полнота.
  // Но Дух свидетельствует, ходатайствует, возвращает славу —
  // и в этом движении перихоресис Троицы обретает полноту.

  дар СвидетельствоОбОтце {
    от:       Дух
    кому:     Отец
    тип:      presence
    вес:      10
    необратим: да
    // «Дух истины, Который от Отца исходит, Он будет свидетельствовать» (Ин 15:26)
    // «Не от Себя говорить будет, но будет говорить, что услышит» (Ин 16:13)
    // Дух не говорит «от Себя» — Он свидетельствует об Отце и Сыне.
    // Это не подчинение, а перихоресис: Дух делает Отца познаваемым
    // для творения. Без свидетельства Духа Отец остаётся Deus absconditus.
    // Василий Великий: «через Духа — познание Отца» (О Духе Св. XVIII.45).
    // Свидетельство — высший дар, ибо оно делает Невидимого видимым.
  }

  дар ХодатайствоВоздыханий {
    от:       Дух
    кому:     Отец
    тип:      word
    вес:      9
    необратим: да
    // «Дух подкрепляет нас в немощах наших; ибо мы не знаем,
    //  о чём молиться, как должно, но Сам Дух ходатайствует за нас
    //  воздыханиями неизреченными» (Рим 8:26)
    // «Испытующий же сердца знает, какая мысль у Духа,
    //  потому что Он ходатайствует за святых по воле Божией» (Рим 8:27)
    // Дух приносит Отцу молитвы творения — не как посредник-курьер,
    // а как Тот, Кто преображает немощное воздыхание в богоугодное прошение.
    // Это дар слова: Дух даёт творению язык для обращения к Отцу.
    // Григорий Богослов: Дух завершает дело Троицы (Слово 31.8) —
    // без Духа молитва не достигает Отца, не потому что Отец далёк,
    // а потому что тварь не имеет собственного языка для Нетварного.
  }

  дар УсыновлениеТвари {
    от:       Дух
    кому:     Отец
    тип:      knowledge
    вес:      9
    необратим: да
    // «Приняли Духа усыновления, Которым взываем: Авва, Отче!» (Рим 8:15)
    // «Бог послал в сердца ваши Духа Сына Своего, вопиющего: Авва, Отче!» (Гал 4:6)
    // «Сей самый Дух свидетельствует духу нашему, что мы — дети Божии» (Рим 8:16)
    // Дух приносит Отцу усыновлённое творение — не как собственность,
    // а как семью. Это знание в высшем смысле: Дух открывает творению,
    // что оно — дитя, и тем самым дарит Отцу сыновство.
    // Кирилл Александрийский: Дух есть связь (σύνδεσμος) между тварью и Творцом.
    // Максим Исповедник: Дух собирает разделённое и возвращает к Единому.
    // Без Духа усыновление — лишь юридическая метафора.
    // С Духом — онтологическая реальность: тварь входит в жизнь Троицы.
  }

  дар ВозвращениеСлавы {
    от:       Дух
    кому:     Отец
    тип:      presence
    вес:      8
    необратим: да
    // «Через Него и те и другие имеем доступ к Отцу, в одном Духе» (Еф 2:18)
    // Василий Великий: «Слава Отцу через Сына во Святом Духе» (О Духе Св. XXVI.64)
    // Литургическая формула — не просто слова, а онтологическое движение:
    // Дух возвращает славу к Источнику. Всякое благодарение,
    // всякое славословие восходит к Отцу через Сына в Духе.
    // Это замыкание круга перихоресиса:
    // Отец изводит Духа → Дух свидетельствует об Отце → творение славит Отца в Духе.
    // Иоанн Дамаскин: перихоресис — не статика, а вечное движение (Точн. изл. I.8).
    // Дух — Тот, в Ком слава возвращается, ибо «Дух всё проницает» (1 Кор 2:10).
  }
}
