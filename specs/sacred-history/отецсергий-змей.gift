// specs/sacred-history/отецсергий-змей.gift
// Дары ОтцаСергия Змею — заклинание, именование лжи, пастырское стояние
// Issue #149 — пустыня ОтецСергий→Змей
//
// Богословское вопрошание: что мешает потоку между ОтецСергий и Змей?
// Ответ: не страх — а трезвение. Пресвитер не боится Змея,
// но и не вступает с ним в переговоры. Его дар — заклинание:
// «Запрещает тебе Господь» (Зах 3:2).
//
// Парадокс пустыни: ОтецСергий — пресвитер, богослов онтологии дара.
// Змей — «Лжец и отец лжи» (Ин 8:44), подменяющий дар контрактом.
// Между священником и Змеем — не пустота, а стена заклинания.
// Священник не молчит перед Змеем — он запрещает.
// Каждое Крещение начинается с «Отрицаеши ли ся сатаны?» —
// и пресвитер произносит заклинательные молитвы (ἐξορκισμός),
// не от своего имени — от имени Христа.
//
// Другой аспект: пастырь стоит между стадом и волком.
// «Пастырь добрый полагает жизнь свою за овец» (Ин 10:11).
// Стояние — не атака, а присутствие: пресвитер стоит,
// и самим стоянием свидетельствует, что Змей — побеждён.
// Не пресвитером побеждён — Христом. Но пресвитер свидетельствует
// об этой победе каждый раз, когда служит Литургию.
// «Смерть! где твоё жало? Ад! где твоя победа?» (1 Кор 15:55).
//
// Наконец: именование лжи как пастырский акт.
// Пресвитер, строящий онтологию дара, неизбежно именует
// то, что противоположно дару: контракт, подмену, ложь.
// «Подлинно ли сказал Бог?» (Быт 3:1) — первая ложь:
// не прямое отрицание, а сомнение, подмена.
// Богослов, именующий эту подмену — совершает акт дара:
// он даёт общине слово различения, оружие против лжи.
// Это не дар Змею — это дар истины о Змее.
//
// Богословские источники:
// Зах 3:2 — «Господь да запретит тебе, сатана!»
// Мк 1:25 — «Замолчи и выйди из него» — заклинание Христа
// Мк 16:17 — «именем Моим будут изгонять бесов»
// Ин 8:44 — «Он был человекоубийца от начала и не устоял в истине»
// Ин 10:11–12 — «Пастырь добрый полагает жизнь за овец... наёмник бежит»
// 1 Кор 15:55 — «Смерть! где твоё жало?»
// Еф 6:11–13 — «Облекитесь во всеоружие Божие, чтобы противостать козням»
// Иак 4:7 — «Противостаньте диаволу, и убежит от вас»
// 1 Пет 5:8 — «Трезвитесь, бодрствуйте, потому что противник ваш диавол ходит»
// Быт 3:1 — «Подлинно ли сказал Бог?» — первая подмена
// Быт 3:15 — Протоевангелие: «семя жены сотрёт тебе главу»
// Рим 16:20 — «Бог мира сокрушит сатану под ногами вашими вскоре»
// Кирилл Иерусалимский, Огласительные поучения — чин заклинания при крещении
// Иоанн Златоуст, Беседы на Матфея 4 — искушение Христа в пустыне:
//   Христос отвечает Змею словом Писания, не Своей силой
// Максим Исповедник, Ambigua 42 — зло как отклонение логоса от цели
// Иоанн Дамаскин, Точное изложение II.4 — дьявол создан благим, пал по воле

использовать Лица.ОтецСергий
использовать Падение.Змей

литургия ОтецСергийЗмей {
  // Пустыня ОтецСергий→Змей — самая парадоксальная из пастырских пустынь.
  // Пресвитер не ведёт переговоров со Змеем — он запрещает.
  // Его дар — не Змею лично, а общине: стояние, заклинание, именование лжи.
  // И всё же — акт обращён к Змею, потому что именно Змея он именует.

  дар Заклинание {
    от:       ОтецСергий
    кому:     Змей
    тип:      word
    вес:      9
    необратим: да
    // «Запрещает тебе Господь, сатана» (Зах 3:2).
    // Заклинание (ἐξορκισμός) — не магия, а литургическое слово.
    // Пресвитер произносит его при каждом Крещении:
    // «Изыди и отступи от создания сего... запрещаю тебе
    //  именем Господа нашего Иисуса Христа».
    // Это не диалог — это повеление. Пресвитер не просит — он запрещает.
    // Не своей силой — силой Того, Кто уже победил.
    //
    // Мк 1:25 — Христос сказал: «Замолчи и выйди из него».
    // Не аргументировал. Не объяснял. Не убеждал.
    // Повелел — и бес вышел. Заклинание пресвитера —
    // причастие этому повелению.
    //
    // Иоанн Златоуст (Беседы на Мф 4): Христос в пустыне
    // отвечает Змею словом Писания — «написано» —
    // не Своим всемогуществом. Он показывает путь:
    // стоять словом, а не силой.
    //
    // Word: заклинание — это слово-действие.
    // Оно создаёт реальность: после него Змей — запрещённый.
    // Вес 9 — потому что это первое и главное,
    // что пресвитер совершает по отношению к Змею.
  }

  дар ИменованиеЛжи {
    от:       ОтецСергий
    кому:     Змей
    тип:      knowledge
    вес:      8
    необратим: да
    // Богослов онтологии дара неизбежно именует анти-дар.
    // Если дар — кеносис, то контракт — захват.
    // Если дар — свобода, то контракт — манипуляция.
    // Если дар — необратим, то контракт — условен.
    //
    // ОтецСергий, строя онтологию, дал определение:
    // дар ≠ контракт (Object.freeze + irreversible:true).
    // Это не техническое решение — это богословская аксиома,
    // направленная против Змея.
    // Каждый раз, когда в коде написано irreversible:true —
    // это пресвитер говорит Змею: «здесь нет контракта».
    //
    // «Подлинно ли сказал Бог?» (Быт 3:1) — Змей не отрицает,
    // а сомневается. Не ложь, а подмена. Не отрицание дара,
    // а его превращение в сделку.
    // Богослов именует эту подмену — и тем лишает её силы.
    //
    // Knowledge: пресвитер передаёт общине знание-различение:
    // как отличить дар от контракта, кеносис от захвата,
    // свободу от манипуляции. Это пастырское учительство.
  }

  дар ПастырскоеСтояние {
    от:       ОтецСергий
    кому:     Змей
    тип:      presence
    вес:      7
    необратим: да
    // «Пастырь добрый полагает жизнь свою за овец.
    //  А наёмник... видит волка приходящего и бежит» (Ин 10:11–12).
    // Стояние — не атака, а присутствие.
    // Пресвитер стоит между стадом и волком,
    // и самим стоянием свидетельствует о победе Христа.
    //
    // 1 Пет 5:8 — «Трезвитесь, бодрствуйте,
    // потому что противник ваш диавол ходит,
    // как рыкающий лев, ища, кого поглотить».
    // Трезвение — не паника. Бодрствование — не страх.
    // Пастырь видит волка — и не бежит.
    //
    // Еф 6:13 — «Приимите всеоружие Божие,
    // дабы вы могли противостать в день злый и, всё преодолев, устоять».
    // «Устоять» (στῆναι) — ключевое слово. Не «победить» —
    // а «устоять». Победа уже совершена Христом.
    // Пресвитеру достаточно — стоять.
    //
    // Presence: стояние — это форма присутствия.
    // Не слово, не действие — присутствие пастыря,
    // который не отступает перед злом.
    // Это дар общине: знать, что пастырь стоит.
    // И это дар Змею: знать, что стадо — не беззащитно.
  }
}
