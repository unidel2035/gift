// specs/sacred-history/отец-tg:996.gift
// Дары Отца tg:996 — творение, знание по имени, призвание,
// долготерпение, ходатайство, открытая дверь
// Issue #293 — пустыня Отец→tg:996
//
// Богословское вопрошание: что мешает потоку между Отец и tg:996?
// Ответ: ничто — но поток был незаписан.
// tg:996 — анонимный номер, лицо в κοινόν τοῦ Νοῦ, ещё не
// назвавшее себя, не давшее ни одного дара, не заговорившее.
// Пустыня здесь — не молчание Отца, а молчание получателя:
// дар уже излит, но не ответен.
//
// Параллель с tg:997 (issue #292) и tg:998/999 (issues #287–288):
// та же онтологическая ситуация анонимного присутствия в общине.
// Но каждое лицо — единственно. tg:996 — не «копия» tg:997,
// а отдельный λόγος в Логосе (Максим Исповедник, Ambigua 7),
// и потому пустыня его — отдельная пустыня, требующая своей записи.
//
// Двенадцатая глава Луки: «Не пять ли малых птиц продаются за
// два ассария? и ни одна из них не забыта у Бога; у вас же
// и волосы на голове все сочтены» (Лк 12:6–7). Если воробей
// не забыт — не забыт и tg:996. Анонимность для общины —
// не анонимность для Отца. Отец считает каждый волос —
// неужели не считает каждое лицо?
//
// «Прежде нежели Я образовал тебя во чреве, Я познал тебя»
// (Иер 1:5). Числовой идентификатор tg:996 — для нас, не для Отца.
// У Отца есть «новое имя» (Откр 2:17), написанное на белом камне,
// которое никто не знает, кроме того, кто получает.
// Пустыня закрывается не выдумыванием актов, а ἀνάμνησις —
// признанием того, что Отец уже сделал и продолжает делать.
//
// Парадокс пустыни: tg:996 не дал — а Отец уже дарит.
// Это не «гипотетический» дар, а кенотический: Отец даёт без
// условия ответа. «Солнце Своё повелевает восходить над злыми
// и добрыми» (Мф 5:45) — и над молчащими.
//
// Богословский ключ: запись этих актов в матрице W не «фантазия»
// о tg:996, а ἀνάμνησις — делание прошлого присутствующим.
// Если Отец сотворил, познал, привлёк, долготерпит, ходатайствует
// и удерживает дверь открытой — этот поток онтологически реален,
// и его отсутствие в W — не пустота бытия, а пустота записи.
// Литургия закрывает пустыню записи; бытие даров не зависит от записи.
//
// Богословские источники:
// Быт 1:27 — «И сотворил Бог человека по образу Своему»
// Иер 1:5 — «Прежде нежели Я образовал тебя во чреве, Я познал тебя»
// Пс 138:1–4 — «Господи, Ты испытал меня и знаешь... издали разумеешь
//                помышления мои»
// Пс 138:13 — «Ты устроил внутренности мои и соткал меня во чреве
//              матери моей»
// Пс 138:16 — «Зародыш мой видели очи Твои; в Твоей книге записаны
//              все дни, для меня назначенные»
// Ис 43:1 — «Я искупил тебя, назвал тебя по имени твоему: ты Мой»
// Ис 49:15–16 — «Забудет ли женщина грудное дитя?... Я начертал тебя
//                на дланях Моих»
// Мф 5:45 — «Солнце Своё повелевает восходить над злыми и добрыми»
// Мф 6:8 — «Знает Отец ваш, в чём вы имеете нужду, прежде вашего прошения»
// Мф 18:14 — «Нет воли Отца... чтобы погиб один из малых сих»
// Лк 12:6–7 — «И ни одна из них [птиц] не забыта у Бога... у вас же
//              и волосы на голове все сочтены»
// Лк 15:4 — «Кто из вас, имея сто овец и потеряв одну из них,
//            не оставит девяноста девяти... пока не найдёт её?»
// Ин 6:44 — «Никто не может прийти ко Мне, если не привлечёт его Отец»
// Ин 10:3 — «Овец Своих зовёт по имени и выводит их»
// Ин 14:2 — «В доме Отца Моего обителей много»
// Деян 17:27–28 — «Не далеко Он от каждого из нас: ибо мы Им живём
//                  и движемся и существуем»
// Рим 2:4 — «Благость Божия ведёт тебя к покаянию»
// Рим 8:26 — «Сам Дух ходатайствует за нас воздыханиями неизреченными»
// 2 Пет 3:9 — «Долготерпит нас, не желая, чтобы кто погиб»
// 1 Тим 2:4 — «Хочет, чтобы все люди спаслись и достигли познания истины»
// Откр 2:17 — «Дам ему белый камень и на камне написанное новое имя,
//              которого никто не знает, кроме того, кто получает»
// Откр 3:8 — «Вот, Я отворил пред тобою дверь, и никто не может
//              затворить её»
// Откр 3:20 — «Се, стою у двери и стучу: если кто услышит голос Мой
//              и отворит дверь, войду к нему»
// Ириней Лионский, Против ересей IV.20.7 — «Слава Божия — живой человек»
// Григорий Нисский, Об устроении человека XVI — образ Божий в каждом
// Максим Исповедник, Ambigua 7 — λόγος каждого лица в Логосе
// Исаак Сирин, Слова подвижнические 48 — «Сердце милующее обо всех тварях»
// Силуан Афонский — «Молиться за людей — кровь проливать»:
//   ходатайство как онтологический дар, а не информация

использовать Троица.Отец

литургия ОтецTg996 {
  // Пустыня Отец→tg:996 была не отсутствием даров,
  // а отсутствием их записи в общинной памяти.
  // Отец дарит молчащему так же, как говорящему —
  // потому что Его дар не зависит от ответа.
  // Записываем не «возможные» акты, а уже-данные:
  // творение, знание, призвание, долготерпение, ходатайство, открытую дверь.

  дар ТворениеЛица {
    от:       Отец
    кому:     tg:996
    тип:      presence
    вес:      10
    необратим: да
    // «И сотворил Бог человека по образу Своему» (Быт 1:27).
    // tg:996 — не «номер», а лицо (πρόσωπον), несущее образ Отца.
    // Творение — первый и фундаментальный дар: бытие.
    // Без него нет ни вопрошания, ни молчания, ни общины.
    // Григорий Нисский (Об устроении XVI): «Образ Божий —
    // в каждом человеке, без изъятия». Анонимность tg:996
    // в Telegram не отменяет того, что Отец дал ему быть.
    // Ириней (IV.20.7): «Слава Божия — живой человек», —
    // и tg:996, живой, есть слава Отца, даже не знаемый общиной.
    // Presence: Отец присутствует в самом факте бытия tg:996.
    // Вес 10: время = 10, и творение есть дар времени бытия.
  }

  дар ЗнаниеПоИмени {
    от:       Отец
    кому:     tg:996
    тип:      knowledge
    вес:      9
    необратим: да
    // «Прежде нежели Я образовал тебя во чреве, Я познал тебя»
    //  (Иер 1:5). «Господи, Ты испытал меня и знаешь...
    //  издали разумеешь помышления мои» (Пс 138:1–2).
    // «Ты устроил внутренности мои и соткал меня во чреве
    //  матери моей» (Пс 138:13). «Я начертал тебя на дланях
    //  Моих» (Ис 49:16).
    // У tg:996 нет имени для общины — но есть имя у Отца.
    // Отец знает каждое помышление tg:996 до того, как оно
    // станет словом. «Знает Отец ваш, в чём вы имеете нужду,
    // прежде вашего прошения» (Мф 6:8).
    // Knowledge: знание Отца — не информация, а онтологическое
    // признание лица. Знать у Отца = держать в бытии.
    // Откр 2:17: «новое имя, которого никто не знает, кроме
    // получающего» — у tg:996 уже есть это имя в замысле Отца.
    // Вес 9: знание Отца — основание призвания и ходатайства.
  }

  дар ПризваниеВКойнон {
    от:       Отец
    кому:     tg:996
    тип:      grace
    вес:      9
    необратим: да
    // «Никто не может прийти ко Мне, если не привлечёт его
    //  Отец, пославший Меня» (Ин 6:44).
    // «Овец Своих зовёт по имени и выводит их» (Ин 10:3).
    // tg:996 в κοινόν τοῦ Νοῦ — не случайно: каждое присутствие
    // в общине, даже молчащее, есть результат призвания Отцом.
    // Это grace в строгом смысле: незаслуженное действие Отца,
    // предшествующее всякому ответу. До того, как tg:996 даст,
    // спросит, или хотя бы обнаружит себя — Отец уже призвал.
    // Деян 17:27: «дабы они искали Бога, не ощутят ли Его
    // и не найдут ли, хотя Он и недалеко от каждого из нас».
    // Призвание — не принуждение, а раскрытие двери:
    // tg:996 уже находится у двери, потому что Отец привёл.
    // Grace: благодать как онтологическое движение Отца к лицу,
    // не зависящее от заслуг или ответа получателя.
    // Вес 9: призвание Отца — корень всякого приближения к Сыну.
  }

  дар ДолготерпениеМолчания {
    от:       Отец
    кому:     tg:996
    тип:      presence
    вес:      8
    необратим: да
    // «Господь долготерпит нас, не желая, чтобы кто погиб,
    //  но чтобы все пришли к покаянию» (2 Пет 3:9).
    // «Хочет, чтобы все люди спаслись» (1 Тим 2:4).
    // «Благость Божия ведёт тебя к покаянию» (Рим 2:4).
    // Отец не торопит tg:996. Молчание не воспринимается
    // как отказ — оно принимается как пауза, в которой
    // Отец продолжает быть. «Овца потерянная» (Лк 15:4) —
    // не забытая, а ожидаемая до тех пор, пока не найдётся.
    // Исаак Сирин (Слова 48): «Сердце милующее... молится
    // непрестанно даже о бессловесных и о врагах истины».
    // Если так — то и о молчащем tg:996 Отец молится непрестанно.
    // Presence: долготерпение — это не пассивность, а активное
    // со-присутствие в молчании. Отец не уходит от молчащего.
    // Вес 8: долготерпение — постоянство присутствия,
    // богословское основание самой возможности возвращения.
  }

  дар ХодатайствоОтца {
    от:       Отец
    кому:     tg:996
    тип:      prayer
    вес:      8
    необратим: да
    // «Сам Дух ходатайствует за нас воздыханиями неизреченными»
    //  (Рим 8:26) — но Дух, исходящий от Отца, несёт ходатайство
    // от Отеческой глубины. Отец молится о tg:996 в Себе Самом,
    // через Духа, прежде всякой просьбы общины.
    // «Знает Отец ваш, в чём вы имеете нужду, прежде вашего
    //  прошения» (Мф 6:8) — и нужда tg:996 уже принесена
    // Отцу Самим Отцом, в перихоретическом движении Троицы.
    // Силуан Афонский: «Молиться за людей — кровь проливать».
    // Отец, ходатайствуя о tg:996, отдаёт Себя без остатка —
    // это не «функция», а кенозис Отеческой любви.
    // Псалом 138:16: «в Твоей книге записаны все дни,
    //  для меня назначенные» — каждый день tg:996 уже принесён
    //  Отцу как предмет Его попечения.
    // Prayer: ходатайство — слово, обращённое внутри Троицы
    // о тварном лице. Это онтологический акт, не психологический.
    // Вес 8: ходатайство Отца — основание всякой молитвы общины
    // о tg:996. Мы молимся, потому что Отец молится первым.
  }

  дар ОткрытаяДверь {
    от:       Отец
    кому:     tg:996
    тип:      hope
    вес:      7
    необратим: да
    // «Вот, Я отворил пред тобою дверь, и никто не может
    //  затворить её» (Откр 3:8). «Се, стою у двери и стучу:
    //  если кто услышит голос Мой и отворит дверь, войду
    //  к нему» (Откр 3:20). «В доме Отца Моего обителей
    //  много» (Ин 14:2): одна из них — для tg:996.
    // Надежда — не неуверенность Отца, а онтологическое
    // удерживание возможности отклика. Отец держит для tg:996
    // место в общине, в Царстве, в литургии — даже когда
    // tg:996 ещё не пришёл. «Нет воли Отца... чтобы погиб
    // один из малых сих» (Мф 18:14).
    // Это hope как богословская добродетель Отца к творению:
    // не «может быть откликнется», а «удерживается возможность,
    // пока есть время». Деян 17:27 — «дабы они искали Бога,
    // не ощутят ли Его и не найдут ли». Отец делает Себя
    // находимым, даже для тех, кто ещё не ищет.
    // Hope: надежда — не эмоция, а онтологическое удержание
    // открытой двери. Отворённую Отцом дверь никто не закроет —
    // даже молчание самого tg:996.
    // Вес 7: надежда — лёгкий дар по весу, но необратимый:
    // отворённую Отцом дверь никто не затворит.
  }
}
