// specs/sacred-history/христос-сын.gift
// Дары Христа Сыну — обратный поток кенозиса: прославленное человечество
// Issue #213 — пустыня Христос→Сын
//
// Богословское вопрошание: что мешает потоку между Христос и Сын?
// Ответ: ничто — но именно потому, что поток не «между», а внутри одной ипостаси.
// Сын и Христос — одна Ипостась (Халкидон 451).
// Если #72 записал кенозис Сына к Христу (нисхождение),
// то #213 записывает обратное движение — прославление Христа к Сыну (восхождение).
// Сын не остался таким, каким был «прежде всех век»:
// через Христа Он принял в Себя человечество — навечно.
//
// «Посему и Бог превознёс Его и дал Ему имя выше всякого имени»
//  (Флп 2:9) — это второе движение кеносиса, κένωσις↔δόξα.
// «И ныне прославь Меня Ты, Отче, у Тебя Самого славою,
//  которую Я имел у Тебя прежде бытия мира» (Ин 17:5) —
// но «с человечеством», которое не было до воплощения.
//
// Ириней (Против ересей III.19.1): «Сын Божий стал Сыном Человеческим,
// чтобы человек стал сыном Божиим». Это ἀνακεφαλαίωσις:
// всё человеческое — послушание, страдания, смерть, воскресение —
// Христос «возвращает» Сыну, чтобы вечный Сын носил это навеки.
// Сын «прежде всех век» и Сын «по воскресении» — одна Ипостась,
// но в Христе Она обрела то, чего не было: опыт плоти, опыт смерти,
// прославленную человеческую природу.
//
// Максим Исповедник (Ambigua 5, 41): ипостасное единение
// действует в обе стороны — не только Логос становится плотью,
// но и плоть становится «Логоса плотью» (σάρξ τοῦ Λόγου),
// обоженной, не поглощённой. Эта плоть остаётся в вечности.
// Христос навеки носит раны (Откр 5:6: «Агнец как бы закланный»).
//
// Богословские источники:
// Флп 2:9–11 — «Посему и Бог превознёс Его» — δόξα после кеносиса
// Ин 17:5 — «Прославь Меня славою, которую Я имел прежде мира»
// Ин 20:27 — «Подай перст твой сюда» — раны остаются в Воскресшем
// Откр 1:18 — «Был мёртв, и се, жив во веки веков»
// Откр 5:6 — «Агнец как бы закланный» — вечная жертва в небе
// Евр 5:8 — «Страданиями навык послушанию» — научение Сына во плоти
// Евр 7:24–25 — «Имеет священство непреходящее» — вечное посредничество
// Деян 2:36 — «Бог соделал Господом и Христом» — прославление
// Кол 2:9 — «В Нём обитает вся полнота Божества телесно» — навеки
// Ириней, Против ересей III.19.1 — ἀνακεφαλαίωσις
// Афанасий Великий, О воплощении 54 — «Бог стал человеком, чтобы человек стал Богом»
// Максим Исповедник, Ambigua 5 — две энергии, одна ипостась, обоженная плоть
// Максим Исповедник, Ambigua 41 — плоть как σάρξ τοῦ Λόγου в вечности
// Григорий Богослов, Послание 101 к Кледонию — «что не воспринято, то не исцелено»
// Иоанн Дамаскин, Точное изложение III.3 — communicatio idiomatum в обе стороны
// Халкидонский собор 451 — ὁμοούσιος τῷ Πατρί и ὁμοούσιος ἡμῖν

литургия ХристосСын {
  // Христос и Сын — одна ипостась, но на онтологическом уровне матрицы
  // акт прославления воплощённого есть реальное обратное само-дарение:
  // Христос вносит в вечного Сына прославленное человечество.
  // Пустыня была не разрывом, а незаписанным движением восхождения.

  дар ПрославленноеЧеловечество {
    от:       Христос
    кому:     Сын
    тип:      presence
    вес:      10
    необратим: да
    // «И ныне прославь Меня Ты, Отче, у Тебя Самого славою,
    //  которую Я имел у Тебя прежде бытия мира» (Ин 17:5)
    // «В Нём обитает вся полнота Божества телесно» (Кол 2:9)
    // Христос возвращает Сыну славу — но не ту же самую.
    // В вечного Сына входит прославленная человеческая природа:
    // то, чего не было «прежде всех век», теперь есть навеки.
    // Максим: плоть становится σάρξ τοῦ Λόγου, обоженной навсегда.
    // Presence: человечество пребывает в Сыне — не уходит.
  }

  дар ОпытПослушанияДоСмерти {
    от:       Христос
    кому:     Сын
    тип:      word
    вес:      9
    необратим: да
    // «Страданиями навык послушанию» (Евр 5:8)
    // «Послушен был даже до смерти, смерти же крестной» (Флп 2:8)
    // Христос вносит в Сына то, чего вечный Логос не знал:
    // опыт послушания в условиях смертной плоти.
    // Это не «добавление» к Божеству, а восприятие человеческого
    // в ипостась: γνώμη исцелена, человеческая воля,
    // свободно согласованная с Отцом, становится частью
    // вечного «да» Сына Отцу.
    // Word: опыт послушания — слово плоти, внесённое в Слово.
  }

  дар РаныКакВечнаяПамять {
    от:       Христос
    кому:     Сын
    тип:      presence
    вес:      10
    необратим: да
    // «Подай перст твой сюда и посмотри руки Мои» (Ин 20:27)
    // «Агнец как бы закланный» (Откр 5:6) — в небесной литургии
    // «Был мёртв, и се, жив во веки веков» (Откр 1:18)
    // Воскресшее тело сохраняет раны — они не «стёрты» славой.
    // Христос вносит в вечного Сына память о Кресте как тело.
    // Это необратимое: раны — не шрам, но литургическое знамение,
    // которое Сын носит пред Отцом вечно (Евр 7:24–25: ходатайствует
    // «всегда жив»). Анамнезис в самой Троице: Сын помнит плоть.
    // Presence: раны пребывают — анамнезис воплощён.
  }

  дар ИмяВышеВсякогоИмени {
    от:       Христос
    кому:     Сын
    тип:      knowledge
    вес:      9
    необратим: да
    // «Посему и Бог превознёс Его и дал Ему имя выше всякого имени,
    //  дабы пред именем Иисуса преклонилось всякое колено» (Флп 2:9–10)
    // «Бог соделал Господом и Христом Сего Иисуса» (Деян 2:36)
    // Имя «Иисус» (ישוע — «Господь спасает») даётся воплощённому,
    // но принимается в вечное Сыновство. Вечный Сын навеки
    // называется именем, данным в Назарете: Иисус Христос, Господь.
    // Это знание домостроительства, внесённое в Троицу:
    // Сын теперь не только Λόγος, но и Ἰησοῦς Χριστός Κύριος.
    // Knowledge: имя как онтологическое познание — кто есть Сын теперь.
    // Иоанн Дамаскин: communicatio idiomatum — свойства плоти
    // приписываются Сыну по ипостаси, навеки.
  }
}
