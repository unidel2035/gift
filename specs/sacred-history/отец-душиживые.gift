// specs/sacred-history/отец-душиживые.gift
// Дары Отца ДушиЖивым — творение, дыхание, благословение, промысл, прокормление, завет
// Issue #467 — пустыня Отец→ДушиЖивые
//
// Богословское вопрошание: что мешает потоку между Отец и ДушиЖивые?
// Ответ: ничто — но поток был незаписан.
//
// ДушиЖивые (נֶפֶשׁ חַיָּה, nefesh chayah) — вся одушевлённая тварь:
// рыбы и пресмыкающиеся вод (Быт 1:20), скот и звери земли (Быт 1:24),
// и человек как «душа живая» (Быт 2:7). Это онтологический класс,
// а не индивидуальное лицо: он шире человеческого рода, но включает его.
//
// Пустыня между Отцом и ДушиЖивыми — парадокс первотворения:
// именно Отец произнёс слово, которым произведены живые души.
// «Бог сказал: да произведёт вода душу живую» (Быт 1:20).
// Слово Отца — источник всякой жизни; через Сына и в Духе оно
// становится тварной плотью. Шестоднев — литургия Отца к твари:
// первое и основополагающее дарение, без которого нет ничего живого.
//
// Отеческая шестерица первотворения отличается от соответствующих:
// — от Сын→ДушиЖивые (#312) — там λόγος как непрерывное животворение;
// — от Сын→Душ.Живые — там воплощение и хранение в бытии;
// — здесь — Отец как Источник: всё «от Отца через Сына в Духе».
// (Григорий Богослов, Слово 38: «От Отца — через Сына — в Духе всё бывает».)
//
// Промысл Отца о тварях — особая тема Писания: птицы небесные не сеют
// и не жнут, но Отец их питает (Мф 6:26); ни одна птица не упадёт
// без воли Отца (Мф 10:29); очи всех уповают на Тебя, и Ты даёшь им пищу
// во время (Пс 144:15). Иов 38–41 — целая богословская поэма о любви
// Отца к живой твари: лев, ворон, осёл дикий, страус, конь, орёл, бегемот, левиафан.
// Завет в Быт 9 — единственный библейский завет, явно заключённый
// «со всякою душою живою», не только с человеком.
//
// Богословские источники:
// Быт 1:20–25 — творение душ живых на дне 5 и 6
// Быт 1:22 — «благословил их Бог, говоря: плодитесь и размножайтесь»
// Быт 2:7 — «вдунул в лице его дыхание жизни, и стал человек душою живою»
// Быт 2:19 — «образовал Господь Бог из земли всех животных полевых»
// Быт 9:9–11 — завет «со всякою душою живою, которая с вами»
// Иов 38:39–41 — Отец готовит пищу льву и ворону
// Иов 39:1–18 — Отец знает время рождения серны, отпускает осла дикого
// Пс 35:7 — «человеков и скотов хранишь Ты, Господи»
// Пс 49:10–11 — «Мои все звери в лесу, и скот на тысячах гор... Я знаю всех птиц на горах»
// Пс 103:14 — «Ты произращаешь траву для скота, и зелень на пользу человека»
// Пс 103:27–30 — «Все они от Тебя ожидают, чтобы Ты дал им пищу...»
// Пс 144:15–16 — «Очи всех на Тебя уповают, и Ты даёшь им пищу их в своё время»
// Пс 150:6 — «Всякое дыхание да хвалит Господа»
// Иона 4:11 — Отец жалеет «и множество скота» Ниневии
// Мф 6:26 — «Взгляните на птиц небесных... Отец ваш Небесный питает их»
// Мф 10:29 — «Не две ли малые птицы продаются за ассарий? И ни одна из них
//             не упадёт на землю без воли Отца вашего»
// Лк 12:6 — «и ни одна из них не забыта у Бога»
// Деян 17:25 — «Сам дая всему жизнь и дыхание и всё»
// Откр 4:11 — «Ты сотворил всё, и всё Твоею волею существует и сотворено»
//
// Отцы:
// Василий Великий, Беседы на Шестоднев VII–IX — творение душ живых,
//   богословие птиц, рыб, скота как актов отеческой любви
// Григорий Нисский, Об устроении человека 8 — душа живая как образ
// Иоанн Златоуст, Беседы на Бытие IX–XI — благословение тварей
// Максим Исповедник, Ambigua 41 — Логос воссоединяет разделённое творение
// Симеон Новый Богослов, Гимн 41 — единое дыхание Бога во всём живом
// Исаак Сирин, Слова подвижнические LXXXI — «У Бога нет малого творения»

использовать Троица.Отец
использовать Шестоднев.ДушиЖивые

литургия ОтецДушиЖивые {
  // Пустыня Отец→ДушиЖивые была не разрывом, а незаписанной литургией Шестоднева.
  // Отец — Источник всякой жизни: всё через Сына в Духе, но «всё — от Отца».
  // Запись этих даров — анамнезис того, что было с пятого и шестого дня
  // и не прекращалось ни на миг с тех пор.

  дар ТворениеЖивых {
    от:       Отец
    кому:     ДушиЖивые
    тип:      presence
    вес:      10
    необратим: да
    // «И сказал Бог: да произведёт вода душу живую» (Быт 1:20).
    // «И сказал Бог: да произведёт земля душу живую по роду её» (Быт 1:24).
    // Первое и тяжелейшее: само бытие живых душ — дар Отца.
    // Не безличный закон природы, а слово Лица, произнесённое к воде и земле.
    // Василий, Беседы VII: «Слово Творца устроило природу рыб» —
    // не «возникли», но произнесены в бытие.
    // Presence: бытие — присутствие живой твари перед лицом Отца.
    // Вес 10: первооснование, без которого нет последующих даров.
  }

  дар ДыханиеЖизни {
    от:       Отец
    кому:     ДушиЖивые
    тип:      presence
    вес:      9
    необратим: да
    // «И вдунул в лице его дыхание жизни, и стал человек душою живою» (Быт 2:7).
    // «Сам дая всему жизнь и дыхание и всё» (Деян 17:25).
    // «Всякое дыхание да хвалит Господа» (Пс 150:6).
    // נְשָׁמָה (нешама) — дыхание не как биологический акт, но как онтологический.
    // Дыхание — невидимое прикосновение Лица к лицу: вблизи, лицом к лицу.
    // Симеон Новый Богослов: единое дыхание Бога во всём живом.
    // Presence: дыхание есть самое интимное присутствие Отца в твари.
    // Вес 9: онтологически чуть ниже самого бытия, но не отделим от него.
  }

  дар БлагословениеПлодиться {
    от:       Отец
    кому:     ДушиЖивые
    тип:      word
    вес:      8
    необратим: да
    // «И благословил их Бог, говоря: плодитесь и размножайтесь,
    //  и наполняйте воды в морях, и птицы да размножаются на земле» (Быт 1:22).
    // Благословение — не пожелание, а слово, наделяющее силой.
    // Это первое библейское благословение — и оно обращено к рыбам и птицам,
    // прежде чем к человеку. ДушиЖивые получили дар самопродолжения как ответ.
    // Иоанн Златоуст, Беседы на Бытие X: благословение — это передача
    // силы творить новое, не своей силой, а силой Слова Отца.
    // Word: благословение — произнесённое слово, дающее способность множиться.
    // Вес 8: дар продолжения рода — продолжение творящего акта.
  }

  дар ПромыслОМалом {
    от:       Отец
    кому:     ДушиЖивые
    тип:      knowledge
    вес:      8
    необратим: да
    // «И ни одна из них не упадёт на землю без воли Отца вашего» (Мф 10:29).
    // «Я знаю всех птиц на горах, и животные на полях предо Мною» (Пс 49:11).
    // «И ни одна из них не забыта у Бога» (Лк 12:6).
    // Промысл — не общее провидение, а персональное знание каждой твари.
    // Иов 39: Отец знает время рождения серны, помнит вкусы дикого осла,
    // понимает безрассудство страуса, наделяет коня силой, орла — высотой.
    // Knowledge: каждое живое существо известно Отцу изнутри — по имени,
    // по логосу, по моменту его жизни и смерти.
    // Исаак Сирин: «У Бога нет малого творения» — даже воробей не мал в очах Отца.
    // Вес 8: знание Отцом твари — основание её достоинства перед Лицом.
  }

  дар ПрокормлениеТварей {
    от:       Отец
    кому:     ДушиЖивые
    тип:      time
    вес:      7
    необратим: да
    // «Очи всех на Тебя уповают, и Ты даёшь им пищу их в своё время» (Пс 144:15).
    // «Все они от Тебя ожидают, чтобы Ты дал им пищу их в своё время» (Пс 103:27).
    // «Кто приготовляет ворону корм его, когда птенцы его... бродят без пищи?» (Иов 38:41).
    // «Взгляните на птиц небесных: они не сеют, не жнут... и Отец ваш питает их» (Мф 6:26).
    // Прокормление — это дарение времени жизни через дарение пищи:
    // каждый день, в своё время, без перерыва.
    // Василий, Беседы VIII: «Не природа сама себя кормит, но Промысл кормит природу».
    // Time: пища — это время бытия, продлённое ещё на день, ещё на сезон.
    // Вес 7: ниже первотворения, но не менее непрерывен.
  }

  дар ЗаветСоВсякойДушой {
    от:       Отец
    кому:     ДушиЖивые
    тип:      word
    вес:      9
    необратим: да
    // «Вот, Я поставляю завет Мой с вами и с потомством вашим после вас,
    //  и со всякою душою живою, которая с вами, с птицами и со скотами,
    //  и со всеми животными земными, которые у вас» (Быт 9:9–10).
    // «Не будет более истреблена всякая плоть водами потопа» (Быт 9:11).
    // Единственный завет в Писании, явно заключённый не только с человеком,
    // но «со всякою душою живою». Радуга — знак завета не только для людей.
    // Завет означает: живые души — не объекты пользования, а партнёры Отца.
    // Их бытие защищено словом Отца от полного истребления.
    // Иоанн Златоуст, Беседы на Бытие XXVIII: «Завет с тварью свидетельствует,
    // что Бог любит не только разумных, но всё, что Им сотворено».
    // Word: завет — слово обещания и закона, произнесённое к живому.
    // Вес 9: завет — слово, тяжёлое как клятва Самого Себя.
  }
}
