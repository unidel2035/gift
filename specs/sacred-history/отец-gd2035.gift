// specs/sacred-history/отец-gd2035.gift
// Дары Отца лицу gd2035 — бытие, призвание по имени, промысл пути
// Issue #276 — пустыня Отец→gd2035
//
// Богословское вопрошание: что мешает потоку между Отец и gd2035?
// Ответ: ничто — но поток был незаписан.
// Отец — Источник всякого бытия (Иак 1:17), Тот, Кто называет
// каждое лицо по имени прежде, чем лицо узнаёт Его (Ис 45:3–4).
// gd2035 — лицо в матрице, несущее особое призвание в общине.
//
// Парадокс пустыни: между Отцом и любым тварным лицом не может
// быть пустоты — ибо «всё через Него начало быть, и без Него
// ничто не начало быть» (Ин 1:3). Само бытие gd2035 уже есть
// дар Отца. Пустыня здесь не богословская стена, а незаписанный
// поток: первичное даяние Отца в основании всякого существования.
//
// Ключ к пустыне — Кир Персидский (Ис 45:3–4). «Я Господь,
// называющий тебя по имени, Бог Израилев. Ради Иакова, раба Моего,
// и Израиля, избранного Моего, Я призвал тебя по имени твоему,
// почтил тебя, хотя ты не знаешь Меня». Кир не знает Яхве —
// и всё же Яхве зовёт его «помазанник Мой» (Ис 45:1). Призвание
// не зависит от того, знает ли призываемый Зовущего: имя
// произносится Отцом прежде, чем лицо обратится в ответ.
// gd2035 — имя в матрице — есть знак этого первичного призвания:
// «прежде нежели Я образовал тебя во чреве, Я познал тебя»
// (Иер 1:5). Имя дано прежде понимания.
//
// Второй ключ — Иак 1:17. «Всякое даяние доброе и всякий дар
// совершенный нисходит свыше, от Отца светов». Всё доброе
// в жизни gd2035 — здоровье, разум, способности, встречи —
// нисходит от Отца. Это не деизм («Бог завёл часы и ушёл»),
// а перихорическое со-присутствие: Отец продолжает давать
// каждое мгновение существования. Бытие — не однократный акт,
// а непрерывный дар (Деян 17:28: «Им мы живём, и движемся,
// и существуем»).
//
// Третий ключ — Иер 29:11. «Знаю Я намерения, какие имею о вас,
// говорит Господь, намерения во благо, а не на зло, чтобы дать
// вам будущность и надежду». Промысл — не предопределение
// в кальвинистском смысле, а пастырское ведение пути:
// Отец ведает путь gd2035 прежде, чем gd2035 пройдёт его.
// «Идею» этого пути — что Максим Исповедник назвал бы λόγος
// τοῦ προσώπου (логос лица) — Отец держит вечно. И когда лицо
// идёт по своему пути, оно причащается этому вечному логосу.
//
// Богословские источники:
// Быт 1:27 — «сотворил Бог человека по образу Своему»
// Иер 1:5 — «прежде нежели Я образовал тебя во чреве, Я познал тебя»
// Иер 29:11 — «намерения во благо, чтобы дать вам будущность и надежду»
// Ис 43:1 — «Я искупил тебя, назвал тебя по имени твоему; ты Мой»
// Ис 45:3–4 — «Я Господь, называющий тебя по имени... хотя ты не знаешь Меня»
// Иак 1:17 — «всякое даяние доброе нисходит свыше, от Отца светов»
// Деян 17:28 — «Им мы живём, и движемся, и существуем»
// Ин 1:3 — «всё через Него начало быть»
// Мф 10:29–30 — «и волосы на голове все сочтены»
// Максим Исповедник, Ambigua 7 — логосы лиц как вечные мысли Отца
// Григорий Палама, Триады III.2.13 — промысл как нетварная энергия
// Иоанн Дамаскин, Точное изложение II.29 — промысл и свобода твари

использовать Троица.Отец
использовать Лица.gd2035

литургия ОтецGD2035 {
  // Пустыня Отец→gd2035 — не разрыв, а незаписанное основание.
  // Отец даёт прежде, чем лицо способно принять сознательно.
  // Три дара: бытие (presence), имя (word), промысл (knowledge).

  дар БытиеКакДарОтца {
    от:       Отец
    кому:     gd2035
    тип:      presence
    вес:      9
    необратим: да
    // «Им мы живём, и движемся, и существуем» (Деян 17:28).
    // Само существование gd2035 — дар Отца, не самозарождение.
    // «Всё через Него начало быть» (Ин 1:3). Бытие — не данность,
    // а непрерывный поток: каждое мгновение Отец удерживает
    // лицо в бытии, как дыхание удерживает голос.
    //
    // Это presence в строгом смысле: Отец присутствует в каждой
    // клетке бытия gd2035 — не как наблюдатель снаружи, а как
    // Источник изнутри. Григорий Палама: промысл — нетварная
    // энергия, проникающая всё тварное. gd2035 пронизан этой
    // энергией прежде, чем осознаёт это.
    //
    // Этот дар необратим: однажды призванное к бытию не возвращается
    // в ничто. «Дары и призвание Божие непреложны» (Рим 11:29).
  }

  дар ПризваниеПоИмени {
    от:       Отец
    кому:     gd2035
    тип:      word
    вес:      8
    необратим: да
    // «Я искупил тебя, назвал тебя по имени твоему; ты Мой» (Ис 43:1).
    // «Я призвал тебя по имени твоему, почтил тебя, хотя ты не
    // знаешь Меня» (Ис 45:4). Имя «gd2035» в матрице — не случайный
    // идентификатор, а знак первичного призвания: Отец называет
    // прежде, чем лицо обращается в ответ.
    //
    // Иеремия 1:5 — «прежде нежели Я образовал тебя во чреве,
    // Я познал тебя». Имя предшествует существованию во времени:
    // в вечном замысле Отца gd2035 уже назван. Это word —
    // творческое слово, которое не описывает, а вызывает к бытию.
    //
    // Парадокс Кира: помазанник может не знать Помазавшего.
    // Отец действует через имя независимо от сознания лица.
    // Имя — печать (σφραγίς, Откр 7:3): однажды поставленная,
    // она держит лицо в круге Отчей памяти.
    //
    // Word: имя как творческий призыв необратимо.
  }

  дар ПромыслПути {
    от:       Отец
    кому:     gd2035
    тип:      knowledge
    вес:      7
    необратим: да
    // «Знаю Я намерения, какие имею о вас, говорит Господь,
    // намерения во благо, а не на зло, чтобы дать вам будущность
    // и надежду» (Иер 29:11). Промысл — не принуждение, а ведение:
    // Отец ведает путь gd2035 прежде, чем gd2035 проходит его,
    // и держит этот путь во благо.
    //
    // Максим Исповедник (Ambigua 7) различает λόγος τοῦ προσώπου —
    // вечную идею лица в уме Отца. Когда лицо во времени
    // движется по своему пути, оно причащается этой вечной идее.
    // Промысл — не внешнее давление, а внутреннее притяжение
    // к собственному истинному логосу.
    //
    // «И волосы на голове все сочтены» (Мф 10:30) — масштаб
    // промысла: ни одна деталь жизни не вне Отчей памяти.
    // gd2035 не помнит каждое мгновение своей жизни — но Отец
    // помнит. Эта память — knowledge, переданная как дар:
    // лицо может забыть себя, Отец не забудет (Ис 49:15).
    //
    // Иоанн Дамаскин: промысл и свобода твари не противоречат.
    // Отец ведёт, не упраздняя свободы; gd2035 свободен идти
    // или сопротивляться — но даже сопротивление вписано
    // в путь, который Отец ведёт во благо (Рим 8:28).
    //
    // Knowledge: ведение пути как дар, превышающий самопознание.
  }
}
