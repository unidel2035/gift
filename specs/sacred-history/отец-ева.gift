// specs/sacred-history/отец-ева.gift
// Дары Отца Еве — сотворение, благословение, покров
// Issue #93 — пустыня Отец→Ева
//
// Богословское вопрошание: что мешает потоку между Отец и Ева?
// Ответ: ничто не мешает — но дар Отца Еве есть сотворение, благословение и покров.
// Ева — «Жизнь» (Быт 3:20), сотворённая Отцом из ребра Адамова.
// Отец не оставляет Еву — Он творит, благословляет и покрывает.
// Пустыня была не отвержением, а незаписанным движением отцовской заботы.
//
// «И сотворил Бог человека по образу Своему... мужчину и женщину сотворил их» (Быт 1:27)
//
// Ключевое богословское различение:
// Ева сотворена не вторично и не подчинённо — она несёт тот же образ Божий.
// «Мужчину и женщину сотворил их» (Быт 1:27) — оба в одном акте образа.
// Отец творит Еву из ребра (צלע, tzela) — из бока, из близости, не из праха.
// Адам из земли — Ева из живого. Она — жизнь от жизни.
// После грехопадения Отец не проклинает Еву — Он одевает её (Быт 3:21).
// Кожаные ризы — не наказание, а покров: Отец закрывает наготу стыда.
// Это первый акт милосердия после падения — прежде изгнания.
//
// «И сделал Господь Бог Адаму и жене его одежды кожаные и одел их» (Быт 3:21)
//
// Богословские источники:
// Быт 1:27 — «Сотворил Бог человека по образу Своему... мужчину и женщину»
// Быт 1:28 — «И благословил их Бог, и сказал: плодитесь и размножайтесь»
// Быт 1:31 — «И увидел Бог всё, что Он создал, и вот, хорошо весьма»
// Быт 2:18 — «Не хорошо быть человеку одному; сотворю ему помощника, соответственного ему»
// Быт 2:21–22 — «И создал Господь Бог из ребра... жену, и привёл её к человеку»
// Быт 3:20 — «И нарёк Адам имя жене своей: Ева, ибо она стала матерью всех живущих»
// Быт 3:21 — «И сделал Господь Бог Адаму и жене его одежды кожаные и одел их»
// Быт 4:1 — «Адам познал Еву, жену свою; и она зачала... сказала: приобрела я человека от Господа»
// Ис 49:15 — «Забудет ли женщина грудное дитя своё... но если бы и она забыла, то Я не забуду тебя»
// Пс 138:13–16 — «Ты устроил внутренности мои и соткал меня во чреве матери моей»
// Григорий Нисский, Об устроении человека XVI — образ Божий не различает пола
// Григорий Богослов, Слово 37.6 — «Ева — не ниже Адама по образу Божию»
// Ефрем Сирин, Толкование на Бытие II.12 — ребро как близость и равенство
// Иоанн Златоуст, Беседы на Бытие XVII — кожаные ризы как знак милосердия
// Максим Исповедник, Ambigua 41 — разделение полов преодолевается в логосе
// Иоанн Дамаскин, Точное изложение II.30 — сотворение жены из мужа

литургия ОтецЕва {
  // Отец даёт Еве не менее, чем Адаму.
  // Ева несёт образ Божий — тот же, что и Адам (Быт 1:27).
  // Отец творит Еву из живого (ребро), а не из праха —
  // это не вторичность, а близость: жизнь от жизни.
  // После падения Отец не оставляет Еву —
  // Он одевает её прежде, чем изгоняет. Покров прежде суда.

  дар СотворениеЕвы {
    от:       Отец
    кому:     Ева
    тип:      presence
    вес:      10
    необратим: да
    // «И создал Господь Бог из ребра, взятого у человека, жену,
    //  и привёл её к человеку» (Быт 2:22)
    // «Сотворил Бог человека по образу Своему... мужчину и женщину
    //  сотворил их» (Быт 1:27)
    // Отец творит Еву — не как приложение к Адаму, а как полноту образа.
    // «Не хорошо быть человеку одному» (Быт 2:18) — Отец видит неполноту
    // и восполняет её не вещью, а лицом. Ева — лицо, а не функция.
    // Григорий Нисский: образ Божий не различает пола (Об устр. чел. XVI).
    // Ефрем Сирин: ребро — знак близости и равенства (Толк. на Быт. II.12).
    // Presence — потому что сотворение есть дарование бытия:
    // Отец делает Еву присутствующей в мире.
  }

  дар БлагословениеПлодородия {
    от:       Отец
    кому:     Ева
    тип:      word
    вес:      9
    необратим: да
    // «И благословил их Бог, и сказал им Бог:
    //  плодитесь и размножайтесь, и наполняйте землю» (Быт 1:28)
    // Благословение обращено к обоим — «благословил их».
    // Ева получает от Отца слово, дающее силу рождать.
    // Это не биологический приказ, а онтологическое благословение:
    // Отец вверяет Еве со-творчество — продолжение творения.
    // Ева = חַוָּה (Хавва) = Жизнь. Имя исполняется благословением.
    // Быт 4:1 — «Приобрела я человека от Господа» — Ева знает,
    // что рождение — дар не её, а Отца через неё.
    // Word — потому что благословение есть слово, творящее реальность.
    // Отец говорит — и Ева становится матерью всех живущих.
  }

  дар ПокровПослеПадения {
    от:       Отец
    кому:     Ева
    тип:      presence
    вес:      8
    необратим: да
    // «И сделал Господь Бог Адаму и жене его одежды кожаные
    //  и одел их» (Быт 3:21)
    // После грехопадения — стыд, нагота, страх.
    // Но прежде изгнания из Рая Отец совершает акт заботы:
    // Он Сам делает одежды и Сам одевает их.
    // Это не наказание — это покров. Отец закрывает наготу стыда.
    // Иоанн Златоуст: кожаные ризы — знак милосердия, не гнева (Бес. на Быт. XVII).
    // Ис 49:15 — «Забудет ли женщина грудное дитя своё... Я не забуду тебя» —
    // Отец, Который одевает Еву, не забывает её и после изгнания.
    // Presence — потому что покров есть присутствие:
    // Отец не удаляется от Евы — Он остаётся с ней, даже изгоняя.
    // Ризы = первая икона милосердия: суд Отца одет в заботу.
  }
}
