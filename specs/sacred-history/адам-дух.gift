// specs/sacred-history/адам-дух.gift
// Дары Адама Духу — имянование, слёзы, возвращённое дыхание, стенания ожидания
// Issue #231 — пустыня Адам→Дух
//
// Богословское вопрошание: что мешает потоку между Адам и Дух?
// Ответ: ничто — пустыня была не разрывом, а ожиданием.
// «Дух ходатайствует о нас воздыханиями неизреченными» (Рим 8:26) —
// но ходатайствует Он изнутри Адама: стенаниями самого Адама.
// Пустыня Адам→Дух — это пустыня, в которой уже звучит молитва,
// только не расслышанная матрицей.
//
// Матрица W знает Дух→Адам (дыхание жизни, оживление, ходатайство).
// Обратный поток — Адам→Дух — не менее реален и не менее необратим.
// Каждое дыхание Адама — возврат дыхания, данного в Быт 2:7.
// Каждое имя, данное твари, — слово в Духе. Каждая слеза покаяния —
// материал ходатайства. Каждое стенание — воздыхание Духа в Адаме.
//
// Парадокс: Дух даёт, и Дух же принимает принесённое.
// Это не бухгалтерия, а перихоресис: движение Духа через Адама
// обратно к Себе — через тварь, которую Дух оживил.
// «Дух возвратится к Богу, Который дал его» (Еккл 12:7) —
// возврат не прерывает связь, а завершает круг дарения.
//
// Адам — אדם (земля, прах). Дух — רוח (дыхание, ветер).
// Без Духа Адам — прах. Но и Дух без Адама — не имеет того,
// в ком Он оживотворяет прах. Адам — место, где Дух совершает дело.
// Когда Адам молится, плачет, именует, дышит — Дух принимает
// в этом не «дары твари», а Своё собственное действие,
// вернувшееся через лицо.
//
// Богословские источники:
// Быт 2:7 — «вдунул в лице его дыхание жизни (נשמת חיים)»
// Быт 2:19–20 — «нарёк имена всем животным» — имянование в Духе
// Быт 3:19 — «прах ты, и в прах возвратишься» — возврат тела
// Еккл 12:7 — «и возвратится прах в землю, а дух возвратится к Богу»
// Пс 50:13 — «Духа Твоего Святаго не отыми от мене»
// Пс 50:19 — «жертва Богу — дух сокрушённый»
// Рим 8:22–23 — «вся тварь совокупно стенает... и мы сами стенаем»
// Рим 8:26 — «Дух ходатайствует воздыханиями неизреченными»
// Откр 22:17 — «И Дух и невеста говорят: прииди!»
// Ефрем Сирин, О покаянии — «плач Адама у врат Эдема»
// Василий Великий, Беседы на Шестоднев IX — «Адам получил
//   пророческую способность именования от Духа»
// Григорий Нисский, О сотворении человека XI — «имя раскрывает
//   логос твари — это дело Духа через Адама»
// Максим Исповедник, Ambigua 7 — логосы твари возвращаются
//   к Логосу через лица, причастные Духу
// Симеон Новый Богослов, Гимн 17 — «слёзы — вторая купель,
//   и в них действует тот же Дух, что и в водах крещения»
// Исаак Сирин, Слово 21 — «воздыхание сердца есть молитва Духа»

использовать Троица.Дух
использовать Шестоднев.Адам

литургия АдамДух {
  // Пустыня Адам→Дух была не разрывом, а незаписанным ожиданием.
  // Дух «ходатайствует» внутри Адама — и это ходатайство
  // начинается там, где Адам стенает, именует, плачет, дышит.
  // Каждое из этих действий — возврат Духу того, что Дух дал.

  дар ИмянованиеТвари {
    от:       Адам
    кому:     Дух
    тип:      word
    вес:      9
    необратим: да
    // «И привёл [Господь Бог] к человеку, чтобы видеть, как он назовёт их,
    //  и чтобы, как наречёт человек всякую душу живую, так и было имя ей» (Быт 2:19)
    // Имянование — не произвол, а пророческое действие: Адам
    // открывает логос твари. Василий Великий: эта способность —
    // дар Духа (Беседы на Шестоднев IX). Григорий Нисский:
    // имя раскрывает сущность, и раскрывается оно через Духа,
    // Который «всё проницает» (1 Кор 2:10).
    // Word: именно слово — ибо имя есть слово.
    // Адам возвращает Духу Его же энергию — именем.
    // Максим Исповедник: логосы твари возвращаются к Логосу
    // через причастные Духу лица (Ambigua 7).
  }

  дар ПокаянныеСлёзы {
    от:       Адам
    кому:     Дух
    тип:      presence
    вес:      8
    необратим: да
    // «Жертва Богу — дух сокрушённый; сердца сокрушённого
    //  и смиренного Ты не презришь, Боже» (Пс 50:19)
    // Ефрем Сирин воспевает плач Адама у врат Эдема:
    // это не отчаяние, а первое приношение падшего Духу.
    // Симеон Новый Богослов: «слёзы — вторая купель,
    // и в них действует тот же Дух, что и в водах крещения» (Гимн 17).
    // Presence: слёзы — физическое присутствие покаяния,
    // вода, в которой Дух обитает, как некогда над водами творения (Быт 1:2).
    // Адам не произносит слов — он плачет. И этот плач
    // Дух принимает как воздыхание (Рим 8:26).
    // Вес 8: покаяние — дар, равный дыханию, ибо оно восстанавливает то,
    // что нарушилось в Адаме после падения.
  }

  дар ДыханиеВозвращаемое {
    от:       Адам
    кому:     Дух
    тип:      time
    вес:      10
    необратим: да
    // «И возвратится прах в землю, чем он и был;
    //  а дух возвратится к Богу, Который дал его» (Еккл 12:7)
    // Каждое дыхание Адама — микрокосм этого возврата.
    // Дух вошёл в прах (Быт 2:7) — и выходит с каждым выдохом,
    // возвращаясь к Источнику. Но возвращение не прерывает связь:
    // следующий вдох — новое вхождение. Пока Адам дышит,
    // Дух совершает этот круг: даёт — принимает — даёт снова.
    // Time: вес 10 — ибо время дыхания есть время самой жизни.
    // Последний выдох Адама — как последний выдох Христа на Кресте:
    // «Отче, в руки Твои предаю дух Мой» (Лк 23:46) — дух возвращается.
    // Этот дар — самый тяжёлый: он не разовый акт, а вся жизнь Адама
    // как непрерывный литургический возврат Духу.
  }

  дар СтенанияОжидания {
    от:       Адам
    кому:     Дух
    тип:      word
    вес:      8
    необратим: да
    // «Ибо знаем, что вся тварь совокупно стенает и мучится доныне;
    //  и не только она, но и мы сами, имея начаток Духа,
    //  и мы в себе стенаем, ожидая усыновления» (Рим 8:22–23)
    // Адам — начаток стенающей твари. Его ожидание — это то,
    // из чего Дух делает Своё ходатайство «воздыханиями неизреченными»
    // (Рим 8:26). Стенание не есть жалоба: это речь, превышающая слова,
    // говорящая изнутри боли.
    // Word: стенание — это слово-прежде-слова, Праязык, на котором
    // тварь говорит с Богом, когда привычных слов не хватает.
    // Исаак Сирин: «воздыхание сердца есть молитва Духа» (Слово 21).
    // Откр 22:17: «И Дух и невеста говорят: прииди!» —
    // двуединый возглас, в котором не различишь, где Дух, где тварь.
    // Это и есть поток Адам→Дух в его эсхатологической полноте.
  }
}
