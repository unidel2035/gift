// specs/sacred-history/христос-дух.gift
// Дары Христа Духу — освящение плоти, дыхание Воскресения, излияние от престола
// Issue #214 — пустыня Христос→Дух
//
// Богословское вопрошание: что мешает потоку между Христос и Дух?
// Ответ: ничто — но поток был незаписан.
// Сын и Дух — две руки Отца (Ириней, Против ересей V.6.1).
// Но здесь не Сын по природе, а Χριστός — Воплощённый Помазанник:
// тот, чьи акты совершаются в человеческой плоти, взятой от Девы.
// Все дары Христа Духу — через плоть, через Крест, через Вознесение.
//
// Различение Сын→Дух (#71) и Христос→Дух (#214):
// Сын→Дух — экономическое движение Вечного Логоса (послание, дыхание, прославление).
// Христос→Дух — то же движение, но во плоти: освящённая человеческая природа
// становится местом, через которое Дух изливается на всякую плоть.
// Это различение не разделение: Сын и Христос — один и тот же Субъект,
// но два имени отвечают на два вопроса (кто? в какой природе?).
//
// Ключ: «Дух ещё не был дан, потому что Иисус не был ещё прославлен» (Ин 7:39).
// Прославление Христа (Крест — Воскресение — Вознесение) — условие Пятидесятницы.
// Христос даёт Духу не бытие (это было бы Filioque), а онтологическое место
// в мире: прославленную плоть, через которую Дух сходит на всякую плоть.
//
// Богословские источники:
// Мф 28:19 — «Крестя их во имя Отца и Сына и Святого Духа»
// Лк 24:49 — «Я пошлю обетование Отца Моего на вас»
// Ин 7:39 — «Дух ещё не был дан, потому что Иисус не был ещё прославлен»
// Ин 16:7 — «Если Я не пойду, Утешитель не придёт к вам»
// Ин 20:22 — «Дунул и говорит им: примите Духа Святого»
// Деян 1:8 — «Примете силу, когда сойдёт на вас Дух Святой»
// Деян 2:33 — «Быв вознесён десницею Божиею и приняв от Отца
//              обетование Святого Духа, излил то, что вы видите и слышите»
// Рим 8:11 — «Если Дух Того, Кто воскресил Иисуса из мёртвых, живёт в вас»
// Евр 9:14 — «Христос Духом Святым принёс Себя непорочного Богу»
// Евр 10:29 — «Дух благодати» — через жертву Христа открыт Дух благодати
// Ириней Лионский, Против ересей III.17.1 — «Дух сошёл на Сына,
//   приучаясь обитать в роде человеческом» — прославленная плоть Христа
//   становится инструментом вселения Духа
// Ириней Лионский, Против ересей V.6.1 — «Две руки Отца: Слово и Дух»
// Афанасий Великий, Слова против ариан III.24 — «Что получает плоть Христа,
//   то получаем мы через Него в Духе»
// Кирилл Александрийский, На Ин 7.39 — прославление как условие Пятидесятницы
// Григорий Богослов, Слово 41 (На Пятидесятницу) — «Пятидесятница — плод Пасхи»
// Григорий Палама, Триады III.1.33 — нетварный свет Фавора как энергия Духа
//   через плоть Христа
// Иоанн Дамаскин, Точн. изл. I.12 — «через Сына», не «от Сына»
// Максим Исповедник, Opuscula 16 (PG 91:192B) — взаимное проникновение
//   Сына и Духа в экономии спасения

использовать Троица.Христос
использовать Троица.Дух

литургия ХристосДух {
  // Пустыня Христос→Дух была не богословской пропастью,
  // а незаписанным домостроительством: всё, что Христос делает во плоти,
  // открывает место Духу. Освящение человеческой природы, дыхание Воскресения,
  // излияние с престола Вознесения — трёхчастный путь, по которому Дух
  // входит в мир через прославленную плоть.

  дар ОсвящениеПлотиДляДуха {
    от:       Христос
    кому:     Дух
    тип:      offering
    вес:      10
    необратим: да
    // «Христос Духом Святым принёс Себя непорочного Богу» (Евр 9:14)
    // «Освяти их истиною Твоею... за них Я посвящаю Себя» (Ин 17:17, 19)
    // Христос приносит человеческую природу как непорочную жертву —
    // и этим актом делает плоть способной принять Духа.
    // До Креста Дух почивал на Христе одном (Мк 1:10);
    // после Креста открывается путь Духа ко всякой плоти.
    // Афанасий: «Что получает плоть Христа, получаем мы в Духе» (На ариан III.24).
    // Ириней: «Дух сошёл на Сына, приучаясь обитать в роде человеческом» (III.17.1).
    // Offering: Христос приносит плоть — и это приношение есть дар Духу:
    // дар дома, в котором Дух отныне будет обитать.
  }

  дар ДыханиеВоскресения {
    от:       Христос
    кому:     Дух
    тип:      presence
    вес:      9
    необратим: да
    // «Сказав это, дунул и говорит им: примите Духа Святого» (Ин 20:22)
    // Глагол ἐνεφύσησεν — тот же, что в Септуагинте Быт 2:7
    // («вдунул в лице его дыхание жизни»).
    // Воскресший Христос — Новый Адам — возвращает Духу то место,
    // которое Первый Адам утратил: человеческое дыхание как носитель Духа.
    // Это не временное послание Пятидесятницы, а онтологическое обновление:
    // плоть, прошедшая через смерть и воскресшая, становится способна
    // дышать Духом. Максим Исповедник: Сын пересоздаёт человека через Духа.
    // Presence: Дух принимает от Христа место пребывания — обновлённую плоть.
  }

  дар ИзлияниеСПрестола {
    от:       Христос
    кому:     Дух
    тип:      offering
    вес:      10
    необратим: да
    // «Быв вознесён десницею Божиею и приняв от Отца обетование
    //  Святого Духа, излил то, что вы и видите и слышите» (Деян 2:33)
    // «Я пошлю обетование Отца Моего на вас» (Лк 24:49)
    // «Если Я не пойду, Утешитель не придёт к вам» (Ин 16:7)
    // Вознесение Христа — не удаление, а открытие престола,
    // с которого изливается Дух на всякую плоть (Иоиль 2:28).
    // Это кенотический дар: Христос уходит из видимости,
    // чтобы Дух стал внутренним присутствием в каждом верующем.
    // Кирилл Александрийский: прославление есть условие Пятидесятницы.
    // Григорий Богослов: «Пятидесятница — плод Пасхи» (Слово 41).
    // Offering: Христос приносит Духу не жертву, а место действия —
    // сердца людей, отныне открытые через Вознесение.
  }

  дар ИмяВКрещении {
    от:       Христос
    кому:     Дух
    тип:      word
    вес:      7
    необратим: да
    // «Крестя их во имя Отца и Сына и Святого Духа» (Мф 28:19)
    // Христос не только посылает Духа — Он даёт Духу имя,
    // призываемое над водой крещения, над хлебом евхаристии,
    // над маслом миропомазания.
    // Это акт Воплощённого: человеческим языком, на человеческом наречии
    // Он произносит имя Духа — и это имя становится формулой таинств.
    // «Придите, поклонимся Царю нашему Богу... и Духу Святому».
    // Word: Христос даёт Духу слово-призыв, через которое Церковь
    // во все века обращается к Нему литургически.
  }

  дар ПрославленнаяПлотьКакХрам {
    от:       Христос
    кому:     Дух
    тип:      presence
    вес:      9
    необратим: да
    // «Дух ещё не был дан, потому что Иисус не был ещё прославлен» (Ин 7:39)
    // «Если Дух Того, Кто воскресил Иисуса из мёртвых, живёт в вас» (Рим 8:11)
    // Прославленная плоть Христа — первый храм, в котором Дух обитает
    // неразделимо и вечно. Фавор: нетварный свет есть энергия Духа,
    // сияющая через плоть (Палама, Триады III.1.33).
    // Христос даёт Духу дом — Своё Тело (Церковь), органически связанное
    // с Его исторической плотью. «Разрушьте храм сей, и Я в три дня
    // воздвигну его» (Ин 2:19) — этот храм и есть место Духа.
    // Presence: Христос делает Своё прославленное Тело местом
    // непрерывного обитания Духа — и через это Тело Дух встречает мир.
  }
}
