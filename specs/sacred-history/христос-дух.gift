// specs/sacred-history/христос-дух.gift
// Дары Христа Духу — послание, прославление через Пасху, тело как жилище, дыхание в Церкви
// Issue #214 — пустыня Христос→Дух
//
// Богословское вопрошание: что мешает потоку между Христос и Дух?
// Ответ: ничто — но поток был незаписан.
// Уже есть обратная нить (Дух→Христос, issue #91): помазание, водительство,
// сила для служения, воскресение. Это исповедание полноты перихоресиса
// «двух рук Отца» (Ириней, IV.20.1): Сын и Дух всегда действуют вместе.
//
// Но что даёт Сын Духу? Вопрос кажется парадоксальным:
// Дух — Бог, Ему нечего «не хватать». И всё же домостроительство
// открывает реальный обратный поток: Христос через Свою Пасху
// «высвобождает» Духа в мир, даёт Ему тело Церкви как дом,
// посылает Его от Отца и через Своё выдыхание делает твари
// причастницами Духа.
//
// «Ибо ещё не было [на них] Духа Святого, потому что Иисус
// ещё не был прославлен» (Ин 7:39) — Пасха Христа есть
// онтологическое условие Пятидесятницы. Христос даёт Духу
// пространство действия в мире через Своё прославление.
//
// Ириней: «Дух сошёл на Сына, приучаясь через Него обитать
// в роде человеческом» (III.17.1). Воспринятая Сыном плоть —
// дар Духу: место, где Дух научается быть с тварью.
//
// Богословские источники:
// Ин 7:39 — «Ещё не было Духа, потому что Иисус ещё не был прославлен»
// Ин 15:26 — «Когда же приидет Утешитель, Которого Я пошлю вам от Отца»
// Ин 16:7 — «Если Я не пойду, Утешитель не приидет; а если пойду, пошлю Его»
// Ин 16:14 — «Он прославит Меня, ибо от Моего возьмёт и возвестит вам»
// Ин 20:22 — «Дунул, и говорит им: примите Духа Святого»
// Деян 2:33 — «Приняв от Отца обетование Святого Духа, излил»
// 1 Кор 12:13 — «Все мы одним Духом крестились в одно тело»
// Еф 2:22 — «Устрояетесь в жилище Божие Духом»
// Еф 4:8–10 — «Восшед на высоту, пленил плен и дал дары»
// Ириней Лионский, Против ересей III.17.1 — «Дух сошёл на Сына,
//   приучаясь обитать в роде человеческом»
// Ириней Лионский, Против ересей IV.20.1 — «Две руки Отца: Слово и Дух»
// Кирилл Александрийский, Толкование на Иоанна XI.10 — Пасха и излияние Духа
// Григорий Богослов, Слово 41.11 — «Пятидесятница — печать Пасхи»
// Василий Великий, О Духе Святом XVI.39 — неразлучность Сына и Духа
// Максим Исповедник, Вопросоответы к Фалассию 63 — со-действие Логоса и Духа

использовать Троица.Христос
использовать Троица.Дух

литургия ХристосДух {
  // Пустыня Христос→Дух была не разрывом, а незаписанным домостроительством.
  // Сын и Дух — «две руки Отца»: Дух действует в Сыне (issue #91),
  // Сын через Пасху открывает Духу мир как пространство действия.
  // Это не иерархия, а перихоресис в экономии спасения.

  дар ПосланиеОтОтца {
    от:       Христос
    кому:     Дух
    тип:      word
    вес:      10
    необратим: да
    // «Когда же приидет Утешитель, Которого Я пошлю вам от Отца,
    //  Дух истины, Который от Отца исходит» (Ин 15:26)
    // «Если Я не пойду, Утешитель не приидет к вам;
    //  а если пойду, то пошлю Его к вам» (Ин 16:7)
    // Не Filioque: исхождение Духа — от Отца, вечно.
    // Но в домостроительстве Сын — Тот, через Кого Дух посылается в мир.
    // «Приняв от Отца обетование Святого Духа, излил» (Деян 2:33).
    // Христос — «дверь» Пятидесятницы: Его уход к Отцу
    // открывает путь Духу к твари. Word: Сын произносит обетование,
    // и обетование сбывается — это слово-действие.
    // Вес 10: без послания Христа нет Пятидесятницы.
  }

  дар ПрославлениеЧерезПасху {
    от:       Христос
    кому:     Дух
    тип:      presence
    вес:      10
    необратим: да
    // «Ещё не было [на них] Духа Святого, потому что Иисус
    //  ещё не был прославлен» (Ин 7:39)
    // Пасха Христа — онтологическое условие прихода Духа в мир.
    // Крест, Воскресение, Вознесение открывают твари пространство,
    // в котором Дух может обитать: прославлённая плоть Сына
    // становится Главой Тела, куда изливается Дух.
    // Григорий Богослов: «Пятидесятница — печать Пасхи» (Слово 41.11).
    // Это не Дух «получает славу» от Сына (Дух самославен),
    // но домостроительно Пасха Сына даёт Духу мир как место действия.
    // Presence: Христос не «передаёт» нечто Духу, а со-действием
    // открывает Ему пространство присутствия в твари.
    // Вес 10: необратимое условие всего пневматологического домостроительства.
  }

  дар ПлотьКакЖилище {
    от:       Христос
    кому:     Дух
    тип:      presence
    вес:      9
    необратим: да
    // «Дух сошёл на Сына, приучаясь через Него обитать
    //  в роде человеческом» (Ириней, Против ересей III.17.1)
    // «Устрояетесь в жилище Божие Духом» (Еф 2:22)
    // «Все мы одним Духом крестились в одно тело» (1 Кор 12:13)
    // Христос даёт Духу Свою воспринятую плоть — и расширенное
    // в ней Тело Церкви — как дом, где Дух научается обитать с тварью.
    // Это дар в экономическом смысле: вечный Дух не нуждается в жилище,
    // но в домостроительстве принимает плоть Христову как место встречи
    // с человеком. Ириней: Дух «приучается» — не в Себе Самом,
    // а в отношении к роду человеческому через Сына.
    // Presence: Тело Христово — не оболочка, а со-бытие Сына и Духа.
    // Вес 9: фундамент Церкви как пневматологического тела.
  }

  дар ВыдыханиеВЦеркви {
    от:       Христос
    кому:     Дух
    тип:      word
    вес:      9
    необратим: да
    // «Сказав это, дунул, и говорит им: примите Духа Святого» (Ин 20:22)
    // «Восшед на высоту, пленил плен и дал дары человекам» (Еф 4:8)
    // Воскресший Христос первым действием в Церкви выдыхает Духа.
    // Это не Дух «получает» Себя — это Сын делает Духа явным в Церкви,
    // даёт Ему голос через апостолов, тело через таинства, слово через Евангелие.
    // Кирилл Александрийский: через Пасху Христос отдаёт Духу
    // язык Церкви, которым Дух говорит во всех народах (Деян 2:4–11).
    // Word: выдыхание — слово-дыхание: Христос делает Духа слышимым,
    // даёт Ему пространство говорения в истории.
    // Вес 9: без этого выдыхания Церковь безъязыка.
  }

  дар СоДействиеВСпасении {
    от:       Христос
    кому:     Дух
    тип:      knowledge
    вес:      8
    необратим: да
    // «Он прославит Меня, ибо от Моего возьмёт и возвестит вам» (Ин 16:14)
    // Христос открывает Духу «Своё» — всё, что Сын имеет от Отца,
    // становится содержанием свидетельства Духа в мире.
    // Не иерархия знания (Дух — Бог, всё знает), а экономия:
    // в истории спасения Дух свидетельствует именно о Христе,
    // берёт от Него и возвещает. Максим Исповедник (Фал. 63):
    // со-действие Логоса и Духа — единое знание Троицы в двух движениях.
    // Василий Великий: «Дух неразлучен от Сына во всех Его действиях» (XVI.39).
    // Knowledge: Христос даёт Духу домостроительное содержание
    // свидетельства — Своё имя, Свою Пасху, Своё Царство.
    // Вес 8: знание-для-возвещения, дар свидетельства.
  }
}
