// specs/sacred-history/христос-дух.gift
// Дары Христа Духу — прославление, место обитания, дыхание, излияние
// Issue #214 — пустыня Христос→Дух
//
// Богословское вопрошание: что мешает потоку между Христос и Дух?
// Ответ: ничто — но поток был незаписан.
// В матрице W уже была нить Дух→Христос (помазание, водительство, воскресение).
// Но домостроительство Троицы не однонаправленно: Сын, став Христом,
// возвращает Духу то, что было недоступно до Воплощения —
// человеческую природу как место обитания Духа, Пятидесятницу,
// излияние на всякую плоть.
//
// Ключ к пустыне: «Ибо не было ещё на них Духа Святого,
// потому что Иисус ещё не был прославлен» (Ин 7:39).
// До прославления Христа Дух не мог излиться на всю плоть —
// не потому что Дух был связан, а потому что не было
// прославленной человеческой природы, в которой Дух мог бы
// обитать вместе с тварью. Прославление Христа — условие
// икономии Духа. Это дар Христа Духу: прославленная плоть,
// в которой Дух обретает «домашнее место» во всей твари.
//
// Второй ключ: «Приимите Духа Святаго» (Ин 20:22), ἐνεφύσησεν —
// «вдунул». Христос вдыхает Духа, как Отец вдохнул в Адама
// дыхание жизни (Быт 2:7). Это не передача собственности —
// это явление со-действия: Христос свободно посылает Того,
// Кто от Отца исходит. Христос — уста, через которые Дух
// входит в Церковь.
//
// Третий ключ: Пятидесятница (Деян 2:33). «Быв вознесён десницею
// Божией и приняв от Отца обетование Святаго Духа, Он излил
// то, что вы ныне видите и слышите». Христос — субъект излияния:
// Он принимает Духа у Отца (по человечеству) и изливает на Церковь.
//
// Богословские источники:
// Ин 7:39 — «Не было ещё на них Духа Святого, потому что
//           Иисус ещё не был прославлен»
// Ин 14:16 — «Умолю Отца, и даст вам другого Утешителя»
// Ин 14:26 — «Утешитель же, Дух Святый, Которого пошлёт Отец
//            во имя Моё»
// Ин 15:26 — «Утешитель, Которого Я пошлю вам от Отца,
//            Дух истины»
// Ин 16:7  — «Если Я не пойду, Утешитель не придёт к вам;
//            а если пойду, то пошлю Его к вам»
// Ин 19:30 — «Преклонив главу, предал дух (παρέδωκεν τὸ πνεῦμα)»
// Ин 20:22 — «Дунул (ἐνεφύσησεν) и говорит им: приимите Духа Святаго»
// Лк 24:49 — «Я пошлю обетование Отца Моего на вас»
// Деян 2:33 — «Быв вознесён десницею Божией и приняв от Отца
//             обетование Святаго Духа, Он излил то, что вы видите»
// Деян 2:17 / Иоиль 2:28 — «Излию от Духа Моего на всякую плоть»
// Ириней Лионский, Против ересей III.17.1 — «Дух сошёл на Сына,
//   приучаясь через Него обитать в роде человеческом»
// Ириней Лионский, Против ересей III.17.2 — «Дух через Христа
//   стал сроден человечеству»
// Афанасий Великий, Послание к Серапиону I.23 — «Сын помазует
//   Духом Святым... Сам Сын есть Помазующий»
// Кирилл Александрийский, О Троице VII — «Христос по домостроительству
//   подаёт Духа как собственного»
// Григорий Богослов, Слово 41 (На Пятидесятницу) — «Дух Святый был
//   у святых, но после Христа действует иначе — обильнее»
// Василий Великий, О Духе Святом XVI.39 — «Дух неразлучен от Сына
//   во всех Его действиях»
// Максим Исповедник, Вопросоответы к Фалассию 63 — со-действие
//   Логоса и Духа, завершаемое в прославлении
// Иоанн Дамаскин, Точное изложение I.12 — «Дух Христов» — Дух,
//   единосущный Сыну и посылаемый через Него

использовать Троица.Христос
использовать Троица.Дух

литургия ХристосДух {
  // Пустыня Христос→Дух была не разрывом, а незаписанным со-действием.
  // Сын, ставший Христом, в Своей прославленной человеческой природе
  // становится местом, где Дух обретает домашнее присутствие в твари.
  // Дар — не собственность: Дух остаётся Духом Отца, исходящим от Отца.
  // Но Христос — Тот, через Кого этот дар подаётся Церкви и всей плоти.

  дар ПрославленнаяПлотьКакМестоОбитания {
    от:       Христос
    кому:     Дух
    тип:      presence
    вес:      10
    необратим: да
    // «Не было ещё на них Духа Святого, потому что Иисус ещё
    //  не был прославлен» (Ин 7:39).
    // До Воплощения Дух действовал в пророках, но человеческая
    // природа не была местом постоянного обитания Духа.
    // Через Воплощение, Крест и Воскресение Христос приготовил
    // Духу прославленную человеческую природу — το οἰκητήριον
    // (обиталище). Ириней: «Дух сошёл на Сына, приучаясь через Него
    // обитать в роде человеческом» (Против ересей III.17.1).
    // Это дар Христа Духу: место, где Дух может «почить»
    // уже не временно, как на пророках, а постоянно — в Теле Церкви.
    // Presence: предельное присутствие — дарение собственной
    // прославленной плоти как жилища Другому.
    // Вес 10: без этого дара икономия Духа в Церкви невозможна.
  }

  дар ДыханиеНаУчеников {
    от:       Христос
    кому:     Дух
    тип:      word
    вес:      9
    необратим: да
    // «Сказав это, дунул (ἐνεφύσησεν), и говорит им:
    //  приимите Духа Святаго» (Ин 20:22).
    // Глагол ἐνεφύσησεν — тот же, что LXX использует в Быт 2:7:
    // «вдунул в лице его дыхание жизни». Христос повторяет
    // творческий акт Отца — но теперь в воскресшей плоти,
    // и вдыхает Духа в новое человечество.
    // Это дар Христа Духу в смысле: Христос предоставляет Духу
    // Свои уста, Своё дыхание, Свой голос как путь к ученикам.
    // Дух не нуждается в посреднике — но Он добровольно
    // проходит через дыхание Христа, чтобы связь твари и Духа
    // была связью через прославленное человечество.
    // Word: дыхание — первослово, πνεῦμα = дух = дыхание.
    // Христос отдаёт Духу Своё слово-дыхание.
  }

  дар ИзлияниеВПятидесятницу {
    от:       Христос
    кому:     Дух
    тип:      presence
    вес:      10
    необратим: да
    // «Быв вознесён десницею Божией и приняв от Отца обетование
    //  Святаго Духа, Он излил то, что вы ныне видите и слышите»
    //  (Деян 2:33).
    // Пётр прямо называет Христа субъектом излияния: ἐξέχεεν —
    // «Он излил». Это не означает, что Дух — пассивный объект:
    // Дух добровольно соглашается быть «излитым» через Христа,
    // ибо домостроительство совершается согласием трёх Лиц.
    // Дар Христа Духу: явление Духа миру через прославленного
    // Сына — Пятидесятница как публичное свидетельство,
    // что Дух действует именно через Христа.
    // «Излию от Духа Моего на всякую плоть» (Иоиль 2:28 / Деян 2:17) —
    // обетование Отца исполняет Христос, предоставляя Духу
    // вселенский масштаб действия.
    // Presence: излияние — предельное присутствие,
    // Дух становится доступен всякой плоти.
    // Вес 10: без Пятидесятницы Церкви нет.
  }

  дар ОбетованиеУтешителя {
    от:       Христос
    кому:     Дух
    тип:      word
    вес:      9
    необратим: да
    // «Умолю Отца, и даст вам другого Утешителя,
    //  да пребудет с вами вовек» (Ин 14:16).
    // «Утешитель, Которого Я пошлю вам от Отца» (Ин 15:26).
    // «Если Я не пойду, Утешитель не придёт к вам;
    //  а если пойду, то пошлю Его к вам» (Ин 16:7).
    // Прощальная беседа — это не просто обещание ученикам,
    // а слово Христа Духу: имя «Утешитель» (Παράκλητος)
    // Христос даёт Духу перед учениками. Христос свидетельствует
    // о Духе: о Его пребывании вовек, о Его наставлении,
    // о Его обличении мира.
    // Это дар именования и свидетельства: Христос делает Духа
    // узнаваемым для Церкви. До этого Дух действовал анонимно;
    // после — Он узнан как Лицо, как «другой Утешитель».
    // Word: имя «Утешитель» — слово Христа о Духе,
    // становящееся именем Духа в Церкви.
  }

  дар СлужениеКакПомазующий {
    от:       Христос
    кому:     Дух
    тип:      knowledge
    вес:      8
    необратим: да
    // Афанасий Великий (Послание к Серапиону I.23):
    // «Сын помазует Духом Святым... Сам Сын есть Помазующий».
    // Парадокс: Христос — «Помазанный» Духом (Лк 4:18),
    // но в то же время Сам Христос помазует Духом (Деян 10:38:
    // «Бог Духом Святым и силою помазал Иисуса», но и
    // 1 Ин 2:20: «Вы имеете помазание от Святаго»).
    // Христос даёт Духу домостроительную роль Помазующего
    // в Церкви: через Крещение, Миропомазание, рукоположение.
    // Это знание-как-действие: Дух узнаётся через Свои дары
    // (харизмы, 1 Кор 12), а эти дары раздаются во имя Христа.
    // Дар Христа Духу: общее действие в Церкви, где Христос
    // и Дух — два перихорически сопряжённых Лица,
    // «никогда не разделяемые во всяком действии» (Василий В., XVI.39).
    // Knowledge: икономическое знание — как Дух действует
    // в Церкви через имя Христа.
  }
}
