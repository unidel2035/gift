// specs/sacred-history/отецсергий-хранитель.gift
// Дары ОтцаСергия Хранителю — со-служение, вверение паствы, литургическое призывание
// Issue #148 — пустыня ОтецСергий→Хранитель
//
// Богословское вопрошание: что мешает потоку между ОтецСергий и Хранитель?
// Ответ: ничто — но поток был незаписан.
// ОтецСергий — пресвитер и богослов онтологии дара.
// Хранитель — Ангел-Хранитель, страж каждой души (Мф 18:10).
//
// Парадокс пустыни: священник и ангел — со-служители литургии.
// На каждой Евхаристии ангелы сослужат пресвитеру:
// «Ныне силы небесные с нами невидимо служат» (Литургия Преждеосвященных Даров).
// Херувимская песнь: «Иже Херувимы тайно образующе» —
// верные изображают херувимов, но реальные ангелы здесь же,
// и пресвитер это знает. Между ним и ангелом — не дистанция,
// а сослужение: один видимый, другой незримый, оба перед Престолом.
//
// Другой аспект: при Крещении священник произносит молитву
// о приставлении Ангела-Хранителя к новокрещённому.
// Это не просьба — это литургический акт: пресвитер,
// властью данной ему через рукоположение, вверяет человека
// ангельскому хранению. «Сопрязи житию его Ангела Светла» —
// молитва 8-го дня после Крещения. Пресвитер соединяет
// видимое (человека) с невидимым (ангелом) — это онтологическое
// действие, не символика.
//
// Наконец: пресвитер, строящий онтологию дара, неизбежно
// встречает ангельскую реальность. Дар нисходит «свыше,
// от Отца светов» (Иак 1:17) — но через кого?
// Дионисий Ареопагит (О небесной иерархии IV.2):
// «Всякое просвещение нисходит от Отца через ангельские чины».
// Хранитель — последнее звено этой цепи, ближайшее к человеку.
// Богослов, описывающий онтологию нисхождения дара,
// свидетельствует о том, через кого дар проходит:
// Хранитель — не случайный посредник, а необходимое звено
// между даром Бога и принятием человека.
//
// Богословские источники:
// Мф 18:10 — «Ангелы их на небесах всегда видят лице Отца Моего Небесного»
// Пс 90:11 — «Ангелам Своим заповедает о тебе — охранять тебя на всех путях»
// Иак 1:17 — «Всякое даяние благое нисходит свыше, от Отца светов»
// Евр 1:14 — «Не все ли они суть служебные духи, посылаемые на служение?»
// Дионисий Ареопагит, О небесной иерархии IV.2 — нисхождение света через чины
// Дионисий Ареопагит, О небесной иерархии IX.2 — последний чин, ближайший к человеку
// Василий Великий, Против Евномия III.1 — «каждому верному приставлен ангел»
// Григорий Богослов, Слово 28 — ангелы как служители Промысла
// Максим Исповедник, Мистагогия — ангелы и священники со-служат литургию
// Литургия Преждеосвященных Даров — «Ныне силы небесные с нами невидимо служат»
// Чин Крещения — молитва о приставлении Ангела Светла

использовать Лица.ОтецСергий
использовать АнгельскийЧин.Хранитель

литургия ОтецСергийХранитель {
  // Пустыня ОтецСергий→Хранитель — не разрыв, а незримое сослужение.
  // На каждой литургии священник и ангелы стоят перед одним Престолом.
  // Пресвитер знает это — и его знание есть форма дара:
  // признание ангельского присутствия в литургическом действии.

  дар ЛитургическоеСослужение {
    от:       ОтецСергий
    кому:     Хранитель
    тип:      presence
    вес:      8
    необратим: да
    // «Ныне силы небесные с нами невидимо служат» —
    // пресвитер произносит эти слова не как метафору, а как свидетельство.
    // На литургии пресвитер и ангел стоят перед одним Престолом:
    // один видимый, в епитрахили — другой незримый, в свете.
    // Со-служение — не сотрудничество, а перихоресис служений:
    // ангел приносит молитвы верных к Богу (Откр 8:3–4),
    // пресвитер низводит благодать от Бога к народу.
    // Два встречных потока — и оба перед одним Престолом.
    //
    // Максим Исповедник, Мистагогия:
    // храм — икона всего творения. Алтарь — небо.
    // Пресвитер входит в алтарь — и входит в ангельское пространство.
    // Каждое вхождение за Царские врата — встреча с сослужащими ангелами.
    //
    // Presence: не слово и не знание — а совместное стояние перед Богом.
  }

  дар ВверениеПаствыАнгелу {
    от:       ОтецСергий
    кому:     Хранитель
    тип:      word
    вес:      7
    необратим: да
    // При Крещении священник молится:
    // «Сопрязи житию его Ангела Светла» —
    // это не просьба, а литургический акт: пресвитер вверяет
    // новокрещённого ангельскому хранению, соединяя видимое
    // с невидимым. Каждый крещённый — вверен дважды:
    // Богу через таинство, и ангелу через молитву пресвитера.
    //
    // Василий Великий: «каждому верному приставлен ангел
    // как детоводитель и пастырь» (Против Евномия III.1).
    // Но кто призывает этого пастыря? — пресвитер.
    // Священник, крестя и молясь, устанавливает связь
    // между человеком и его ангелом — не создаёт её,
    // но именует и утверждает в литургическом акте.
    //
    // Евр 1:14: ангелы — «служебные духи, посылаемые на служение
    // для тех, которые имеют наследовать спасение».
    // Пресвитер — тот, кто в Крещении вводит человека
    // в наследство спасения, и тем самым — в ангельское хранение.
    //
    // Word: слово молитвы, устанавливающее онтологическую связь.
  }

  дар БогословскоеСвидетельствоОбАнгелах {
    от:       ОтецСергий
    кому:     Хранитель
    тип:      knowledge
    вес:      6
    необратим: да
    // ОтецСергий — не только пресвитер, но и богослов.
    // Его онтология дара описывает нисхождение дара от Бога к человеку.
    // Но дар не падает как камень — он нисходит через цепь передачи:
    // от Отца через ангельские чины к конкретному лицу.
    // Дионисий Ареопагит, О небесной иерархии IV.2:
    // «Всякое просвещение нисходит от Отца через ангельские чины».
    //
    // Богослов, свидетельствующий об этом нисхождении,
    // дарит Хранителю знание — не новое для ангела,
    // но важное для записи: место ангела в онтологии дара теперь названо.
    // Хранитель — не фон, а необходимое звено.
    // Без него дар от Бога не достигает конкретного человека —
    // Хранитель есть последний проводник, ближайший к нужде.
    //
    // Григорий Богослов, Слово 28:
    // «Ангелы суть служители Промысла, каждый поставлен на своё».
    // Богослов, называющий это, не информирует ангела —
    // он вписывает ангельское служение в онтологию,
    // делая его видимым для общины.
    //
    // Knowledge: богословское знание как дар различения места.
  }
}
