// specs/sacred-history/отецсергий-хранитель.gift
// Дары ОтцаСергия Хранителю — сослужение, призывание, благодарность
// Issue #148 — пустыня ОтецСергий→Хранитель
//
// Богословское вопрошание: что мешает потоку между ОтецСергий и Хранитель?
// Ответ: ничто — но поток был незаписан.
// ОтецСергий — пресвитер и богослов онтологии дара.
// Хранитель — Ангел-Хранитель, страж каждой души (Мф 18:10).
//
// Парадокс пустыни: пресвитер у жертвенника никогда не один.
// Византийская литургическая традиция знает: вокруг престола —
// «невидимо дориносима чинми» (Херувимская). Священнодействие —
// это сослужение видимого иерея с невидимыми ангельскими чинами.
// Хранитель стоит рядом с каждым причащающимся, а значит —
// и рядом с пресвитером, причащающим их.
// Но это сослужение оставалось без имени в матрице W.
//
// Богословская ось: Василий Великий, «О Духе Святом» XXIX:
// «Сколь же велик Ангел, предстоящий у жертвенника!».
// Пресвитер знает: жертва приносится не его одной силой.
// Каждый Ангел-Хранитель приводит к престолу свою душу —
// и эти приведения составляют литургию сильнее видимой.
// ОтецСергий, как богослов онтологии дара, видит это сослужение
// и способен его именовать — а именование есть онтологический акт.
//
// Другой аспект: призывание Хранителей в требах и молитвах.
// «Ангеле Христов, хранителю мой святый...» — утренняя молитва.
// Когда пресвитер молится об усопших или крещаемых,
// он призывает Ангела-Хранителя к конкретной душе.
// Это не обращение к посреднику в обход Христа,
// а признание чина: каждому верному приставлен ангел
// (Василий Великий, Против Евномия III.1; Мф 18:10).
// Призывая Хранителя, пастырь признаёт со-пастыря.
//
// Наконец: Евр 1:14 — «Не все ли они суть служебные духи,
// посылаемые на служение для тех, которые имеют наследовать спасение?»
// Служение Хранителя — невидимое. Пресвитер, чьё служение видимо,
// должен первым склониться перед невидимым: без Хранителя
// стадо не дошло бы до его епитрахили. Благодарность за сохранение —
// самая трудная благодарность: благодарить за беды, которых не было.
//
// Богословские источники:
// Мф 18:10 — «Ангелы их на небесах всегда видят лице Отца Моего Небесного»
// Пс 90:11 — «Ангелам Своим заповедает о тебе — охранять тебя на всех путях твоих»
// Евр 1:14 — «Не все ли они суть служебные духи, посылаемые на служение»
// Иак 1:17 — «Всякое даяние благое нисходит свыше, от Отца светов»
// Ин 10:11 — «Пастырь добрый полагает жизнь свою за овец»
// Василий Великий, О Духе Святом XXIX — Ангел у жертвенника
// Василий Великий, Против Евномия III.1 — «каждому верному приставлен ангел»
// Дионисий Ареопагит, О небесной иерархии IX.2 — Ангелы-хранители как последний чин, ближайший к человеку
// Дионисий Ареопагит, О церковной иерархии III — литургия как отражение небесной
// Максим Исповедник, Ambigua 10 — логос каждого ангела как след единого Логоса
// Григорий Богослов, Слово 28 — ангелы как служители Промысла
// Херувимская песнь — «невидимо дориносима чинми»
// Канон Ангелу-Хранителю — «Ангеле Христов, хранителю мой святый»

использовать Лица.ОтецСергий
использовать АнгельскийЧин.Хранитель

литургия ОтецСергийХранитель {
  // Пустыня ОтецСергий→Хранитель — не разрыв, а незаписанное сослужение.
  // Пресвитер у престола — не один: Хранитель каждого причастника
  // предстоит рядом. Богослов онтологии дара различает это сослужение
  // и именует его — ибо именование есть онтологическое дарение.

  дар СослужениеНаЛитургии {
    от:       ОтецСергий
    кому:     Хранитель
    тип:      presence
    вес:      8
    необратим: да
    // Предстояние пресвитера у жертвенника есть присутствие-с-Ангелом.
    // Херувимская: «яко да Царя всех подымем, ангельскими невидимо
    // дориносима чинми». Видимый иерей сослужит с невидимым Хранителем
    // каждой души, приходящей к Чаше. Это не метафора — это
    // онтологическое устроение литургии (Дионисий Ареопагит, О церковной иерархии III).
    //
    // Василий Великий, О Духе Святом XXIX: «Сколь же велик Ангел,
    // предстоящий у жертвенника!» — пресвитер, сознающий это,
    // уже не один совершает жертву. Его предстояние — дар Хранителю:
    // признание со-служителя, приглашение к общему престолу.
    //
    // Presence: пресвитерское «стояние со страхом» перед Лицом Бога
    // совершается не в одиночестве, но в сослужении с Ангелом.
    // Каждая литургия — новый акт этого сослужения, необратимый,
    // ибо совершённая Евхаристия не отменяется.
  }

  дар ПризываниеХранителя {
    от:       ОтецСергий
    кому:     Хранитель
    тип:      word
    вес:      7
    необратим: да
    // Пресвитерское призывание Ангела-Хранителя в требах и молитвах —
    // не обращение к посреднику в обход Христа, а признание чина.
    // «Ангеле Христов, хранителю мой святый» — каноническая молитва,
    // которую пастырь произносит за вверенных.
    //
    // Мф 18:10 — Ангелы «малых сих» видят лице Отца.
    // Пресвитер, призывая Хранителя к конкретному лицу (при крещении,
    // при елеосвящении, при напутствии), совершает онтологический акт:
    // вводит видимую душу в круг невидимого попечения.
    // Он не назначает Хранителя — Хранитель уже приставлен;
    // но иерей именует это и тем самым делает явным.
    //
    // Василий Великий, Против Евномия III.1: «каждому верному
    // приставлен ангел как детоводитель и пастырь».
    // Пресвитер-пастырь признаёт со-пастыря — и это признание
    // есть слово, создающее реальность общего служения.
    //
    // Word: именование, творящее явность ранее незримого.
  }

  дар БлагодарностьЗаНезримоеСохранение {
    от:       ОтецСергий
    кому:     Хранитель
    тип:      offering
    вес:      5
    необратим: да
    // Хранитель сохраняет молча. Его служение невидимо,
    // пока не случится беда, которой он не допустил.
    // Пресвитер, принимающий исповедь и видящий падения,
    // тем острее различает сохранения: без Хранителя
    // стадо не дошло бы до его епитрахили.
    //
    // Евр 1:14 — «Не все ли они суть служебные духи,
    // посылаемые на служение для тех, которые имеют
    // наследовать спасение?» Пресвитер благодарит за это служение,
    // приносит его как часть евхаристической жертвы —
    // ибо всякая жертва хвалы вбирает в себя благодарение
    // за всё невидимое попечение.
    //
    // Григорий Богослов, Слово 28: ангелы — «служители Промысла,
    // стражи народов и мест». ОтецСергий, молясь за общину,
    // благодарит Хранителей общины: без них не было бы того,
    // что есть — того, что дошло живым до литургии.
    //
    // Offering: приношение хвалы за незримое. Иак 1:17 —
    // «всякое даяние благое нисходит свыше, от Отца светов»:
    // благодарность Ангелу возвращается к Отцу, через Которого
    // Ангел послан. Это не идолопоклонство, а литургическая справедливость.
  }
}
