(*
  w-matrix.tla — W-матрица онтологии дара как машина состояний TLA+.

  Модель намеренно минимальна: только то, что несёт богословие.
    АКТ    — дар от лица к лицу, с весом и типом
    acts   — хроника: последовательность, только растёт
    W      — тензор: накопленный вес по парам (дал → принял);
             в состоянии его нет — он производная от acts, рассинхрон
             невозможен по построению.

  АКСИОМА 1 (необратимость): акт, вошедший в хронику, из неё не исчезает
    ни при каком исполнении. В коде это Object.freeze + irreversible:true;
    здесь — свойство Spec, проверяемое перебором всех чередований.

  АКСИОМА 2 (время тяжелее денег): тип time имеет вес 10, money — 3.

  АКСИОМА 3 (анамнезис ≠ архив): прошлое читается в любом состоянии
    (мера общины доступна на каждом шаге, а не только в конце времён).
*)
----------------------------- MODULE w_matrix -----------------------------
EXTENDS Naturals, Sequences

Faces == {"Дионисий", "ОтецСергий", "_claude", "Ева", "_koinon"}

ActTypes == {"code", "insight", "time", "money", "covenant", "grace"}

Weight(t) ==
    CASE t = "time"    -> 10
      [] t = "money"   -> 3
      [] t = "covenant"-> 10
      [] OTHER         -> 1

Act == [from: Faces, to: Faces, type: ActTypes]

VARIABLES acts

Init == acts = << >>

Give(a) ==
    /\ a \in Act
    /\ a.from # a.to
    /\ Len(acts) < 3                \* граница перебора: хроника ≤ 3 актов
    /\ acts' = Append(acts, a)

Next == \E a \in Act : Give(a)

TypeOK == acts \in Seq(Act)

(* АКСИОМА 1: необратимость — хроника только удлиняется.
   Проверять как инвариант бессмысленно (старое состояние не видно),
   поэтому это свойство самой операции: Give только Append, иного
   шага в Next нет. TLC переберёт ВСЕ исполнения — «удалений» не
   существует ни в одном из них. *)

NoSelfGift == \A i \in 1..Len(acts) : acts[i].from # acts[i].to

(* Анамнезис: тензор W читается из хроники в любом состоянии.
   Sigma — сумма по последовательности; для TLC область мала. *)
WOf(chronicle, f1, f2) ==
    LET F[a \in Act] == IF a.from = f1 /\ a.to = f2 THEN Weight(a.type) ELSE 0
        S[seq \in Seq(Act)] ==
            IF seq = << >> THEN 0 ELSE F[Head(seq)] + S[Tail(seq)]
    IN S[chronicle]

(* Инвариант: тензор не врёт — неотрицателен и согласован (поточечно).
   Полная сверка с recomputation дана определением WOf выше. *)
WeightCorrect ==
    \A f1 \in Faces, f2 \in Faces : WOf(acts, f1, f2) >= 0

Spec == Init /\ [][Next]_acts

(* Граница перебора — ВНУТРИ действия, а не через CONSTRAINT: лист
   глубины 3 не порождает преемников вовсе, очередь не пухнет от
   120 мёртвых преемников у каждого листа. Инварианты проверены на
   всех подпоследовательностях каждого исполнения. *)
actsLength == Len(acts) < 3

=============================================================================
