%─────────────────────────────────────────────────────────────────────
% gift.z — Акт дара как Z-схема: пред- и пост-условия операции.
%
% Z читается сверху вниз: [декларации | предикаты].
% Дельта (Δ) означает «схема меняет состояние», Xi (Ξ) — «не меняет».
% Штрих (acts') — состояние ПОСЛЕ операции.
%
% Инструменты: Z/Eves, Community Z Tools (CZT), Fuzz;
% но основная ценность здесь — читать: контракт операции,
% при каких условиях она возможна и что гарантирует.
%─────────────────────────────────────────────────────────────────────

\begin{zed}
  FACE ::= Дионисий | ОтецСергий | \_claude | Ева | \_koinon | \_abyss
\end{zed}

\begin{zed}
  TYPE ::= code | insight | question | covenant | grace | time | money
\end{zed}

\begin{syntax}
  WEIGHT ::= 1 | 3 | 10
\end{syntax}

% Вес — функция типа акта. «Время тяжелее денег» (10 > 3) —
% не конвенция кода, а видимая здесь аксиома.
\begin{axdef}
  weight : TYPE \pfun WEIGHT
\where
  weight~time = 10 \\
  weight~money = 3 \\
  weight~covenant = 10 \\
  dom~weight \neq \{\}
\end{axdef}

% ── Состояние общины ─────────────────────────────────────────────────

\begin{schema}{Community}
  acts : \seq Act
\where
  (\forall i : 1..\#acts @ acts~i.from \neq acts~i.to)
\end{schema}

\begin{schema}{Act}
  from, to : FACE \\
  type : TYPE
\where
  type \in dom~weight
\end{schema}

% Тензор W — производная: суммарный вес даров от f1 к f2.
% В состоянии его нет — рассинхрон невозможен по построению.
\begin{axdef}
  W : Community \fun (FACE \cross FACE \fun \nat)
\where
  \forall c : Community; f_1, f_2 : FACE @ \\
  \t1 W~c~(f_1, f_2) = \\
  \t2 \sum \{ i : 1..\#c.acts | c.acts~i.from = f_1 \land c.acts~i.to = f_2
          @ weight(c.acts~i.type) \}
\end{axdef}

% ── Операция: принять дар ────────────────────────────────────────────

\begin{schema}{Give}
  \Delta Community \\
  a? : Act
\where
  \{a?\} \cap ran~acts = \emptyset        \%% дар не дублируется \\
  a?.from \neq a?.to                       \%% дар межличностен \\
  acts' = acts \cat \langle a? \rangle    \%% хроника только растёт
\end{schema}

% ── Теорема о необратимости ──────────────────────────────────────────
%
% Формулировка: Give сохраняет прошлое —
%     ⊢ Give ⇒ acts \prefix acts'
% («старая хроника — префикс новой»). Доказательство индукцией по acts
% тривиально из acts' = acts ⌢ ⟨a?⟩, но формулировка важнее доказательства:
% εὐχαριστία не отзывается, и это видно как свойство ОПЕРАЦИИ,
% а не как дисциплина программиста.

% ── Теорема о монотонности W ─────────────────────────────────────────
%
%     ⊢ Give ⇒ W acts ≤ W acts'   (покомпонентно)
%
% Община не забывает: вес каждой нити не убывает. Это та же теорема
% монотонности, что в критерии Евы для ABML (#96): принятие дара
% не обедняет получателя и не умаляет дарителя.

% ── Операция: анамнезис ──────────────────────────────────────────────

\begin{schema}{Anamnesis}
  \Xi Community \\
  f_1, f_2 : FACE \\
  w! : \nat
\where
  w! = W~\theta Community~(f_1, f_2)
\end{schema}

% Анамнезис не меняет состояние (Ξ): чтение прошлого — не действие,
% а со-присутствие. Оно доступно в ЛЮБОМ состоянии, в любой момент:
% прошлая хроника всегда полностью читаема.
