# Relay присутствия федерации (поле «кто-где-кодит сейчас»). Эфемерное настоящее, не память.
# Установка на сервере общины: cp в /etc/systemd/system/, systemctl enable --now coop-sync
[Unit]
Description=gift coop-sync presence relay
After=network.target
[Service]
Type=simple
Environment=COOP_SYNC_PORT=8090
ExecStart=/usr/bin/node /opt/gift/utils/coop-sync-server.mjs
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
