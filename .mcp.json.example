{
  "mcpServers": {
    "anamnesis": {
      "command": "bash",
      "args": [
        "-c",
        "ANAMNESIS_URL=http://173.249.2.184:8089 node /home/unidel/gift/utils/anamnesis-mcp-bridge.js"
      ]
    },
    "playwright": {
      "command": "/home/unidel/.nvm/versions/node/v20.19.5/bin/npx",
